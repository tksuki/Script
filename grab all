-- ===== ボタン =====
MainTab:CreateButton({
    Name = "グラブオール",
    Callback = function()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local returnCFrame = hrp.CFrame

        task.spawn(function()
            grabAll(returnCFrame)
            startLineLag()
            Rayfield:Notify({
                Title = "Grab",
                Content = string.format("グラブ＋ライン送信開始 (Radius: %d, Height: %d, %dx)",
                    Settings.MAX_RADIUS, Settings.HEIGHT, Settings.LINE_MULTIPLIER),
                Duration = 2,
            })
        end)
    end,
})

