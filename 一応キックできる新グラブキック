-- 全員対象 処理メイン関数
------------------------------------------------------------
local function processAllBoxes()
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local myHrp = character:WaitForChild("HumanoidRootPart", 10)
    if not myHrp then return end

    local SpawnToyRF = getSpawnToyRF()
    local SetNetworkOwner = getSetNetworkOwner()
    local DestroyGrabLine = getDestroyGrabLine()
    local DestroyToy = getDestroyToy()

    if not SpawnToyRF or not SetNetworkOwner or not DestroyGrabLine or not DestroyToy then
        warn("[GlassBox] リモートイベントの取得に失敗しました")
        return
    end

    local otherPlayers = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            table.insert(otherPlayers, p)
        end
    end

    if #otherPlayers == 0 then
        warn("[GlassBox] 対象となる他のプレイヤーが居ません")
        return
    end

    ------------------------------------------------------------
    -- 1. 箱の生成
    ------------------------------------------------------------
    local serverSize = #Players:GetPlayers()
    local divResult  = math.floor(serverSize / 5)
    local boxCount   = divResult % 10
    if boxCount <= 0 then boxCount = 1 end

    local centerPos = myHrp.Position + Vector3.new(0, 150, 0)
    local spacing   = 15
    local radius    = (boxCount > 1) and math.max(spacing, (boxCount * spacing) / (2 * math.pi)) or 0

    local boxesData = {}

    for i = 1, boxCount do
        local angle = ((i - 1) / boxCount) * (2 * math.pi)
        local offsetX = math.cos(angle) * radius
        local offsetZ = math.sin(angle) * radius

        local toysFolder = getToysFolder()
        local existingModels = {}
        if toysFolder then
            for _, child in ipairs(toysFolder:GetChildren()) do
                existingModels[child] = true
            end
        end

        SpawnToyRF:InvokeServer("GlassBoxGray", myHrp.CFrame * CFrame.new(0, 0, -4), Vector3.new(0, -13, 0))
        
        task.wait(0.09)
        if not toggleAllEnabled then return end

        toysFolder = getToysFolder()
        local boxModel = nil
        if toysFolder then
            for _, child in ipairs(toysFolder:GetChildren()) do
                if not existingModels[child] and child.Name == "GlassBoxGray" then
                    boxModel = child
                    break
                end
            end
        end

        if boxModel then
            local boxPart = boxModel:FindFirstChild("SoundPart") 
                         or boxModel.PrimaryPart 
                         or boxModel:FindFirstChildWhichIsA("BasePart")

            if boxPart then
                -- 【変更箇所】スポーン時の向きを縦向き（X軸周り）に90度回転させる
                local initialRotation = boxPart.CFrame.Rotation * CFrame.Angles(math.rad(90), 0, 0)
                local targetPosition = centerPos + Vector3.new(offsetX, 0, offsetZ)
                local boxCFrame = CFrame.new(targetPosition) * initialRotation

                SetNetworkOwner:FireServer(boxPart, boxCFrame)

                if boxModel:IsA("Model") and boxModel.PrimaryPart then
                    boxModel:PivotTo(boxCFrame)
                else
                    boxPart.CFrame = boxCFrame
                end

                local fixInstances = setupFixInstances(boxModel, initialRotation)
                table.insert(boxesData, {
                    model = boxModel,
                    part = boxPart,
                    cframe = boxCFrame,
                    rotationOnly = initialRotation,
                    fixInstances = fixInstances,
                    assignedPlayers = {}
                })
            end
        end
    end

    if #boxesData == 0 then return end

    task.wait(0.5)
    if not toggleAllEnabled then return end

    ------------------------------------------------------------
    -- 2. プレイヤー振り分け
    ------------------------------------------------------------
    local originalMyCF = myHrp.CFrame

    for idx, player in ipairs(otherPlayers) do
        local pChar = player.Character
        if pChar then
            local pHrp   = pChar:FindFirstChild("HumanoidRootPart")
            local pTorso = pChar:FindFirstChild("Torso") or pChar:FindFirstChild("UpperTorso")

            if pHrp and pTorso then
                local boxIndex = ((idx - 1) % #boxesData) + 1
                local targetBox = boxesData[boxIndex]

                local followConnection
                followConnection = RunService.Heartbeat:Connect(function()
                    if pHrp and pHrp.Parent and myHrp and myHrp.Parent then
                        myHrp.CFrame = pHrp.CFrame * CFrame.new(0, 0, 2)
                    end
                end)

                for _ = 1, 5 do
                    SetNetworkOwner:FireServer(pTorso, CFrame.new(pTorso.Position))
                    task.wait(0.05)
                end

                if followConnection then
                    followConnection:Disconnect()
                end

                local boxTopCFrame = CFrame.new(targetBox.cframe.Position + Vector3.new(0, 3, 0))
                pHrp.CFrame = boxTopCFrame

                table.insert(targetBox.assignedPlayers, pTorso)
            end
        end
    end

    for _, boxData in ipairs(boxesData) do
        for _, pTorso in ipairs(boxData.assignedPlayers) do
            DestroyGrabLine:FireServer(pTorso)
        end
    end

    ------------------------------------------------------------
    -- 3. 落下直前の巡回TP
    ------------------------------------------------------------
    local startWaitTime = 1.8
    local startTime = os.clock()

    while (os.clock() - startTime) < startWaitTime do
        for _, boxData in ipairs(boxesData) do
            if not toggleAllEnabled then return end

            myHrp.CFrame = boxData.cframe * CFrame.new(5, 0, 0)
            SetNetworkOwner:FireServer(boxData.part, boxData.cframe)
            
            task.wait(0.05)
            task.wait(0.1)
        end
    end

    myHrp.CFrame = originalMyCF

    ------------------------------------------------------------
    -- 4. アニメーション
    ------------------------------------------------------------
    for _, boxData in ipairs(boxesData) do
        for _, item in ipairs(boxData.fixInstances) do
            if item.bp and item.bp.Parent then
                item.bp.Position = item.initialPos + Vector3.new(0, -10, 0)
            end
        end
    end
    task.wait(0.2)

    for _, boxData in ipairs(boxesData) do
        for _, item in ipairs(boxData.fixInstances) do
            if item.bp and item.bp.Parent then
                item.bp.Position = item.initialPos + Vector3.new(0, 20, 0)
            end
        end
    end
    task.wait(0.2)

    ------------------------------------------------------------
    -- 5. 真下へ直下移動
    ------------------------------------------------------------
    local dropDistance = 100

    for _, boxData in ipairs(boxesData) do
        local targetCFrame = CFrame.new(boxData.cframe.Position + Vector3.new(0, -dropDistance, 0)) * boxData.rotationOnly
        freezeBoxAt(boxData, targetCFrame)
    end

    ------------------------------------------------------------
    -- 6. 静止 ➔ 消去
    ------------------------------------------------------------
    task.wait(1.2)

    for _, boxData in ipairs(boxesData) do
        DestroyToy:FireServer(boxData.model)
    end

    task.wait(0.5)
end

