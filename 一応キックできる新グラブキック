------------------------------------------------------------
-- 変数・リモート取得関数
------------------------------------------------------------
local toggleSingleEnabled = false
local toggleAllEnabled    = false
local selectedPlayers     = {}
local playerMap           = {}

local function getGrabEvents()
    return ReplicatedStorage:FindFirstChild("GrabEvents")
end

local function getSetNetworkOwner()
    local ge = getGrabEvents()
    return ge and ge:FindFirstChild("SetNetworkOwner")
end

local function getDestroyGrabLine()
    local ge = getGrabEvents()
    return ge and ge:FindFirstChild("DestroyGrabLine")
end

local function getMenuToys()
    return ReplicatedStorage:FindFirstChild("MenuToys")
end

local function getSpawnToyRF()
    local mt = getMenuToys()
    return mt and mt:FindFirstChild("SpawnToyRemoteFunction")
end

local function getDestroyToy()
    local mt = getMenuToys()
    return mt and mt:FindFirstChild("DestroyToy")
end

local function getToysFolder()
    local folder = workspace:FindFirstChild(PlayerName .. "SpawnedInToys")
    if folder then return folder end
    for _, child in ipairs(workspace:GetChildren()) do
        if child:IsA("Folder") and child.Name:find("SpawnedInToys") then
            return child
        end
    end
    return nil
end

------------------------------------------------------------
-- ドロップダウン機能
------------------------------------------------------------
local function getPlayerFormatString(player)
    return string.format("%s (@%s)", player.DisplayName, player.Name)
end

local function getPlayerList()
    local list = {}
    playerMap = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local formattedName = getPlayerFormatString(p)
            table.insert(list, formattedName)
            playerMap[formattedName] = p
        end
    end
    if #list == 0 then
        table.insert(list, "対象プレイヤーなし")
    end
    return list
end

local PlayerDropdown = MainTab:CreateDropdown({
    Name = "対象プレイヤー選択",
    Options = getPlayerList(),
    CurrentOption = { getPlayerList()[1] or "対象プレイヤーなし" },
    MultipleOptions = true,
    Flag = "TargetPlayerDropdown",
    Callback = function(Options)
        selectedPlayers = {}
        local optList = type(Options) == "table" and Options or { Options }
        for _, optStr in ipairs(optList) do
            if playerMap[optStr] then
                table.insert(selectedPlayers, playerMap[optStr])
            end
        end
    end,
})

local initialOptions = getPlayerList()
if #initialOptions > 0 and initialOptions[1] ~= "対象プレイヤーなし" then
    if playerMap[initialOptions[1]] then
        selectedPlayers = { playerMap[initialOptions[1]] }
    end
end

local function refreshDropdown()
    local currentOptions = getPlayerList()
    PlayerDropdown:Refresh(currentOptions)
    
    local newSelected = {}
    local rawSelected = PlayerDropdown.CurrentOption
    local optList = type(rawSelected) == "table" and rawSelected or { rawSelected }
    
    for _, optStr in ipairs(optList) do
        if playerMap[optStr] then
            table.insert(newSelected, playerMap[optStr])
        end
    end
    
    selectedPlayers = newSelected
end

Players.PlayerAdded:Connect(function(player)
    refreshDropdown()
    player:GetPropertyChangedSignal("DisplayName"):Connect(refreshDropdown)
end)

Players.PlayerRemoving:Connect(function(player)
    refreshDropdown()
end)

for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        player:GetPropertyChangedSignal("DisplayName"):Connect(refreshDropdown)
    end
end

------------------------------------------------------------
-- 共通ヘルパー関数
------------------------------------------------------------
local function setupFixInstances(boxModel, initialRotation)
    local fixInstances = {}
    for _, part in ipairs(boxModel:GetDescendants()) do
        if part:IsA("BasePart") then
            local oldBp = part:FindFirstChildOfClass("BodyPosition")
            local oldBg = part:FindFirstChildOfClass("BodyGyro")
            if oldBp then oldBp:Destroy() end
            if oldBg then oldBg:Destroy() end

            local bp = Instance.new("BodyPosition")
            bp.Position = part.Position
            bp.MaxForce = Vector3.new(1e6, 1e6, 1e6)
            bp.P = 1e5
            bp.D = 1000
            bp.Parent = part

            local bg = Instance.new("BodyGyro")
            bg.CFrame = initialRotation
            bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
            bg.P = 1e5
            bg.D = 1000
            bg.Parent = part

            table.insert(fixInstances, {bp = bp, bg = bg, initialPos = part.Position, part = part})
        end
    end
    return fixInstances
end

local function freezeBoxAt(boxData, targetCFrame)
    if not boxData.model or not boxData.part then return end

    if boxData.model:IsA("Model") and boxData.model.PrimaryPart then
        boxData.model:PivotTo(targetCFrame)
    else
        boxData.part.CFrame = targetCFrame
    end

    for _, item in ipairs(boxData.fixInstances) do
        if item.part and item.part.Parent then
            item.part.AssemblyLinearVelocity = Vector3.zero
            item.part.AssemblyAngularVelocity = Vector3.zero
            
            if item.bp then
                item.bp.Position = item.part.Position
            end
            if item.bg then
                item.bg.CFrame = boxData.rotationOnly
            end
        end
    end
end

------------------------------------------------------------
-- 選択プレイヤー対象 処理メイン関数
------------------------------------------------------------
local function processSingleBox()
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local myHrp = character:WaitForChild("HumanoidRootPart", 10)
    if not myHrp then return end

    local validTargets = {}
    for _, p in ipairs(selectedPlayers) do
        if p and p.Parent and p.Character then
            table.insert(validTargets, p)
        end
    end

    if #validTargets == 0 then
        warn("[GlassBox] 選択されたプレイヤーが無効です")
        return
    end

    local SpawnToyRF = getSpawnToyRF()
    local SetNetworkOwner = getSetNetworkOwner()
    local DestroyGrabLine = getDestroyGrabLine()
    local DestroyToy = getDestroyToy()

    if not SpawnToyRF or not SetNetworkOwner or not DestroyGrabLine or not DestroyToy then
        warn("[GlassBox] リモートイベントの取得に失敗しました")
        return
    end

    ------------------------------------------------------------
    -- 1. 箱の生成
    ------------------------------------------------------------
    local boxCount = math.ceil(#validTargets / 5)
    local centerPos = myHrp.Position + Vector3.new(0, 150, 0)
    
    local spacing = 15
    local radius = (boxCount > 1) and math.max(spacing, (boxCount * spacing) / (2 * math.pi)) or 0

    local boxesData = {}

    for i = 1, boxCount do
        local angle = ((i - 1) / boxCount) * (2 * math.pi)
        local offsetX = math.cos(angle) * radius
        local offsetZ = math.sin(angle) * radius

        local toysFolder = getToysFolder()
        local existingModels = {}
        if toysFolder then
            for _, child in ipairs(toysFolder:GetChildren()) do
                existingModels[child] = true
            end
        end

        SpawnToyRF:InvokeServer("GlassBoxGray", myHrp.CFrame * CFrame.new(0, 0, -4), Vector3.new(0, -13, 0))
        
        task.wait(0.09)
        if not toggleSingleEnabled then return end

        toysFolder = getToysFolder()
        local boxModel = nil
        if toysFolder then
            for _, child in ipairs(toysFolder:GetChildren()) do
                if not existingModels[child] and child.Name == "GlassBoxGray" then
                    boxModel = child
                    break
                end
            end
        end

        if boxModel then
            local boxPart = boxModel:FindFirstChild("SoundPart") 
                         or boxModel.PrimaryPart 
                         or boxModel:FindFirstChildWhichIsA("BasePart")

            if boxPart then
                -- 【変更箇所】スポーン時の向きを縦向き（X軸周り）に90度回転させる
                local initialRotation = boxPart.CFrame.Rotation * CFrame.Angles(math.rad(90), 0, 0)
                local targetPosition = centerPos + Vector3.new(offsetX, 0, offsetZ)
                local boxCFrame = CFrame.new(targetPosition) * initialRotation

                SetNetworkOwner:FireServer(boxPart, boxCFrame)

                if boxModel:IsA("Model") and boxModel.PrimaryPart then
                    boxModel:PivotTo(boxCFrame)
                else
                    boxPart.CFrame = boxCFrame
                end

                local fixInstances = setupFixInstances(boxModel, initialRotation)
                table.insert(boxesData, {
                    model = boxModel,
                    part = boxPart,
                    cframe = boxCFrame,
                    rotationOnly = initialRotation,
                    fixInstances = fixInstances,
                    assignedPlayers = {}
                })
            end
        end
    end

    if #boxesData == 0 then return end

    task.wait(0.5)
    if not toggleSingleEnabled then return end

    ------------------------------------------------------------
    -- 2. ターゲットを箱へ移動
    ------------------------------------------------------------
    local originalMyCF = myHrp.CFrame

    for idx, targetPlayer in ipairs(validTargets) do
        if not toggleSingleEnabled then return end

        local targetChar = targetPlayer.Character
        if targetChar then
            local targetHrp   = targetChar:FindFirstChild("HumanoidRootPart")
            local targetTorso = targetChar:FindFirstChild("Torso") or targetChar:FindFirstChild("UpperTorso")

            if targetHrp and targetTorso then
                local boxIndex = ((idx - 1) % #boxesData) + 1
                local targetBox = boxesData[boxIndex]

                local followConnection
                followConnection = RunService.Heartbeat:Connect(function()
                    if targetHrp and targetHrp.Parent and myHrp and myHrp.Parent then
                        myHrp.CFrame = targetHrp.CFrame * CFrame.new(0, 0, 2)
                    end
                end)

                for _ = 1, 5 do
                    SetNetworkOwner:FireServer(targetTorso, CFrame.new(targetTorso.Position))
                    task.wait(0.1)
                end

                if followConnection then
                    followConnection:Disconnect()
                end

                local boxTopCFrame = CFrame.new(targetBox.cframe.Position + Vector3.new(0, 3, 0))
                targetHrp.CFrame = boxTopCFrame

                table.insert(targetBox.assignedPlayers, targetTorso)
            end
        end
    end

    for _, boxData in ipairs(boxesData) do
        for _, pTorso in ipairs(boxData.assignedPlayers) do
            DestroyGrabLine:FireServer(pTorso)
        end
    end

    ------------------------------------------------------------
    -- 3. 落下直前の巡回TP
    ------------------------------------------------------------
    local startWaitTime = 1.8
    local startTime = os.clock()

    while (os.clock() - startTime) < startWaitTime do
        for _, boxData in ipairs(boxesData) do
            if not toggleSingleEnabled then return end

            myHrp.CFrame = boxData.cframe * CFrame.new(5, 0, 0)
            SetNetworkOwner:FireServer(boxData.part, boxData.cframe)
            
            task.wait(0.05)
            task.wait(0.1)
        end
    end

    myHrp.CFrame = originalMyCF

    ------------------------------------------------------------
    -- 4. アニメーション
    ------------------------------------------------------------
    for _, boxData in ipairs(boxesData) do
        for _, item in ipairs(boxData.fixInstances) do
            if item.bp and item.bp.Parent then
                item.bp.Position = item.initialPos + Vector3.new(0, -10, 0)
            end
        end
    end
    task.wait(0.2)

    for _, boxData in ipairs(boxesData) do
        for _, item in ipairs(boxData.fixInstances) do
            if item.bp and item.bp.Parent then
                item.bp.Position = item.initialPos + Vector3.new(0, 20, 0)
            end
        end
    end
    task.wait(0.2)

    ------------------------------------------------------------
    -- 5. 真下へ直下移動
    ------------------------------------------------------------
    local dropDistance = 100

    for _, boxData in ipairs(boxesData) do
        local targetCFrame = CFrame.new(boxData.cframe.Position + Vector3.new(0, -dropDistance, 0)) * boxData.rotationOnly
        freezeBoxAt(boxData, targetCFrame)
    end

    ------------------------------------------------------------
    -- 6. 静止 ➔ 消去
    ------------------------------------------------------------
    task.wait(1.5)

    for _, boxData in ipairs(boxesData) do
        DestroyToy:FireServer(boxData.model)
    end
    
    task.wait(0.5)
end

