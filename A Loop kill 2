local function unload()
    if State.Stopped then return end
    State.Stopped     = true
    State.AutoKill    = false
    State.AutoKillAll = false
    State.AutoLoopGen = State.AutoLoopGen + 1  -- ループを確実に止める
    pcall(function() RunService:UnbindFromRenderStep("RSC_Kill") end)
    pcall(function() Library:Unload() end)
    getgenv().ResonanceKillRunning = false
    print("[Resonance Kill] Unloaded")
end

Library:OnUnload(unload)

