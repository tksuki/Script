-- ============================================================
-- State
-- ============================================================
local State = {
    Stopped     = false,
    Owning      = false,
    KillTimeout = 0.65,
    KillDelay   = 0.4,
    Killing     = setmetatable({}, { __mode = "k" }),
    AutoKill    = false,   -- トグル：選択ターゲットをループキル
    AutoKillAll = false,   -- トグル：全員をループキル
    AutoLoopGen = 0,       -- ループ世代管理（多重起動防止）
}
local PartOwnerCache = setmetatable({}, { __mode = "k" })
local VelocityCache  = setmetatable({}, { __mode = "k" })
local Selected       = {}

-- ============================================================
-- Helpers
-- ============================================================
local function GetChar(player)
    player = player or LocalPlayer
    local char = player.Character
    if not char then return end
    return char,
        char:FindFirstChild("realHrp") or char:FindFirstChild("HumanoidRootPart"),
        char:FindFirstChild("Humanoid")
end

local function GetMagnitude(a, b)
    if not (a and b) then return math.huge end
    return (a.Position - b.Position).Magnitude
end

local function IsPartOwner(part)
    if not (part and part:IsA("BasePart")) then return false end
    local cached = PartOwnerCache[part]
    if cached and cached.Parent then
        return cached.Value == LocalPlayer.Name
    end
    local parent = part.Parent
    local head = part.Name == "HumanoidRootPart" and parent and parent:FindFirstChild("Head")
    head = head and head:FindFirstChild("PartOwner")
    if head and head.Value == LocalPlayer.Name then
        PartOwnerCache[part] = head
        return true
    end
    local own = part:FindFirstChild("PartOwner")
    if own and own.Value == LocalPlayer.Name then
        PartOwnerCache[part] = own
        return true
    end
    return false
end

local function GetVelocity(part)
    local now = os.clock()
    local e = VelocityCache[part]
    if not e then
        VelocityCache[part] = { Pos = part.Position, Time = now, Vel = Vector3.zero }
        return Vector3.zero
    end
    local dt = now - e.Time
    if dt < 0.001 then return e.Vel end
    local delta = (part.Position - e.Pos) / dt
    if dt > 0.25 or delta.Magnitude > 300 then
        e.Vel = Vector3.zero
    else
        e.Vel = e.Vel:Lerp(delta, 1 - math.exp(-dt * 40))
        if e.Vel.Magnitude < 0.05 then e.Vel = Vector3.zero end
    end
    e.Pos  = part.Position
    e.Time = now
    return e.Vel
end

local function PredictCFrame(part, base)
    base = base or part.CFrame
    local ping = math.clamp(LocalPlayer:GetNetworkPing(), 0, 0.35)
    return base + GetVelocity(part) * ping
end

local function ResetVel(part)
    if not (part and part:IsA("BasePart")) then return end
    if part.AssemblyAngularVelocity ~= Vector3.zero then part.AssemblyAngularVelocity = Vector3.zero end
    if part.AssemblyLinearVelocity  ~= Vector3.zero then part.AssemblyLinearVelocity  = Vector3.zero end
end

local function PivotTo(model, cframe)
    if not (model and model:IsA("Model")) or typeof(cframe) ~= "CFrame" then return false end
    local offset = cframe * model:GetPivot():Inverse()
    local parts  = model:QueryDescendants("BasePart")
    local newCF  = {}
    for i, p in ipairs(parts) do
        local root = p:IsDescendantOf(model) and p.AssemblyRootPart
        if root and not p.Anchored and not root.Anchored then
            newCF[i] = offset * p.CFrame
        end
    end
    for i, cf in pairs(newCF) do parts[i].CFrame = cf end
    return true
end

-- ============================================================
-- Kill core (Grab / SNO / RNO / Kill)
-- ============================================================
local function Grab(part, at)
    local _, root, hum = GetChar()
    if not (root and hum and hum.Health > 0) then return end
    if not (part and part.Parent and part:IsA("BasePart")) then return end
    local myPos  = (at or root.CFrame) * CFrame.new(0, 1.593, 0)
    local target = PredictCFrame(part)
    SetNetworkOwner:FireServer(part, CFrame.new(myPos.Position, target.Position))
end

local function SNO(part, timeout)
    local myChar, myRoot, myHum = GetChar()
    local myHead    = myChar and myChar:FindFirstChild("Head")
    local ragdolled = myHum and myHum:FindFirstChild("Ragdolled")
    if not (myHead and ragdolled and myRoot and myHum and myHum.Health > 0) then return false end
    if not (part and part:IsA("BasePart") and part.Parent) then return false end
    if IsPartOwner(part) then return true end
    if State.Owning then return false end

    local far = GetMagnitude(myRoot, part) >= 31
    State.Owning = true

    local savedRoot, savedHead, aimPos, conn
    local function freeze()
        savedRoot = myRoot.CFrame
        savedHead = myHead.CFrame
        aimPos    = myRoot.CFrame
        RunService:BindToRenderStep("RSC_Kill", Enum.RenderPriority.Camera.Value - 1, function()
            myRoot.CFrame = savedRoot
            myHead.CFrame = savedHead
        end)
        conn = RunService.Heartbeat:Connect(function()
            savedRoot = myRoot.CFrame
            savedHead = myHead.CFrame
            myRoot.CFrame = aimPos
            myHead.CFrame = aimPos
        end)
    end
    local function unfreeze()
        RunService:UnbindFromRenderStep("RSC_Kill")
        if conn then conn:Disconnect(); conn = nil end
        if myHead.Parent then myHead.CFrame = savedHead end
        if myRoot.Parent then myRoot.CFrame = savedRoot end
    end

    local ok = pcall(function()
        if far then freeze() end
        timeout = timeout or State.KillTimeout or 0.65
        local start = tick()
        while not State.Stopped
              and part.Parent
              and not IsPartOwner(part)
              and myHum.Health ~= 0
              and myRoot.Parent
              and (tick() - start) < timeout
        do
            if far then aimPos = PredictCFrame(part) - Vector3.new(0, 22, 0) end
            RunService.Heartbeat:Wait()
            Grab(part, far and aimPos or nil)
        end
    end)

    if far then pcall(unfreeze) end
    State.Owning = false
    if not ok then return false end
    return IsPartOwner(part)
end

local function RNO(part)
    DestroyGrabLine:FireServer(part)
end

local function Kill(player)
    if not player or player == LocalPlayer or player.Parent ~= Players then return false end
    local char, root, hum = GetChar(player)
    if not (char and root and hum) then return false end
    if hum.Health == 0 then return false end
    if State.Killing[char] then return false end

    local spawnLoc = workspace:FindFirstChild("SpawnLocation")
    if spawnLoc and GetMagnitude(spawnLoc, root) > 15000 then return false end

    State.Killing[char] = true
    local originalFallen = workspace.FallenPartsDestroyHeight

    task.spawn(function()
        local success = SNO(root, State.KillTimeout)
        if not success then
            State.Killing[char] = nil
            return
        end
        if not (char.Parent and hum.Parent and root.Parent) then
            State.Killing[char] = nil
            return
        end

        hum.BreakJointsOnDeath = false
        hum:ChangeState(Enum.HumanoidStateType.Dead)
        workspace.FallenPartsDestroyHeight = 0/0
        PivotTo(char, CFrame.new(0, -11111, 0))

        local ping = math.clamp(LocalPlayer:GetNetworkPing() + 0.05, 0.08, 0.25)
        task.delay(ping, function()
            workspace.FallenPartsDestroyHeight = -10000
            task.wait()
            workspace.FallenPartsDestroyHeight = originalFallen
            task.delay(0.5, function()
                if root and root.Parent then pcall(RNO, root) end
            end)
        end)

        task.delay(1.5, function()
            State.Killing[char] = nil
        end)
    end)

    return true
end

-- ============================================================
-- Auto Kill loop（トグルONの間ずっと実行）
-- ============================================================
local function AutoKillLoop()
    State.AutoLoopGen = State.AutoLoopGen + 1
    local myGen = State.AutoLoopGen

    task.spawn(function()
        while not State.Stopped
              and State.AutoLoopGen == myGen
              and (State.AutoKill or State.AutoKillAll)
        do
            local targets = {}
            if State.AutoKillAll then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer then
                        targets[#targets + 1] = p
                    end
                end
            else
                for player in pairs(Selected) do
                    if player and player.Parent == Players then
                        targets[#targets + 1] = player
                    end
                end
            end

            for _, player in ipairs(targets) do
                if State.Stopped
                   or State.AutoLoopGen ~= myGen
                   or not (State.AutoKill or State.AutoKillAll) then
                    break
                end
                local _, _, hum = GetChar(player)
                if hum and hum.Health > 0 then
                    Kill(player)
                end
                task.wait(State.KillDelay)
            end

            task.wait(0.1)
        end
    end)
end

-- ============================================================
-- Format player for the Player dropdown
-- ============================================================
local function FormatPlayer(p, onNewLine, showYou)
    if type(p) ~= "table" then p = Players:FindFirstChild(p) end
    if not p then return "???" end
    if p == LocalPlayer and showYou then return "You" end
    return ("%s%s (@%s)"):format(p.DisplayName, onNewLine and "\n" or "", p.Name)
end

