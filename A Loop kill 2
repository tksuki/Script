local SettingsGroup = Tabs.Main:AddRightGroupbox('実行設定')

-- ドロップダウンの作成
TargetGroup:AddDropdown('PlayerSelect', {
    Values = {},
    Default = 0,
    Multi = true,
    Text = 'プレイヤー',
    Tooltip = 'ループキルするプレイヤーを複数選択できます',
})

-- プレイヤーリストの更新関数
local function UpdatePlayerDropdown()
    local list = {}
    DisplayToUsername = {}
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer then
            local displayStr = v.DisplayName .. " (@" .. v.Name .. ")"
            table.insert(list, displayStr)
            DisplayToUsername[displayStr] = v.Name
        end
    end
    table.sort(list, tableAlphabeticOrder)

    if Options.PlayerSelect then
        Options.PlayerSelect:SetValues(list)
    end
end

TargetGroup:AddButton('リストを手動更新', function()
    UpdatePlayerDropdown()
end)

-- ドロップダウンの値が変更されたときの処理
Options.PlayerSelect:OnChanged(function()
    LoopList = {}
    local selected = Options.PlayerSelect.Value

    if type(selected) == "table" then
        for displayStr, isSelected in pairs(selected) do
            if isSelected and DisplayToUsername[displayStr] then
                table.insert(LoopList, DisplayToUsername[displayStr])
            end
        end
    end
end)

-- ループキルのトグル
SettingsGroup:AddToggle('LoopKillToggle', {
    Text = 'ループキル実行',
    Default = false,
    Tooltip = '選択したプレイヤーへのループキルを開始/停止します',
    Callback = function(Value)
        _G.LoopKill = Value
        _G.NoclipToggle = Value

        if Value then
            StartNoclip()

            task.spawn(function()
                while _G.LoopKill do
                    local originalPos = GetPlayerCFrame()

                    for _, playerName in pairs(LoopList) do
                        local targetPlayer = Players:FindFirstChild(playerName)

                        if targetPlayer and IsValidTarget(targetPlayer) then
                            local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                            local targetHumanoid = targetPlayer.Character:FindFirstChild("Humanoid")

                            if targetRoot and targetHumanoid then
                                for i = 0, 50 do
                                    StartNoclip()
                                    SNOWshipPlayer(targetPlayer)

                                    if not IsValidTarget(targetPlayer) or (not _G.LoopKill or (CheckNetworkOwnerShipOnPlayer(targetPlayer) or targetRoot.AssemblyLinearVelocity.Magnitude > 500)) then
                                        -- 先に奈落へ落とす
                                        CreateSkyVelocity(targetRoot)
                                        -- その後でグラブラインを破棄する
                                        task.wait()
                                        DestroyGrabLine:FireServer(targetRoot)
                                        break
                                    end

                                    task.wait()

                                    if targetRoot.Position.Y <= -12 then
                                        TeleportPlayer(CFrame.new(targetRoot.Position + Vector3.new(0, 5, -15)))
                                    else
                                        TeleportPlayer(CFrame.new(targetRoot.Position + Vector3.new(0, -10, -10)))
                                    end

                                    targetHumanoid.BreakJointsOnDeath = false
                                    targetHumanoid:ChangeState(Enum.HumanoidStateType.Dead)
                                    targetHumanoid.Jump = true
                                    targetHumanoid.Sit = false
                                end
                            end
                        end
                    end

                    if originalPos then
                        TeleportPlayer(originalPos)
                    end
                    task.wait(0.2)
                end

                StopNoclip()
            end)
        else
            StopNoclip()
        end
    end
})

