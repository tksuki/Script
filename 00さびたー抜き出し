															_bh_activeWaiters[child] = nil

															if v76 then
																_bh_claimedVictims[v76.UserId] = nil
															end

															connection5:Disconnect()
														end)
													end)

													workspace.ChildRemoved:Connect(function(child)
														if child.Name ~= "BlackHoleKick" then
