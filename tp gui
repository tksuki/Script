-- 円形化処理
local btnCorner = Instance.new("UICorner")
btnCorner.CornerRadius = UDim.new(1, 0)
btnCorner.Parent = tpButton

local function teleportToCenter()
    local character = player.Character
    if not character then return end
    
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local viewportSize = camera.ViewportSize
    local centerRay = camera:ViewportPointToRay(viewportSize.X / 2, viewportSize.Y / 2)
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {character}

    local result = Workspace:Raycast(centerRay.Origin, centerRay.Direction * 10000, raycastParams)
    if not result then return end

    local hitPos = result.Position
    local hitNormal = result.Normal
    local targetPos

    local isAbovePlayer = hitPos.Y > (hrp.Position.Y - 2)
    local isNotFlatHorizontal = math.abs(hitNormal.Y) < 0.7 

    if isAbovePlayer and isNotFlatHorizontal then
        local checkOrigin = hitPos + Vector3.new(0, 5, 0) - (hitNormal * 2.5)
        local topRayResult = Workspace:Raycast(checkOrigin, Vector3.new(0, -15, 0), raycastParams)

        if topRayResult then
            targetPos = topRayResult.Position + Vector3.new(0, 3.5, 0)
        else
            targetPos = hitPos + (hitNormal * 2) + Vector3.new(0, 3, 0)
        end
    else
        targetPos = hitPos + (hitNormal * 3)
    end

    local currentRotation = hrp.CFrame - hrp.CFrame.Position
    hrp.CFrame = CFrame.new(targetPos) * currentRotation

    local originalColor = tpButton.BackgroundColor3
    tpButton.BackgroundColor3 = Color3.fromRGB(0, 220, 110)
    task.wait(0.2)
    tpButton.BackgroundColor3 = originalColor
end

tpButton.MouseButton1Click:Connect(teleportToCenter)
