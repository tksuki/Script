-- 本物の手の骨の長さ(cm): 近位 / 中節 / 末節
-- 並びは左(小指側)→右(人差し指側)。親指は2本のハシゴで表現
local FINGER_CM = {
    { 3.3, 1.9, 1.7 }, -- 小指
    { 4.1, 2.5, 1.9 }, -- 薬指
    { 4.4, 2.6, 1.9 }, -- 中指
    { 3.9, 2.3, 1.8 }, -- 人差し指
