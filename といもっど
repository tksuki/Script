local function buildPlayerList(leaving)
    playerMap = {}
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr ~= leaving then
            local label = plr.DisplayName .. " (" .. plr.Name .. ")"
            playerMap[label] = plr
            table.insert(list, label)
        end
    end
    table.sort(list)
    return list
end

