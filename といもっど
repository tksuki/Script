    handGrabConn = remote.OnClientEvent:Connect(function(plr, part)
        if typeof(plr) ~= "Instance" or plr == LocalPlayer then return end -- 他ユーザーだけ
        if typeof(part) ~= "Instance" then return end
        local item = findMyHandItem(part) -- 掴まれた物が自分のものか
        if item then
            resendHandSNO(item)
        end
    end)
end

local function stopHandMonitor()
