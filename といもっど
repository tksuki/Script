                makeHandSpawn("PalletLightBrown"))

            -- 2. ハシゴ (14個 / 剣ありは17個)
            local ladBase = countToys("LadderLightBrown")
            runSpawnLoop("LadderLightBrown", isActive,
                function() return ladBase + ladderNeed end,
                makeHandSpawn("LadderLightBrown"))

            spawningHand = false

            -- 3. ワークスペースから実物を集める (最大5秒待つ)
            local pallets, ladders = {}, {}
            local t0 = os.clock()
            while Toggles.HandSpawn.Value and os.clock() - t0 < 5 do
                pallets = collectHand("PalletLightBrown")
                ladders = collectHand("LadderLightBrown")
                if #pallets >= 1 and #ladders >= ladderNeed then break end
                task.wait(0.1)
            end

            print(("[手] パレット %d / ハシゴ %d (必要 %d)"):format(#pallets, #ladders, ladderNeed))

            if Toggles.HandSpawn.Value and #pallets >= 1 and #ladders >= ladderNeed then
                task.wait(0.3)
                local ok, err = pcall(function()
                    buildHand(pallets[1], ladders, withSword)
                    startHandFollow()
                end)
                if not ok then
                    warn("[手] 組み立てエラー: " .. tostring(err))
                    stopHand()
                    Toggles.HandSpawn:SetValue(false)
                else
                    print("[手] 完成")
                end
            else
                print("[手] パーツが足りないため中止")
                if Toggles.HandSpawn.Value then
                    Toggles.HandSpawn:SetValue(false)
                end
            end
        end)
    end,
})
