local REAL_PALM_CM = 9.25 -- 本物の手のひら (幅8.5 / 長さ10) の平均

local function sendHandSNO(item)
    task.spawn(function()
        for _ = 1, SNO_COUNT do
            if not item.Parent then break end
            local sp = item:FindFirstChild("SoundPart", true)
            if sp then
                pcall(function()
                    ReplicatedStorage.GrabEvents.SetNetworkOwner:FireServer(sp, sp.CFrame)
                end)
            end
            task.wait(SNO_INTERVAL)
        end
    end)
end

-- 他のプレイヤーが手の部品を掴んできた時の監視
-- CreateGrabLine(他プレイヤー, 掴まれたSoundPart, CFrame) を見て、
-- 掴まれた物が自分の手のパーツなら、そのパーツにSNOを10回送って取り返す
local handSnoBusy = {}

local function resendHandSNO(item)
    if handSnoBusy[item] then return end -- 送信中の重複は避ける
    handSnoBusy[item] = true
    task.spawn(function()
        for _ = 1, HAND_RECLAIM_COUNT do
            if not item.Parent then break end
            local sp = item:FindFirstChild("SoundPart", true)
            if sp then
                pcall(function()
                    ReplicatedStorage.GrabEvents.SetNetworkOwner:FireServer(sp, sp.CFrame)
                end)
            end
            task.wait(SNO_INTERVAL)
        end
        handSnoBusy[item] = nil
    end)
end

local function findMyHandItem(obj)
    local m = obj
    while m and m ~= workspace do
        if handHandled[m] then return m end
        m = m.Parent
