local handledBalls = {}
local spawningBall = false
local ballRotation = CFrame.new(-31.7941322, -5.72099543, -14.8753529, 0, -0.258819044, 0.965925813, 0, 0.965925813, 0.258819044, -1, 0, 0)
ballRotation = ballRotation - ballRotation.Position

-- 発光球体で出した物の一覧 (雨降らしで使う)
local ballList = {}

local function getBallPart(ball)
    if ball:IsA("BasePart") then return ball end
    if ball:IsA("Model") and ball.PrimaryPart then return ball.PrimaryPart end
    return ball:FindFirstChildWhichIsA("BasePart", true)
end

-- 発光球体専用のSNO
-- 送る対象: BallMagicLight.SoundPart / 座標: 発光球体の座標
--   plot外: workspace.<自分のユーザー名>SpawnedInToys.BallMagicLight.SoundPart
--   plot内: workspace.PlotItems.PlotN.BallMagicLight.SoundPart (PlotNは出た場所から自動)
-- SoundPartは球体のインスタンスから直接取るので、フォルダ名・Plot番号は自動で正しいものになる
local function sendBallSNO(ball, part)
    task.spawn(function()
        for _ = 1, SNO_COUNT do
            if not ball.Parent then break end -- 消えたら中止

            local soundPart = ball:FindFirstChild("SoundPart", true)
            if soundPart then
                local cf = (part and part.Parent) and part.CFrame or soundPart.CFrame -- 発光球体の座標
                pcall(function()
                    ReplicatedStorage.GrabEvents.SetNetworkOwner:FireServer(soundPart, cf)
                end)
            end
            task.wait(SNO_INTERVAL)
        end
    end)
end

local function registerBall(ball)
    if handledBalls[ball] then return end
    handledBalls[ball] = true

    local part = getBallPart(ball)
    if not part then return end

    table.insert(ballList, { obj = ball, part = part })

    -- 0.05秒かけて0.01秒間隔でSoundPartにSNOを5回
    sendBallSNO(ball, part)
end

local function findNewBalls()
    local found = {}

    local function scan(folder)
        if not folder then return end
        for _, item in ipairs(folder:GetChildren()) do
            if item.Name == "BallMagicLight" and not handledBalls[item] then
                table.insert(found, item)
            end
        end
    end

    local plotItems = workspace:FindFirstChild("PlotItems")
    if plotItems then
        local myPlot = getMyPlotName()
        local targets = myPlot and { myPlot } or PLOT_NAMES
        for _, name in ipairs(targets) do
            scan(plotItems:FindFirstChild(name))
        end
    end
    scan(getMySpawnedFolder())

    return found
end

local function spawnBallOne()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    local pos = (root.CFrame * CFrame.new(0, 0, -5)).Position
    local ok, result = pcall(function()
        return ReplicatedStorage.MenuToys.SpawnToyRemoteFunction:InvokeServer(
            "BallMagicLight",
            CFrame.new(pos) * ballRotation,
            Vector3.new(0, 90, 0)
        )
    end)

    task.wait(0.01)

    if ok and typeof(result) == "Instance" then
        registerBall(result)
    else
        for _, b in ipairs(findNewBalls()) do
            registerBall(b)
        end
    end
    if ok and typeof(result) == "Instance" then return result end
    return false
end

