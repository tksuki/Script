-- 雨降らし (発光球体・雪で出した物を使う)
--------------------------------------------------------------------
local RAIN_RADIUS = 750      -- リスポーン地点を中心にした半径
local RAIN_RESET_BELOW = 10  -- リスポーン地点よりこれだけ下がったら上に戻す

local rainConn
local rainState = {}      -- [ballListの要素] = { dx, dz, y, offset, cell }
local rainCells = {}      -- 使用中の格子マス (雨間隔ごとに1マス1個)
local rainLastSpacing
local rainLastRadius
local rainCenter = Vector3.new(0, 0, 0)

-- マップのリスポーン地点 (有効なSpawnLocationを優先)
local function findRespawnPos()
    local any
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("SpawnLocation") then
            if d.Enabled then return d.Position end
            any = any or d
        end
    end
    if any then return any.Position end

    local rl = LocalPlayer.RespawnLocation
    if rl then return rl.Position end

    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    return root and root.Position or Vector3.new(0, 0, 0)
end

-- 半径750の円の中で、雨間隔ごとの格子のうち空いているマスをランダムに選ぶ
local function getRainRadius()
    return (Options.RainRadius and Options.RainRadius.Value) or RAIN_RADIUS
end

local function pickCell(spacing)
    local radius = getRainRadius()
    local maxI = math.max(1, math.floor(radius / spacing))
    for _ = 1, 12 do
        local ix = math.random(-maxI, maxI)
        local iz = math.random(-maxI, maxI)
        if ix * ix + iz * iz <= maxI * maxI then
            local key = ix .. "," .. iz
            if not rainCells[key] then
                rainCells[key] = true
                return key, ix * spacing, iz * spacing
            end
        end
    end
    -- 空きが見つからない時(個数が多い時)は重なりを許して円の中のどこかに置く
    local ang = math.random() * math.pi * 2
    local r = radius * math.sqrt(math.random())
    return nil, math.cos(ang) * r, math.sin(ang) * r
end

-- 上(雨高さ)のランダムな場所に戻す
local function resetRainBall(st, spacing, height)
    if st.cell then rainCells[st.cell] = nil end
    st.cell, st.dx, st.dz = pickCell(spacing)
    st.y = rainCenter.Y + height
    st.offset = math.random(-50, 50)
end

local function setRainCollision(entry, enabled)
    if entry.obj and entry.obj.Parent then
        setCollision(entry.obj, enabled)
    end
end

local function stopRain()
    if rainConn then
        rainConn:Disconnect()
        rainConn = nil
    end
    for entry in pairs(rainState) do
        setRainCollision(entry, true)
    end
    rainState = {}
    rainCells = {}
    rainLastSpacing = nil
    rainLastRadius = nil
end

local function startRain()
    if rainConn then return end

    rainCenter = findRespawnPos()
    rainState = {}
    rainCells = {}
    rainLastSpacing = nil
    rainLastRadius = nil

    if #ballList == 0 then
        print("[雨降らし] 発光球体がありません。先に発光球体をスポーンしてください (出た分から順に雨になります)")
    end

    rainConn = RunService.Heartbeat:Connect(function(dt)
        local spacing = math.max(Options.RainInterval.Value, 1)
        local baseSpeed = Options.RainSpeed.Value
        local height = Options.RainHeight.Value
        local randomSpeed = Toggles.RainRandomSpeed.Value

        -- 雨間隔または雨半径が変わったら、全部の位置を配り直す
        local radiusNow = getRainRadius()
        if spacing ~= rainLastSpacing or radiusNow ~= rainLastRadius then
            rainLastSpacing = spacing
            rainLastRadius = radiusNow
            rainCells = {}
            for _, st in pairs(rainState) do
                st.cell, st.dx, st.dz = pickCell(spacing)
            end
        end

        -- 消えた物を片付け、新しく増えた物を追加
        for i = #ballList, 1, -1 do
            local entry = ballList[i]
            if not entry.obj or not entry.obj.Parent then
                local st = rainState[entry]
                if st and st.cell then rainCells[st.cell] = nil end
                rainState[entry] = nil
                table.remove(ballList, i)
            end
        end

        for _, entry in ipairs(ballList) do
            local st = rainState[entry]
            if not st then
                st = {}
                rainState[entry] = st
                resetRainBall(st, spacing, height)
                setRainCollision(entry, false)
            end

            local speed = baseSpeed
            if randomSpeed then
                speed = math.max(1, baseSpeed + st.offset) -- 中心±50でバラバラ
            end

            st.y = st.y - speed * dt

            -- リスポーン地点より10スタッド下がったら、上のどこかランダムな場所に戻す
            if st.y < rainCenter.Y - RAIN_RESET_BELOW then
                resetRainBall(st, spacing, height)
            end

            -- 雪の時だけ、縦軸まわりにゆっくり回転させる (速度はスライダー、度/秒)
            local rot = entry.rot or ballRotation
            if entry.rot then
                st.spin = (st.spin or math.random() * math.pi * 2)
                    + math.rad(Options.SnowSpinSpeed.Value) * dt
                rot = CFrame.Angles(0, st.spin, 0) * entry.rot
            end

            local cf = CFrame.new(rainCenter.X + st.dx, st.y, rainCenter.Z + st.dz) * rot
            local part = entry.part
            if entry.obj:IsA("Model") then
                entry.obj:PivotTo(cf)
            elseif part and part.Parent then
                part.CFrame = cf
            end
            if part and part.Parent then
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end)
end

