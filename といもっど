    if plotItems then
        local myPlot = getMyPlotName()
        local targets = myPlot and { myPlot } or PLOT_NAMES
        for _, name in ipairs(targets) do
            scan(plotItems:FindFirstChild(name))
        end
    end
    scan(getMySpawnedFolder())

    return found
end

