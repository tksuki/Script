-- 入退室で一覧を更新
local function refreshPlayerList(leaving)
    local list = buildPlayerList(leaving)
    local dd = Options.SelectedPlayer
    if not dd then return end

    local current = dd.Value
    pcall(function() dd:SetValues(list) end)

    -- 退室などで選択中のプレイヤーが消えた場合は選択を外す
    if current and not playerMap[current] then
        pcall(function() dd:SetValue(nil) end)
    end
end

