Group:AddSlider("SparklerCount", {
    Text = "スパークラー本数",
    Default = 10, Min = 1, Max = 30, Rounding = 0, Suffix = "本",
})

Group:AddToggle("SparklerSpawn", {
    Text = "スパークラースポーン",
    Default = false,
    Callback = function(value)
        if not value then
            spawning = false
            return
        end
        if spawning then return end
        spawning = true

        task.spawn(function()
            local count = Options.SparklerCount.Value

            -- 既存のものは対象外にする
            for _, s in ipairs(findNewSparklers()) do
                handled[s] = true
            end

            for _ = 1, count do
                if not Toggles.SparklerSpawn.Value then break end
                spawnOne()
                task.wait(0.25)
            end

            spawning = false
            if Toggles.SparklerSpawn.Value then
                Toggles.SparklerSpawn:SetValue(false)
            end
        end)
    end,
})

