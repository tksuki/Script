-- Position Desync (Standalone) - 60fps 対応版
-- Extracted from Resonance v2.9

local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local localPlayer = Players.LocalPlayer

-- 必要な executor 関数チェック
assert(type(sethiddenproperty) == "function", "sethiddenproperty が必要です")
assert(type(setfflag) == "function", "setfflag が必要です")
assert(type(getfflag) == "function", "getfflag が必要です")

-- ============================
--  タイミング定数（60fps 基準）
-- ============================
-- 1フレーム = 1/60 ≈ 0.01667 秒
-- COOLDOWN : HRP 切り替え後に PhysicsRepRootPart をロックし続ける時間
--            元値 0.14s（≈8.4f）→ 9フレーム分 = 0.15s に揃える
-- SETTLE_WAIT : nil セット後にサーバー側へ伝播するのを待つ時間
--            元値 0.1s（≈6f）  → 6フレーム分 = 0.10s（1フレーム単位で丁切り）
-- RATE_CHECK : S2PhysicsSenderRate を再確認する間隔（パフォーマンス節約）
--            1秒（60フレーム）のまま
local COOLDOWN    = 9  / 60   -- 0.1500s … HRP ロック期間
local SETTLE_WAIT = 6  / 60   -- 0.1000s … nil 後の待機
local RATE_CHECK  = 60 / 60   -- 1.0000s … レート確認間隔

-- ローカル状態
local enabled      = false
local rootPart     = nil    -- 現在の HumanoidRootPart
local settled      = false  -- デシンク中（nil セット済み）か
local cooldownUntil = 0
local resetCount   = 0
local originalRate = nil
local rateCheckAt  = 0
local heartbeatConn = nil

-- キャラクター取得ヘルパー
local function getChar()
    local char = localPlayer.Character
    if not char then return nil, nil, nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    return char, hrp, hum
end

-- S2PhysicsSenderRate を指定値に設定して確認する
local function setRate(rate)
    for _, v in ipairs({ tostring(rate), rate }) do
        pcall(setfflag, "S2PhysicsSenderRate", v)
        local ok, result = pcall(getfflag, "S2PhysicsSenderRate")
        if ok and tonumber(result) == rate then
            return true
        end
    end
    return false
end

-- 前方宣言
local disable

-- 内部エラー時に強制オフ
local function forceOff()
    disable()
end

-- HRP のリセット（デシンク解除・カウンタ更新）
local function resetHRP()
    resetCount += 1
    if rootPart and rootPart.Parent then
        pcall(sethiddenproperty, rootPart, "PhysicsRepRootPart", nil)
    end
    rootPart       = nil
    settled        = false
    cooldownUntil  = 0
end

-- Heartbeat ごとに呼ばれる更新関数
local function update()
    if not enabled then return end

    local now = os.clock()

    -- RATE_CHECK 間隔ごとに S2PhysicsSenderRate を再確認
    if rateCheckAt <= now then
        rateCheckAt = now + RATE_CHECK
        local ok, result = pcall(getfflag, "S2PhysicsSenderRate")
        if (not ok or tonumber(result) ~= 1000) and not setRate(1000) then
            forceOff()
            return
        end
    end

    local char, hrp, hum = getChar()

    -- キャラクターが無効なら即リセット
    local invalid = (char ~= localPlayer.Character)
        or not (char and char.Parent and hrp and hum and hum.Health > 0)

    if invalid then
        if rootPart then resetHRP() end
        return
    end

    -- HRP が変わった（リスポーン等）→ リセットして新 HRP を記録
    if hrp ~= rootPart then
        resetHRP()
        rootPart      = hrp
        cooldownUntil = now + COOLDOWN
    end

    -- デシンク待機中は何もしない
    if settled then return end

    -- クールダウン中：PhysicsRepRootPart を自身にセットしてロック
    if now < cooldownUntil then
        if not pcall(sethiddenproperty, rootPart, "PhysicsRepRootPart", rootPart) then
            forceOff()
        end
        return
    end

    -- クールダウン完了 → nil にしてデシンク開始
    settled = true
    local capturedHRP   = rootPart
    local capturedCount = resetCount

    if not pcall(sethiddenproperty, capturedHRP, "PhysicsRepRootPart", nil) then
        forceOff()
        return
    end

    -- SETTLE_WAIT 分だけ待ってサーバーへの伝播を確保（60fps 単位）
    task.wait(SETTLE_WAIT)

    -- 待機中に状態が変わっていたら中断
    if capturedCount ~= resetCount or not enabled or capturedHRP ~= rootPart then
        return
    end
    -- キャラクターが死亡・消滅していたらリセット
    if not capturedHRP.Parent or char ~= localPlayer.Character or hum.Health <= 0 then
        resetHRP()
        return
    end

    -- PhysicsRepRootPart を自身に戻してデシンク状態を維持
    if not pcall(sethiddenproperty, capturedHRP, "PhysicsRepRootPart", capturedHRP) then
        forceOff()
        return
    end

    settled       = false
    cooldownUntil = os.clock() + COOLDOWN
end

-- 有効化
local function enable()
    if enabled then return end

    local ok, result = pcall(getfflag, "S2PhysicsSenderRate")
    if ok and tonumber(result) then
        originalRate = tonumber(result)
    end

    if originalRate == nil then
        warn("[PositionDesync] S2PhysicsSenderRate が取得できませんでした")
        return
    end

    rateCheckAt = os.clock() + RATE_CHECK

    if not setRate(1000) then
        warn("[PositionDesync] S2PhysicsSenderRate の設定に失敗しました")
        return
    end

    enabled        = true
    heartbeatConn  = RunService.Heartbeat:Connect(update)
    print("[PositionDesync] 有効化しました（60fps 対応版）")
end

-- 無効化
disable = function()
    if not enabled then return end
    enabled = false

    if heartbeatConn then
        heartbeatConn:Disconnect()
        heartbeatConn = nil
    end

    resetHRP()

    if originalRate ~= nil then
        setRate(originalRate)
        originalRate = nil
    end

    print("[PositionDesync] 無効化しました")
end

-- トグル
local function toggle()
    if enabled then disable() else enable() end
end

-- ===== 起動 =====
enable()

return {
    enable    = enable,
    disable   = disable,
    toggle    = toggle,
    isEnabled = function() return enabled end,
}
