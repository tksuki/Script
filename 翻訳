-- ========================================
-- 各ページのセットアップ
-- ========================================

local function setupPage(
    page,
    pageType
)

    -- ------------------------------------
    -- 言語選択部分
    -- ------------------------------------

    local languageFrame =
        createInstance(
            "Frame",
            page,
            {
                Size = UDim2.new(
                    0,
                    330,
                    0,
                    35
                ),

                Position = UDim2.new(
                    0,
                    10,
                    0,
                    10
                ),

                BackgroundColor3 =
                    Color3.fromRGB(
                        35,
                        35,
                        35
                    )
            }
        )


    local languageButton =
        createInstance(
            "TextButton",
            languageFrame,
            {
                Size = UDim2.new(
                    1,
                    0,
                    1,
                    0
                ),

                Text =
                    pageType == "C"
                    and "送信用: 英語"
                    or "看板用: 日本語",

                BackgroundTransparency = 1,

                TextColor3 =
                    Color3.new(
                        1,
                        1,
                        1
                    )
            }
        )


    local languageList =
        createInstance(
            "Frame",
            languageFrame,
            {
                Size = UDim2.new(
                    1,
                    0,
                    0,
                    175
                ),

                Position = UDim2.new(
                    0,
                    0,
                    1,
                    5
                ),

                Visible = false,

                ZIndex = 20,

                BackgroundColor3 =
                    Color3.fromRGB(
                        25,
                        25,
                        25
                    )
            }
        )


    -- ------------------------------------
    -- 言語選択肢
    -- ------------------------------------

    for index, language in ipairs(
        languages
    ) do

        local option =
            createInstance(
                "TextButton",
                languageList,
                {
                    Size = UDim2.new(
                        1,
                        0,
                        0,
                        35
                    ),

                    Position = UDim2.new(
                        0,
                        0,
                        0,
                        (index - 1) * 35
                    ),

                    Text = language[1],

                    BackgroundTransparency = 1,

                    TextColor3 =
                        Color3.new(
                            1,
                            1,
                            1
                        ),

                    ZIndex = 21
                }
            )


        option.MouseButton1Click:Connect(
            function()

                if pageType == "C" then

                    chatLanguage =
                        language[2]

                else

                    signboardLanguage =
                        language[2]

                end


                languageButton.Text =
                    (
                        pageType == "C"
                        and "送信用: "
                        or "看板用: "
                    )
                    .. language[1]


                languageList.Visible =
                    false

            end
        )

    end


    -- ------------------------------------
    -- 言語リスト開閉
    -- ------------------------------------

    languageButton.MouseButton1Click:Connect(
        function()

            languageList.Visible =
                not languageList.Visible

        end
    )


    -- ------------------------------------
    -- 入力欄
    -- ------------------------------------

    local inputBox =
        createInstance(
            "TextBox",
            page,
            {
                Size = UDim2.new(
                    0,
                    330,
                    0,
                    40
                ),

                Position = UDim2.new(
                    0,
                    10,
                    0,
                    55
                ),

                PlaceholderText =
                    "文章を入力...",

                BackgroundColor3 =
                    Color3.fromRGB(
                        35,
                        35,
                        35
                    ),

                TextColor3 =
                    Color3.new(
                        1,
                        1,
                        1
                    )
            }
        )


    -- ------------------------------------
    -- 実行ボタン
    -- ------------------------------------

    local executeButton =
        createInstance(
            "TextButton",
            page,
            {
                Size = UDim2.new(
                    0,
                    330,
                    0,
                    45
                ),

                Position = UDim2.new(
                    0,
                    10,
                    0,
                    105
                ),

                Text =
                    pageType == "C"
                    and "翻訳して送信"
                    or "看板を更新",

                BackgroundColor3 =
                    Color3.fromRGB(
                        0,
                        pageType == "C"
                        and 150
                        or 200,
                        255
                    ),

                TextColor3 =
                    Color3.new(
                        1,
                        1,
                        1
                    ),

                Font =
                    Enum.Font.GothamBold
            }
        )


    createInstance(
        "UICorner",
        executeButton,
        {}
    )


    -- ====================================
    -- 実行処理
    -- ====================================

    executeButton.MouseButton1Click:Connect(
        function()

            if inputBox.Text == "" then
                return
            end


            executeButton.Text =
                "翻訳中..."


            local targetLanguage =
                pageType == "C"
                and chatLanguage
                or signboardLanguage


            local translatedText =
                translate(
                    inputBox.Text,
                    targetLanguage
                )


            -- ==================================
            -- チャット送信
            -- ==================================

            if pageType == "C" then

                local TextChatService =
                    game:GetService(
                        "TextChatService"
                    )


                if TextChatService.ChatVersion
                    == Enum.ChatVersion.TextChatService
                then

                    local TextChannels =
                        TextChatService:
                        FindFirstChild(
                            "TextChannels"
                        )


                    local GeneralChannel =
                        TextChannels
                        and TextChannels:
                        FindFirstChild(
                            "RBXGeneral"
                        )


                    if GeneralChannel then

                        GeneralChannel:
                        SendAsync(
                            translatedText
                        )

                    else

                        warn(
                            "RBXGeneralが見つかりません。"
                        )

                    end

                else

                    local ReplicatedStorage =
                        game:GetService(
                            "ReplicatedStorage"
                        )


                    local SayMessageRequest =
                        ReplicatedStorage:
                        FindFirstChild(
                            "SayMessageRequest",
                            true
                        )


                    if SayMessageRequest then

                        SayMessageRequest:
                        FireServer(
                            translatedText,
                            "All"
                        )

                    else

                        warn(
                            "SayMessageRequestが見つかりません。"
                        )

                    end

                end


            -- ==================================
            -- 看板更新
            -- ==================================

            else

                local character =
                    LocalPlayer.Character


                local tool =
                    character
                    and character:
                    FindFirstChildWhichIsA(
                        "Tool"
                    )


                if tool then

                    for _, object in ipairs(
                        tool:GetDescendants()
                    ) do

                        if object:IsA(
                            "TextBox"
                        )
                        or object:IsA(
                            "TextLabel"
                        ) then

                            object.Text =
                                translatedText

                        end

                    end

                else

                    warn(
                        "Toolが見つかりません。"
                    )

                end

            end


            inputBox.Text = ""


            executeButton.Text =
                pageType == "C"
                and "翻訳して送信"
                or "看板を更新"

        end
    )

end


