-- ========================================
-- 翻訳処理
-- ========================================

local function translate(text, targetLanguage)

    if not text or text == "" then
        return text
    end


    local body = HttpService:JSONEncode({
        text = {
            text
        },

        target_lang = targetLanguage
    })


    local success, response = pcall(function()

        if request then

            local result = request({
                Url = DEEPL_URL,

                Method = "POST",

                Headers = {
                    ["Content-Type"] = "application/json",

                    ["Authorization"] =
                        "DeepL-Auth-Key "
                        .. DEEPL_API_KEY
                },

                Body = body
            })


            return {
                StatusCode = result.StatusCode,
                Body = result.Body
            }

        else

            error(
                "この環境ではrequestが使用できません。"
            )

        end
    end)


    if not success then

        warn(
            "DeepL APIへのリクエストに失敗しました:",
            response
        )

        return text
    end


    if not response
        or response.StatusCode ~= 200 then

        warn(
            "DeepL APIエラー:",
            response and response.StatusCode,
            response and response.Body
        )

        return text
    end


    -- ====================================
    -- JSON解析
    -- ====================================

    local decodeSuccess, data = pcall(function()

        return HttpService:JSONDecode(
            response.Body
        )

    end)


    if not decodeSuccess or not data then

        warn(
            "DeepLのレスポンス解析に失敗しました:",
            response.Body
        )

        return text
    end


    -- ====================================
    -- 翻訳結果取得
    -- ====================================

    if data.translations
        and data.translations[1]
        and data.translations[1].text then

        return data.translations[1].text
    end


    warn(
        "DeepLから翻訳結果を取得できませんでした:",
        response.Body
    )


    return text
end


-- ========================================
-- Instance作成用ヘルパー
-- ========================================

local function createInstance(
    className,
    parent,
    properties
)

    local instance = Instance.new(
        className
    )


    for property, value in pairs(properties) do
        instance[property] = value
    end


    instance.Parent = parent

    return instance
end


