-- ========================================
-- 翻訳処理
-- ========================================

local function translate(text, targetLanguage)
    if not text or text == "" then
        return text
    end

    local url =
        "https://translate.googleapis.com/translate_a/single"
        .. "?client=gtx"
        .. "&sl=auto"
        .. "&tl=" .. HttpService:UrlEncode(targetLanguage)
        .. "&dt=t"
        .. "&q=" .. HttpService:UrlEncode(text)

    local success, response = pcall(function()
        if request then
            local result = request({
                Url = url,
                Method = "GET"
            })

            return result.Body
        else
            return game:HttpGet(url)
        end
    end)

    if not success or not response then
        warn("翻訳リクエストに失敗しました:", response)
        return text
    end

    -- JSONをデコード
    local decodeSuccess, data = pcall(function()
        return HttpService:JSONDecode(response)
    end)

    if not decodeSuccess or not data then
        warn("翻訳レスポンスの解析に失敗しました:", response)
        return text
    end

    local translatedText = ""

    -- 翻訳結果を結合
    if data[1] then
        for _, segment in ipairs(data[1]) do
            if segment[1] then
                translatedText ..= segment[1]
            end
        end
    end

    if translatedText ~= "" then
        return translatedText
    end

    return text
end


-- ========================================
-- Instance作成用ヘルパー
-- ========================================

local function createInstance(className, parent, properties)
    local instance = Instance.new(className)

    for property, value in pairs(properties) do
        instance[property] = value
    end

    instance.Parent = parent

    return instance
end


