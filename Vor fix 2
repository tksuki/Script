-- Loop Banana用の変数
local bananaLoopActive = false
local bananaLoopConnection = nil
local bananaMonitorConnection = nil
local currentBanana = nil
local isBananaTargetDead = false

local function BananaSetNetworkOwner(part)
    if not part then return end
    pcall(function() SetNetworkOwner:FireServer(part, part.CFrame) end)
end

local function BananaDestroyGrabLine(part)
    if not part then return end
    pcall(function() DestroyGrabLine:FireServer(part) end)
end

local function BananaDestroyToy(banana)
    if not banana then return end
    pcall(function() DestroyToy:FireServer(banana) end)
end

local function BananaSpawn()
    local hrp = HRP()
    if not hrp then return nil end
    local spawnPos = hrp.CFrame * CFrame.new(0, 14, 20)
    local folder = SpawnedInToys
    if not folder then return nil end
    local spawned = nil
    local conn
    conn = folder.ChildAdded:Connect(function(child)
        if child.Name == "FoodBanana" then
            spawned = child
            conn:Disconnect()
        end
    end)
    task.spawn(function()
        pcall(function() spawntoy("FoodBanana", spawnPos, Vector3.zero) end)
    end)
    local start = tick()
    repeat task.wait(0.05) until spawned or (tick() - start) > 3
    pcall(function() conn:Disconnect() end)
    return spawned
end

local function BananaHold(banana)
    if not banana then return end
    local holdPart = banana:FindFirstChild("HoldPart")
    if not holdPart then return end
    local holdRemote = holdPart:FindFirstChild("HoldItemRemoteFunction")
    if not holdRemote then return end
    local char = GetCharacter()
    if not char then return end
    for i = 1, 5 do
        if not banana or not banana.Parent then break end
        pcall(function() holdRemote:InvokeServer(banana, char) end)
        task.wait(0.08)
    end
end

local function BananaDrop(banana)
    if not banana then return end
    local holdPart = banana:FindFirstChild("HoldPart")
    if not holdPart then return end
    local dropRemote = holdPart:FindFirstChild("DropItemRemoteFunction")
    if not dropRemote then return end
    local hrp = HRP()
    if not hrp then return end
    local dropPos = hrp.CFrame * CFrame.new(0, 15, 0)
    pcall(function() dropRemote:InvokeServer(banana, dropPos, dropPos) end)
end

local function BananaUse(banana)
    if not banana then return end
    pcall(function() UseRemote:FireServer(banana) end)
end

local function BananaGetTargetLeg()
    local targetName = Config.PlayerList and Config.PlayerList[1]
    if not targetName then return nil end
    local target = service.Players:FindFirstChild(targetName)
    if not target or not target.Character then return nil end
    return target.Character:FindFirstChild("Left Leg") or target.Character:FindFirstChild("LeftUpperLeg")
end

local function BananaGetTargetHealth()
    local targetName = Config.PlayerList and Config.PlayerList[1]
    if not targetName then return 0 end
    local target = service.Players:FindFirstChild(targetName)
    if not target or not target.Character then return 0 end
    local hum = target.Character:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health or 0
end

local function BananaFullCycle()
    local targetName = Config.PlayerList and Config.PlayerList[1]
    if not targetName or targetName == "" then return nil end
    local banana = BananaSpawn()
    if not banana then return nil end
    BananaHold(banana)
    task.wait(0.5)
    BananaUse(banana)
    task.wait(2.3)
    BananaDrop(banana)
    task.wait(0.08)
    BananaDrop(banana)
    task.wait(0.3)
    return banana
end

local function BananaStopLoop()
    bananaLoopActive = false
    if bananaLoopConnection then bananaLoopConnection:Disconnect(); bananaLoopConnection = nil end
    if bananaMonitorConnection then bananaMonitorConnection:Disconnect(); bananaMonitorConnection = nil end
    if currentBanana then BananaDestroyToy(currentBanana); currentBanana = nil end
    local folder = SpawnedInToys
    if folder then
        for _, child in pairs(folder:GetChildren()) do
            if child.Name == "FoodBanana" then BananaDestroyToy(child) end
        end
    end
end

local function BananaRestartLoop(banana)
    if bananaLoopConnection then bananaLoopConnection:Disconnect(); bananaLoopConnection = nil end
    currentBanana = banana
    local hitboxPart = banana:FindFirstChild("HitboxPart")
    if not hitboxPart then return end
    bananaLoopConnection = service.RunService.Heartbeat:Connect(function()
        if not bananaLoopActive then BananaStopLoop(); return end
        if not currentBanana or not currentBanana.Parent then return end
        local hrp = HRP()
        if not hrp then return end
        local targetPos, targetCFrame
        local health = BananaGetTargetHealth()
        if health <= 0 then
            isBananaTargetDead = true
            targetPos = hrp.CFrame * CFrame.new(0, 20, 0)
            targetCFrame = CFrame.new(targetPos.Position)
        else
            isBananaTargetDead = false
            local leg = BananaGetTargetLeg()
            if leg then
                targetPos = leg.CFrame * CFrame.new(0, 0.5, 0)
                targetCFrame = leg.CFrame
            else
                targetPos = hrp.CFrame * CFrame.new(0, 20, 0)
                targetCFrame = CFrame.new(targetPos.Position)
            end
        end
        BananaSetNetworkOwner(hitboxPart)
        BananaDestroyGrabLine(hitboxPart)
        local bp = hitboxPart:FindFirstChild("BodyPosition")
        if not bp then
            bp = Instance.new("BodyPosition")
            bp.P = 10000; bp.D = 100
            bp.MaxForce = Vector3.new(1e9, 1e9, 1e9)
            bp.Parent = hitboxPart
        end
        bp.Position = targetPos.Position
        local bg = hitboxPart:FindFirstChild("BodyGyro")
        if not bg then
            bg = Instance.new("BodyGyro")
            bg.P = 10000; bg.D = 100
            bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
            bg.Parent = hitboxPart
        end
        bg.CFrame = targetCFrame
    end)
end

local function BananaStartLoop()
    if bananaLoopActive then return end
    local targetName = Config.PlayerList and Config.PlayerList[1]
    if not targetName or targetName == "" then return end
    bananaLoopActive = true
    isBananaTargetDead = false
    local banana = BananaFullCycle()
    if banana then BananaRestartLoop(banana) end
    bananaMonitorConnection = service.RunService.Heartbeat:Connect(function()
        if not bananaLoopActive then return end
        local folder = SpawnedInToys
        local bananaExists = false
        if folder then
            for _, child in pairs(folder:GetChildren()) do
                if child.Name == "FoodBanana" then bananaExists = true; break end
            end
        end
        if not bananaExists then
            if bananaLoopConnection then bananaLoopConnection:Disconnect(); bananaLoopConnection = nil end
            task.wait(0.05)
            local newBanana = BananaFullCycle()
            if newBanana then BananaRestartLoop(newBanana) end
        end
    end)
end

