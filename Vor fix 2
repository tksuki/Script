local function BreakSpawnAndBreakGround(targetPart, shurikenTbl)
    if not targetPart or targetPart:IsA("Terrain") then return end
    if not BreakLagToggle and BreakPartShurikenMap[targetPart] then return end
    if BreakVisualToggle then BreakAddHighlight(targetPart) end
    task.spawn(function()
        local canSpawn = localPlayer:WaitForChild("CanSpawnToy")
        local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local function CheckHome()
            if not service.Workspace.PlotItems.PlayersInPlots:FindFirstChild(localPlayer.Name) then return false end
            for _, v in pairs(service.Workspace.Plots:GetChildren()) do
                local sign = v:FindFirstChild("PlotSign")
                local owners = sign and sign:FindFirstChild("ThisPlotsOwners")
                if owners then
                    for _, b in pairs(owners:GetChildren()) do
                        if b.Value == localPlayer.Name then
                            local folder = service.Workspace.PlotItems:FindFirstChild(v.Name)
                            if folder then return true, folder end
                        end
                    end
                end
            end
            return false
        end
        local boolik, house = CheckHome()
        local inv = service.Workspace:FindFirstChild(localPlayer.Name.."SpawnedInToys")
        local container = (boolik and house) or inv
        local preExisting = {}
        if container then
            for _, child in pairs(container:GetChildren()) do
                if child.Name == "NinjaShuriken" then table.insert(preExisting, child) end
            end
        end
        if canSpawn.Value and BreakSpawnRemote then
            pcall(function()
                BreakSpawnRemote:InvokeServer("NinjaShuriken", hrp.CFrame * CFrame.new(0,2,8), Vector3.new(0,0,0))
            end)
            local newSh = nil
            if container then
                local searchStart = tick()
                while tick()-searchStart < 2 do
                    for _, child in pairs(container:GetChildren()) do
                        if child.Name == "NinjaShuriken" and not table.find(preExisting, child) then
                            newSh = child; break
                        end
                    end
                    if newSh then
                        local sp2 = newSh:FindFirstChild("SoundPart") or newSh:WaitForChild("SoundPart",0.1)
                        if sp2 then pcall(function() BreakSetNetOwner:FireServer(sp2, sp2.CFrame) end) end
                        break
                    end
                    task.wait()
                end
            end
            if newSh and newSh:FindFirstChild("StickyPart") then
                table.insert(shurikenTbl, newSh)
                if not BreakLagToggle then BreakPartShurikenMap[targetPart] = newSh end
                pcall(function()
                    BreakStickyEvent:FireServer(newSh.StickyPart, targetPart, CFrame.new(0,-1000000000,0))
                end)
            end
        end
    end)
