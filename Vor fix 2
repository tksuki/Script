end

local function BreakGetTargetBody(model)
    if not model then return nil end
    if model:FindFirstChild("Body") then return model.Body end
    if model:IsA("BasePart") then return model end
    return model:FindFirstChildWhichIsA("BasePart", true)
end

local function BreakSpawnToy(name)
    local InPlot = localPlayer:FindFirstChild("InPlot")
    local InOwnedPlot = localPlayer:FindFirstChild("InOwnedPlot")
    local CanSpawnToy = localPlayer:FindFirstChild("CanSpawnToy")
    if InPlot and InPlot.Value and InOwnedPlot and not InOwnedPlot.Value then
        InPlot:GetPropertyChangedSignal("Value"):Wait()
    end
    if CanSpawnToy and not CanSpawnToy.Value then
        CanSpawnToy:GetPropertyChangedSignal("Value"):Wait()
    end
    local hrp = BreakGetHRP()
    if not hrp then return nil end
    local SpawnCF = hrp.CFrame * CFrame.new(0, 14, 20)
    local Container = service.Workspace:FindFirstChild(localPlayer.Name .. "SpawnedInToys")
    if not Container then return nil end
    local spawnedObject = nil
    local conn
    conn = Container.ChildAdded:Connect(function(child)
        if child.Name == name then spawnedObject = child; conn:Disconnect() end
    end)
    task.spawn(function()
        pcall(function() BreakSpawnRemote:InvokeServer(name, SpawnCF, Vector3.new(0,0,0)) end)
    end)
    local start = tick()
    repeat task.wait(0.05) until spawnedObject or (tick()-start) > 3
    if conn then pcall(function() conn:Disconnect() end) end
    return spawnedObject
end

local function BreakStickToTarget(stickyPart, targetBody, offsetCF)
    if not stickyPart or not targetBody then return false end
    if not targetBody:IsA("BasePart") then
        local b = BreakGetTargetBody(targetBody)
        if b then targetBody = b else return false end
    end
    BreakSNO(stickyPart)
    local start = tick()
    repeat task.wait() until (stickyPart:FindFirstChild("PartOwner") and stickyPart.PartOwner.Value == localPlayer.Name) or (tick()-start) > 1
    if (tick()-start) > 1 then return false end
    task.wait(0.05)
    return pcall(function()
        BreakStickyEvent:FireServer(stickyPart, targetBody, offsetCF or CFrame.new(0,0,0))
    end)
end

local function BreakStickyOne(targetBody, offsetCF)
    if not targetBody then return end
    local toy = BreakSpawnToy(BreakSelectedToy)
    if toy then
        local sp = toy:FindFirstChild("StickyPart")
        if sp then
            local ok = BreakStickToTarget(sp, targetBody, offsetCF or CFrame.new(0,0,0))
            if not ok then task.wait(0.1); BreakStickToTarget(sp, targetBody, offsetCF or CFrame.new(0,0,0)) end
        end
    end
end

local function BreakProcessTargets(targetBodies, rootContainers, toggleKey)
    if #targetBodies == 0 then return end
    for i = 1, 12 do
        if not BreakToggleStates[toggleKey] then return end
        local toy = BreakSpawnToy(BreakSelectedToy)
        if toy then
            local sp = toy:FindFirstChild("StickyPart")
            if sp then
                for _, tb in ipairs(targetBodies) do
                    if tb then
                        local ok = BreakStickToTarget(sp, tb, CFrame.new(0,0,0))
                        if not ok then task.wait(0.1); BreakStickToTarget(sp, tb, CFrame.new(0,0,0)) end
                    end
                end
            end
        end
        task.wait(0.1)
    end
    for _, c in ipairs(rootContainers) do
        if c then
            for _, d in ipairs(c:GetDescendants()) do
