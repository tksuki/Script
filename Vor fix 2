local function BreakGetTarget()
    if BreakMouse and BreakMouse.Target then return BreakMouse.Target end
    local sz = Camera.ViewportSize
    local ray = Camera:ViewportPointToRay(sz.X/2, sz.Y/2)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local char = localPlayer.Character
    if char then params.FilterDescendantsInstances = {char} end
    local result = service.Workspace:Raycast(ray.Origin, ray.Direction*1000, params)
    return result and result.Instance
end

