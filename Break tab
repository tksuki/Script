BreakTab:CreateToggle({
    Name = "Stick to Ocean",
    CurrentValue = false,
    Flag = "OceanTgl",
    Callback = function(Value)
        ToggleStates.OceanTgl = Value
        if Value then
            task.spawn(function()
                local targetObject, oceanObject = getOceanTargetObject()
                if targetObject then
                    targetObject.Anchored = false
                    local anchorConn = targetObject:GetPropertyChangedSignal("Anchored"):Connect(function()
                        if targetObject.Anchored then pcall(function() targetObject.Anchored = false end) end
                    end)

                    local stickOffsets = {}
                    local mode = _G.OceanStickMode or "通常"
                    
                    if mode == "上空" then
                        table.insert(stickOffsets, CFrame.new(0, 2.14748365e+09, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1))
                    elseif mode == "横" then
                        table.insert(stickOffsets, CFrame.new(-1.073741825e+09, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1))
                        table.insert(stickOffsets, CFrame.new(0, -1.073741825e+09, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1))
                    elseif mode == "横真反対" then
                        table.insert(stickOffsets, CFrame.new(1.073741825e+09, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1))
                        table.insert(stickOffsets, CFrame.new(0, 1.073741825e+09, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1))
                    else
                        table.insert(stickOffsets, CFrame.new(0, -2.14748365e+09, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1))
                    end

                    for i = 1, 12 do
                        if not IsToggleActive("OceanTgl") then
                            if anchorConn then anchorConn:Disconnect() end
                            return
                        end
                        
                        local toy = SpawnToy(SelectedToy)
                        if toy then
                            local sp = toy:FindFirstChild("StickyPart")
                            if sp then
                                local bp = Instance.new("BodyPosition")
                                bp.Position = Vector3.new(math.random(-100, 100), 1e3, math.random(-100, 100))
                                bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                                bp.Parent = sp
                                task.wait(0.1)
                                
                                for _, stickOffset in ipairs(stickOffsets) do
                                    local success = StickPartToTarget(sp, targetObject, stickOffset)
                                    if not success then
                                        task.wait(0.1)
                                        StickPartToTarget(sp, targetObject, stickOffset)
                                    end
                                end
                            end
                        end
                        task.wait(0.15)
                    end

                    task.wait(0.5)
                    if oceanObject then pcall(function() oceanObject.Collision = false end) end
                    if anchorConn then anchorConn:Disconnect() end
                    if IsToggleActive("OceanTgl") then StickSingleToyToTarget(targetObject, stickOffsets[1]) end
                end
                ToggleStates.OceanTgl = false
                Rayfield.Flags["OceanTgl"]:Set(false)
            end)
        end
    end
})

