-- =========================================
-- 補助関数
-- =========================================
local function Char()
    local Character = LocalPlayer.Character
    if not Character then return end
    return Character, Character:FindFirstChild("HumanoidRootPart"), Character:FindFirstChild("Humanoid")
end

local function getHRP()
    local _, hrp = Char()
    return hrp or LocalPlayer.CharacterAdded:Wait():WaitForChild("HumanoidRootPart")
end

local function getTargetBody(model)
    if not model then return nil end
    if model:FindFirstChild("Body") then return model.Body end
    if model:IsA("BasePart") then return model end
    return model:FindFirstChildWhichIsA("BasePart", true)
end

local function sno(part)
    if part then
        SetNetworkOwner:FireServer(part, part.CFrame)
    end
end

-- =========================================
-- 追加機能用の関数（ハイライト＆地面破壊）
-- =========================================
local function addHighlight(targetPart)
    if not targetPart or not targetPart:IsA("BasePart") then return end
    if highlightMap[targetPart] then return end
    
    local highlight = Instance.new("Highlight")
    highlight.Name = "TargetHighlight"
    highlight.FillColor = Color3.new(0, 0, 1)
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = Color3.new(0, 0, 1)
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = targetPart
    
    highlightMap[targetPart] = highlight
end

local function removeHighlight(targetPart)
    if targetPart and highlightMap[targetPart] then
        highlightMap[targetPart]:Destroy()
        highlightMap[targetPart] = nil
    end
end

local function clearAllHighlights()
    for part, highlight in pairs(highlightMap) do
        if highlight and highlight.Parent then
            highlight:Destroy()
        end
    end
    highlightMap = {}
end

local function cleanupGroundShurikens()
    if DestroyToyRemote then
        for _, shuriken in pairs(groundSpawnedShurikens) do
            if shuriken and shuriken.Parent then
                pcall(function() DestroyToyRemote:FireServer(shuriken) end)
            end
        end
    end
    groundSpawnedShurikens = {}
    partShurikenMap = {}
    clearAllHighlights()
end

local function spawnAndBreakPart(targetPart, shurikenTable)
    if not targetPart or targetPart:IsA("Terrain") then return end

    if not LagToggleEnabled then
        if partShurikenMap[targetPart] then return end
    end

    if VisualizeToggleEnabled then
        addHighlight(targetPart)
    end

    task.spawn(function()
        local plr = game.Players.LocalPlayer
        local canSpawn = plr:WaitForChild("CanSpawnToy")
        local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local function CheckForHome()
            if not workspace.PlotItems.PlayersInPlots:FindFirstChild(plr.Name) then return false end
            for _, v in pairs(workspace.Plots:GetChildren()) do
                local sign = v:FindFirstChild("PlotSign")
                local owners = sign and sign:FindFirstChild("ThisPlotsOwners")
                if owners then
                    for _, b in pairs(owners:GetChildren()) do
                        if b.Value == plr.Name then
                            local folder = workspace.PlotItems:FindFirstChild(v.Name)
                            if folder then return true, folder end
                        end
                    end
                end
            end
            return false
        end

        local boolik, house = CheckForHome()
        local inv = workspace:FindFirstChild(plr.Name.."SpawnedInToys")
        local targetContainer = (boolik and house) or inv

        local preExisting = {}
        if targetContainer then
            for _, child in pairs(targetContainer:GetChildren()) do
                if child.Name == "NinjaShuriken" then
                    table.insert(preExisting, child)
                end
            end
        end

        if canSpawn.Value and SpawnToyRemoteFunction then
            pcall(function()
                SpawnToyRemoteFunction:InvokeServer("NinjaShuriken", hrp.CFrame * CFrame.new(0, 2, 8), Vector3.new(0,0,0))
            end)

            local newShuriken = nil
            if targetContainer then
                local searchStart = tick()
                while tick() - searchStart < 2 do
                    for _, child in pairs(targetContainer:GetChildren()) do
                        if child.Name == "NinjaShuriken" and not table.find(preExisting, child) then
                            newShuriken = child
                            break
                        end
                    end
                    if newShuriken then 
                        if SetNetworkOwner then
                            local soundPart = newShuriken:FindFirstChild("SoundPart") or newShuriken:WaitForChild("SoundPart", 0.1)
                            if soundPart then
                                pcall(function() SetNetworkOwner:FireServer(soundPart, soundPart.CFrame) end)
                            end
                        end
                        break 
                    end
                    task.wait()
                end
            end

            if newShuriken and newShuriken:FindFirstChild("StickyPart") then
                table.insert(shurikenTable, newShuriken)
                
                if not LagToggleEnabled then
                    partShurikenMap[targetPart] = newShuriken
                end
                
                pcall(function()
                    StickyEvent:FireServer(
                        newShuriken.StickyPart,
                        targetPart,
                        CFrame.new(0, -1000000000, 0)
                    )
                end)
            end
        end
    end)
end

-- =========================================
-- 既存機能の関数
-- =========================================
local function SpawnToy(ToyName)
    local InPlot = LocalPlayer:FindFirstChild("InPlot")
    local InOwnedPlot = LocalPlayer:FindFirstChild("InOwnedPlot")
    local CanSpawnToy = LocalPlayer:FindFirstChild("CanSpawnToy")

    if InPlot and InPlot.Value and InOwnedPlot and not InOwnedPlot.Value then
        InPlot:GetPropertyChangedSignal("Value"):Wait()
    end
    if CanSpawnToy and not CanSpawnToy.Value then
        CanSpawnToy:GetPropertyChangedSignal("Value"):Wait()
    end

    local hrp = getHRP()
    if not hrp then return nil end
    
    local SpawnCF = hrp.CFrame * CFrame.new(0, 14, 20)
    local Container = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")

    if not Container then return nil end

    local spawnedObject = nil
    local conn
    conn = Container.ChildAdded:Connect(function(child)
        if child.Name == ToyName then
            spawnedObject = child
            conn:Disconnect()
        end
    end)

    task.spawn(function()
        pcall(function()
            SpawnToyRemoteFunction:InvokeServer(ToyName, SpawnCF, Vector3.new(0, 0, 0))
        end)
    end)

    local start = tick()
    repeat task.wait(0.05) until spawnedObject or (tick() - start) > 3

    if conn then pcall(function() conn:Disconnect() end) end
    return spawnedObject
end

local function StickPartToTarget(stickyPart, targetBody, offsetCFrame)
    if not stickyPart or not targetBody then return false end
    
    if not targetBody:IsA("BasePart") then
        local body = getTargetBody(targetBody)
        if body then
            targetBody = body
        else
            return false
        end
    end
    
    sno(stickyPart)
    
    local Start = tick()
    repeat task.wait() until (stickyPart:FindFirstChild("PartOwner") and stickyPart.PartOwner.Value == LocalPlayer.Name) or (tick() - Start) > 1
    
    if (tick() - Start) > 1 then return false end
    
    task.wait(0.05)
    
    local success = pcall(function()
        StickyEvent:FireServer(stickyPart, targetBody, offsetCFrame or CFrame.new(0, 0, 0))
    end)
    
    return success
end

local function StickSingleToyToTarget(targetBody, offsetCF)
    if not targetBody then return end
    local toy = SpawnToy(SelectedToy)
    if toy then
        local stickyPart = toy:FindFirstChild("StickyPart")
        if stickyPart then
            local targetCFrame = offsetCF or CFrame.new(0, 0, 0)
            local success = StickPartToTarget(stickyPart, targetBody, targetCFrame)
            if not success then
                task.wait(0.1)
                StickPartToTarget(stickyPart, targetBody, targetCFrame)
            end
        end
    end
end

local function IsToggleActive(toggleName)
    return ToggleStates[toggleName] == true
end

local function processNormalTargets(targetBodies, rootContainers, toggleName)
    if #targetBodies == 0 then return end

    for i = 1, 12 do
        if not IsToggleActive(toggleName) then return end
        
        local toy = SpawnToy(SelectedToy)
        if toy then
            local stickyPart = toy:FindFirstChild("StickyPart")
            if stickyPart then
                for _, targetBody in ipairs(targetBodies) do
                    if targetBody then
                        local success = StickPartToTarget(stickyPart, targetBody, CFrame.new(0, 0, 0))
                        if not success then
                            task.wait(0.1)
                            StickPartToTarget(stickyPart, targetBody, CFrame.new(0, 0, 0))
                        end
                    end
                end
            end
        end
        task.wait(0.1)
    end
    
    for _, container in ipairs(rootContainers) do
        if container then
            for _, desc in ipairs(container:GetDescendants()) do
                if desc.Name == "FollowThisPart" then
                    if desc:FindFirstChild("AlignOrientation") then desc.AlignOrientation.Enabled = false end
                    if desc:FindFirstChild("AlignPosition") then desc.AlignPosition.Enabled = false end
                end
            end
        end
    end
    
    if IsToggleActive(toggleName) then
        task.wait(0.5)
        StickSingleToyToTarget(targetBodies[1])
    end
end

local function getOceanTargetObject()
    local map = Workspace:FindFirstChild("Map")
    if not map then return nil end
    local alwaysHere = map:FindFirstChild("AlwaysHereTweenedObjects")
    if not alwaysHere then return nil end
    local ocean = alwaysHere:FindFirstChild("Ocean")
    if not ocean then return nil end
    local object = ocean:FindFirstChild("Object")
    if not object then return nil end
    local objectModel = object:FindFirstChild("ObjectModel")
    if not objectModel then return nil end

    local children = objectModel:GetChildren()
    local index = 17
    if index <= #children then
        local target = children[index]
        if target and target:IsA("BasePart") then
            return target, ocean
        end
    end
    return nil
end

local function GetTarget()
    if Mouse and Mouse.Target then return Mouse.Target end

    local size = Camera.ViewportSize
    local ray = Camera:ViewportPointToRay(size.X / 2, size.Y / 2)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude

    local character = Char()
    if character then
        params.FilterDescendantsInstances = {character}
    end

    local result = Workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
    return result and result.Instance
end

local function BreakPart(Part)
    if not Part or not Part:IsA('BasePart') or not DestroyToyRemote then return end

    local toy = SpawnToy(SelectedToy)
    local StickyPart = toy and toy:WaitForChild("StickyPart", 1)
    
    if not StickyPart then return end
    
    local success = StickPartToTarget(StickyPart, Part, CFrame.new(1e15, 1e15, 1e15))
    if not success then
        task.wait(0.1)
        StickPartToTarget(StickyPart, Part, CFrame.new(1e15, 1e15, 1e15))
    end
end

local function StickToUFO(ufoName)
    local alwaysHere = Workspace.Map.AlwaysHereTweenedObjects
    if not alwaysHere then return end
    
    local ufo = alwaysHere:FindFirstChild(ufoName)
    if not ufo or not ufo:FindFirstChild("Object") or not ufo.Object:FindFirstChild("ObjectModel") then return end
    
    local body = getTargetBody(ufo.Object.ObjectModel)
    if body then
        processNormalTargets({body}, {ufo}, "UfoTgl")
    end
end

local function StickToRock()
    local alwaysHere = Workspace.Map.AlwaysHereTweenedObjects
    
    local smlDebris = alwaysHere:FindFirstChild(SelectedSmlDebris)
    if smlDebris then
        local rock = smlDebris:FindFirstChild("Rock", true)
        if rock then
            local body = getTargetBody(rock)
            if body then 
                processNormalTargets({body}, {smlDebris}, "RockTgl")
                if not IsToggleActive("RockTgl") then return end
            end
        end
    end

    task.wait(0.5)
    if not IsToggleActive("RockTgl") then return end

    local lrgDebris = alwaysHere:FindFirstChild(SelectedLrgDebris)
    if lrgDebris then
        local objModel = lrgDebris:FindFirstChild("ObjectModel", true)
        if objModel then
            local rock = objModel:FindFirstChild("Rock")
            if rock then
                local body = getTargetBody(rock)
                if body then 
                    processNormalTargets({body}, {lrgDebris}, "RockTgl")
                end
            end
        end
    end
end

local function StickToCaveCart()
    local alwaysHere = Workspace.Map.AlwaysHereTweenedObjects
    if not alwaysHere then return end
    local caveCart = alwaysHere:FindFirstChild("CaveCart")
    if not caveCart then return end
    local object = caveCart:FindFirstChild("Object")
    if not object then return end
    local objectModel = object:FindFirstChild("ObjectModel")
    if not objectModel then return end
    
    local topPart = nil
    for _, child in ipairs(objectModel:GetChildren()) do
        if child:IsA("BasePart") then
            topPart = child
            break
        end
    end
    if topPart then
        processNormalTargets({topPart}, {caveCart}, "CaveCartTgl")
    end
end

local function StickToTrain()
    local alwaysHere = Workspace.Map.AlwaysHereTweenedObjects
    if not alwaysHere then return end
    local train = alwaysHere:FindFirstChild("Train")
    if not train then return end
    local object = train:FindFirstChild("Object")
    if not object then return end
    local objectModel = object:FindFirstChild("ObjectModel")
    if not objectModel then return end
    
    local topPart = nil
    for _, child in ipairs(objectModel:GetChildren()) do
        if child:IsA("BasePart") then
            topPart = child
            break
        end
    end
    if topPart then
        processNormalTargets({topPart}, {train}, "TrainTgl")
    end
end

