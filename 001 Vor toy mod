local function setCollision(model, enabled)
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") then
            d.CanCollide = enabled
            d.CanTouch = enabled
        end
    end
end

local function isMe(obj)
    local char = LocalPlayer.Character
    if obj == char or obj == LocalPlayer then return true end
    if obj.Name == LocalPlayer.Name then return true end
    if obj:IsA("ObjectValue") and (obj.Value == char or obj.Value == LocalPlayer) then
        return true
    end
    return false
end

local function getMyPlotName()
    local plotItems = workspace:FindFirstChild("PlotItems")
    local inPlots = plotItems and plotItems:FindFirstChild("PlayersInPlots")
    if not inPlots then return nil end

    for _, name in ipairs(PLOT_NAMES) do
        local plotFolder = inPlots:FindFirstChild(name)
        if plotFolder then
            for _, child in ipairs(plotFolder:GetChildren()) do
                if isMe(child) then return name end
            end
        end
    end
    return nil
end

local function getMySpawnedFolder()
    return workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
end

local SNO_COUNT = 5
local SNO_INTERVAL = 0.01

local HAND_RECLAIM_COUNT = 10

local function sendSNO5(part)
    if not part then return end
    task.spawn(function()
        for _ = 1, SNO_COUNT do
            if not part.Parent then break end
            pcall(function()
                ReplicatedStorage.GrabEvents.SetNetworkOwner:FireServer(part, part.CFrame)
            end)
            task.wait(SNO_INTERVAL)
        end
    end)
end

local cachedPlot, cachedPlotTime = nil, -1
local function getMyPlotNameCached()
    local now = os.clock()
    if now - cachedPlotTime > 0.1 then
        cachedPlot = getMyPlotName()
        cachedPlotTime = now
    end
    return cachedPlot
end

local function getToyFolder()
    local plotName = getMyPlotNameCached()
    if plotName then
        local plotItems = workspace:FindFirstChild("PlotItems")
        return plotItems and plotItems:FindFirstChild(plotName)
    end
    return getMySpawnedFolder()
end

local function countToys(toyName)
    local folder = getToyFolder()
    if not folder then return 0 end

    local n = 0
    for _, item in ipairs(folder:GetChildren()) do
        if item.Name == toyName then n = n + 1 end
    end
    return n
end

local function countIn(folder, toyName)
    if not folder then return 0 end
    local n = 0
    for _, item in ipairs(folder:GetChildren()) do
        if item.Name == toyName then n = n + 1 end
    end
    return n
end

local function getCandidateFolders()
    local list = {}
    local plotItems = workspace:FindFirstChild("PlotItems")
    if plotItems then
        for _, name in ipairs(PLOT_NAMES) do
            local f = plotItems:FindFirstChild(name)
            if f then table.insert(list, f) end
        end
    end
    local mine = getMySpawnedFolder()
    if mine then table.insert(list, mine) end
    return list
end

local function runSpawnLoop(toyName, isActive, getTarget, spawnFn, registerFn)
    local SEND_INTERVAL = 0.05
    local CHECK_INTERVAL = 0.01

    local lockedFolder = nil
    local snapshot = {}
    for _, f in ipairs(getCandidateFolders()) do
        snapshot[f] = countIn(f, toyName)
    end

    local function currentCount()
        if lockedFolder then
            return countIn(lockedFolder, toyName)
        end
        if getMyPlotNameCached() then
            return countToys(toyName)
        end
        return 0
    end

    local base = currentCount()
    local sentOK = 0
    local running = 0
    local lastDone = os.clock()
    local lastCount = base
    local lastProgress = os.clock()
    local nextSend = os.clock()
    local reason = "不明"

    print(("[%s] 開始 現在 %d / 目標 %d (予想: %s)"):format(
        toyName, base, getTarget(),
        (getToyFolder() and getToyFolder():GetFullName()) or "なし"))

    while true do
        if not isActive() then reason = "トグルがオフになった" break end

        local now = os.clock()

        if not lockedFolder then
            for _, f in ipairs(getCandidateFolders()) do
                local b = snapshot[f]
                if b == nil then
                    b = 0
                    snapshot[f] = 0
                end
                if countIn(f, toyName) > b then
                    lockedFolder = f
                    base = b
                    lastCount = b
                    print(("[%s] 数えるフォルダを固定: %s"):format(toyName, f:GetFullName()))
                    break
                end
            end
        end

        local cur = currentCount()
        local target = getTarget()

        if cur >= target then reason = "目標数に到達" break end

        if cur ~= lastCount then
            lastProgress = now
            if cur > lastCount then
                print(("[%s] 現在 %d / 目標 %d"):format(toyName, cur, target))
            end
            lastCount = cur
        end

        if now - lastProgress > 30 then
            reason = "30秒間数が増えなかったため停止"
            break
        end

        local eff = math.max(cur, base + sentOK)

        if eff >= target and running == 0 and now - lastDone > 0.5 then
            sentOK = math.max(0, cur - base)
            lastDone = now
            eff = math.max(cur, base + sentOK)
        end

        local canSend = lockedFolder or getMyPlotNameCached() or sentOK == 0

        if now >= nextSend and canSend and eff < target then
            sentOK = sentOK + 1
            running = running + 1
            task.spawn(function()
                local ok, inst = pcall(spawnFn)
                if ok and typeof(inst) == "Instance" then
                    if not lockedFolder then
                        local parent = inst.Parent
                        if parent and snapshot[parent] ~= nil then
                            lockedFolder = parent
                            base = snapshot[parent]
                            lastCount = base
                            print(("[%s] 数えるフォルダを固定(戻り値から): %s"):format(toyName, parent:GetFullName()))
                        end
                    end
                else
                    sentOK = sentOK - 1
                end
                running = running - 1
                lastDone = os.clock()
            end)
            nextSend = now + SEND_INTERVAL
        end

        task.wait(CHECK_INTERVAL)
    end

    print(("[%s] 終了: %s (現在 %d / 目標 %d)"):format(toyName, reason, currentCount(), getTarget()))
end

local function findNewSparklers()
    local found = {}
    local plotItems = workspace:FindFirstChild("PlotItems")

    if plotItems then
        local myPlot = getMyPlotName()
        local targets = myPlot and { myPlot } or PLOT_NAMES

        for _, name in ipairs(targets) do
            local plot = plotItems:FindFirstChild(name)
            if plot then
                for _, item in ipairs(plot:GetChildren()) do
                    if item.Name == "FireworkSparkler" and not handled[item] then
                        table.insert(found, item)
                    end
                end
            end
        end
    end

    if not getMyPlotName() then
        local folder = getMySpawnedFolder()
        if folder then
            for _, item in ipairs(folder:GetChildren()) do
                if item.Name == "FireworkSparkler" and not handled[item] then
                    table.insert(found, item)
                end
            end
        end
    end

    return found
end

local function registerSparkler(sparkler)
    if handled[sparkler] then return end
    handled[sparkler] = true
    table.insert(spawned, sparkler)

    local stick = sparkler:FindFirstChild("Stick")
    if not stick then return end

    sendSNO5(stick)
end

local function pruneSpawned()
    for i = #spawned, 1, -1 do
        local s = spawned[i]
        if not s or not s.Parent then
            table.remove(spawned, i)
        end
    end
end

local playerMap = {}

local function getTargetCharacter()
    if Toggles.GiveToPlayer and Toggles.GiveToPlayer.Value and Options.SelectedPlayer then
        local key = Options.SelectedPlayer.Value
        local plr = key and playerMap[key]
        if plr and plr.Parent and plr.Character then
            return plr.Character
        end
    end
    return LocalPlayer.Character
end

local function spawnOne()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    local pos = (root.CFrame * CFrame.new(0, 0, -5)).Position
    local ok, result = pcall(function()
        return ReplicatedStorage.MenuToys.SpawnToyRemoteFunction:InvokeServer(
            "FireworkSparkler",
            CFrame.new(pos) * baseRotation,
            Vector3.new(0, 132, 0)
        )
    end)

    task.wait(0.01)

    if ok and typeof(result) == "Instance" then
        registerSparkler(result)
    else
        for _, s in ipairs(findNewSparklers()) do
            registerSparkler(s)
        end
    end
    if ok and typeof(result) == "Instance" then return result end
    return false
end

local function ensureSpawned()
    pruneSpawned()
    if #spawned > 0 then return end

    for _, s in ipairs(findNewSparklers()) do
        registerSparkler(s)
    end

    if #spawned == 0 then
        runSpawnLoop("FireworkSparkler",
            function() return true end,
            function() return Options.SparklerCount and Options.SparklerCount.Value or 10 end,
            spawnOne, registerSparkler)
    end
end

local function removeMovers(stick)
    local bp = stick:FindFirstChild("OrbitBP")
    local bg = stick:FindFirstChild("OrbitBG")
    if bp then bp:Destroy() end
    if bg then bg:Destroy() end
end

local function makeStickCFrame(pos, tangent)
    local up = Vector3.new(0, 1, 0)
    return CFrame.fromMatrix(pos, tangent, up, tangent:Cross(up))
end

local function applyMotion(stick, method, pos, cf)
    if method == "BP/BG" then
        local bp = stick:FindFirstChild("OrbitBP")
        if not bp then
            bp = Instance.new("BodyPosition")
            bp.Name = "OrbitBP"
            bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bp.P = 100000
            bp.D = 1000
            bp.Parent = stick
        end
        local bg = stick:FindFirstChild("OrbitBG")
        if not bg then
            bg = Instance.new("BodyGyro")
            bg.Name = "OrbitBG"
            bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            bg.P = 100000
            bg.D = 1000
            bg.Parent = stick
        end
        bp.Position = pos
        bg.CFrame = cf
    else
        removeMovers(stick)
        stick.CFrame = cf
        stick.AssemblyLinearVelocity = Vector3.zero
        stick.AssemblyAngularVelocity = Vector3.zero
    end
end

local function cleanupAll()
    local anyRunning = orbitConn ~= nil or liveConn ~= nil or tpCircleConn ~= nil
    for _, s in ipairs(spawned) do
        local stick = s and s:FindFirstChild("Stick")
        if stick then removeMovers(stick) end
        if not anyRunning and s and s.Parent then
            setCollision(s, true)
        end
    end
end

function startOrbit()
    if orbitConn then return end
    local lastTime = os.clock()

    task.spawn(function()
        ensureSpawned()
        if not Toggles.SuperSparklerOrbit.Value then return end

        orbitConn = RunService.Heartbeat:Connect(safe(function()
            local now = os.clock()
            local dt = now - lastTime
            lastTime = now

            local char = getTargetCharacter()
            local head = char and char:FindFirstChild("Head")
            if not head then return end

            pruneSpawned()
            local n = #spawned
            if n == 0 then return end

            local method = Options.OrbitMethod.Value
            local height = Options.OrbitHeight.Value
            local radius = Options.OrbitRadius.Value

            if Toggles.UpgradeOrbit.Value then
                local duration = math.max(Options.UpgradeDuration.Value, 0.1)
                local maxRad = Options.UpgradeMaxRadius.Value
                local minRad = 5
                local t = now % (duration * 2)
                if t > duration then t = duration * 2 - t end
                radius = minRad + (maxRad - minRad) * (t / duration)
            end

            angleOffset = angleOffset + dt * Options.OrbitSpeed.Value

            local stereo = Toggles.StereoOrbit.Value
            local stereoRotCF = CFrame.new()
            if stereo then
                stereoAngleOffset = stereoAngleOffset + dt * Options.StereoRotationSpeed.Value
                stereoRotCF = CFrame.Angles(0, stereoAngleOffset, 0)
            end

            local center = head.Position + Vector3.new(0, height, 0)

            for i, s in ipairs(spawned) do
                local stick = s:FindFirstChild("Stick")
                if stick then
                    setCollision(s, false)

                    local angle = angleOffset + (i - 1) * (math.pi * 2 / n)
                    local pos, tangent

                    if stereo then
                        local ringType = i % 3
                        local basePos
                        if ringType == 1 then
                            basePos = Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
                            tangent = Vector3.new(-math.sin(angle), 0, math.cos(angle))
                        elseif ringType == 2 then
                            basePos = Vector3.new(math.cos(angle) * radius, math.sin(angle) * radius, 0)
                            tangent = Vector3.new(-math.sin(angle), math.cos(angle), 0)
                        else
                            basePos = Vector3.new(0, math.sin(angle) * radius, math.cos(angle) * radius)
                            tangent = Vector3.new(0, math.cos(angle), -math.sin(angle))
                        end
                        pos = center + (stereoRotCF * basePos)
                        tangent = stereoRotCF * tangent
                    else
                        pos = center + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
                        tangent = Vector3.new(-math.sin(angle), 0, math.cos(angle))
                    end

                    applyMotion(stick, method, pos, makeStickCFrame(pos, tangent))
                end
            end
        end))
    end)
end

function stopOrbit()
    if orbitConn then
        orbitConn:Disconnect()
        orbitConn = nil
    end
    cleanupAll()
end

function startLiveOrbit()
    if liveConn then return end
    local lastTime = os.clock()
    lastSwitchTime = lastTime

    task.spawn(function()
        ensureSpawned()
        if not Toggles.TpLive.Value then return end

        liveConn = RunService.Heartbeat:Connect(safe(function()
            local now = os.clock()
            local dt = now - lastTime
            lastTime = now

            local char = getTargetCharacter()
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if not root then return end

            pruneSpawned()
            local n = #spawned
            if n == 0 then return end

            local method = Options.OrbitMethod.Value
            local topRadius = Options.LiveTopRadius.Value
            local bottomRadius = Options.LiveBottomRadius.Value
            local anchor = root.Position
            local topY = anchor.Y + Options.SparklerHeight.Value
            local bottomY = anchor.Y - 8
            local speed = Options.OrbitSpeed.Value
            local interval = math.max(0.02, 0.3 / speed)

            if now - lastSwitchTime >= interval then
                lastSwitchTime = now
                liveState = not liveState
                if liveState then
                    liveAngle = liveAngle + math.rad(Options.TpCircleShift.Value)
                end
            end

            local currentY = liveState and topY or bottomY
            local radius = liveState and topRadius or bottomRadius

            for i, s in ipairs(spawned) do
                local stick = s:FindFirstChild("Stick")
                if stick then
                    setCollision(s, false)

                    local angle = liveAngle + (i - 1) * (math.pi * 2 / n)
                    local pos = Vector3.new(
                        anchor.X + math.cos(angle) * radius,
                        currentY,
                        anchor.Z + math.sin(angle) * radius
                    )
                    local tangent = Vector3.new(-math.sin(angle), 0, math.cos(angle))
                    applyMotion(stick, method, pos, makeStickCFrame(pos, tangent))
                end
            end
        end))
    end)
end

function stopLiveOrbit()
    if liveConn then
        liveConn:Disconnect()
        liveConn = nil
    end
    cleanupAll()
end

function startTpCircle()
    if tpCircleConn then return end
    tpCircleLastSwitch = os.clock()

    task.spawn(function()
        ensureSpawned()
        if not Toggles.TpCircle.Value then return end

        tpCircleConn = RunService.Heartbeat:Connect(safe(function()
            local now = os.clock()

            local char = getTargetCharacter()
            local head = char and char:FindFirstChild("Head")
            if not head then return end

            pruneSpawned()
            local n = #spawned
            if n == 0 then return end

            local method = Options.OrbitMethod.Value
            local height = Options.OrbitHeight.Value
            local speed = Options.OrbitSpeed.Value
            local inner = Options.TpCircleInner.Value
            local outer = math.max(Options.TpCircleOuter.Value, inner)
            local shift = math.rad(Options.TpCircleShift.Value)
            local interval = math.max(0.02, 0.3 / speed)

            if now - tpCircleLastSwitch >= interval then
                tpCircleLastSwitch = now
                tpCircleOuter = not tpCircleOuter
                if tpCircleOuter then
                    tpCircleAngle = tpCircleAngle + shift
                end
            end

            local radius = tpCircleOuter and outer or inner
            local center = head.Position + Vector3.new(0, height, 0)

            for i, s in ipairs(spawned) do
                local stick = s:FindFirstChild("Stick")
                if stick then
                    setCollision(s, false)

                    local angle = tpCircleAngle + (i - 1) * (math.pi * 2 / n)
                    local pos = center + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
                    local tangent = Vector3.new(-math.sin(angle), 0, math.cos(angle))
                    applyMotion(stick, method, pos, makeStickCFrame(pos, tangent))
                end
            end
        end))
    end)
end

function stopTpCircle()
    if tpCircleConn then
        tpCircleConn:Disconnect()
        tpCircleConn = nil
    end
    cleanupAll()
end

