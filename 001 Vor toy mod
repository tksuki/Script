        task.spawn(function()
            local ladderNeed = 14

            handPre = snapshotHand()
            handInPlot = nil

            local isActive = function() return Toggles.HandSpawn.Value end

            local palBase = countToys("PalletLightBrown")
            runSpawnLoop("PalletLightBrown", isActive,
