local FINGER_CM = {
    { 3.3, 1.9, 1.7 },
    { 4.1, 2.5, 1.9 },
    { 4.4, 2.6, 1.9 },
    { 3.9, 2.3, 1.8 },
}
local THUMB_CM = { 5.0, 2.8 }
local REAL_PALM_CM = 9.25

local function sendHandSNO(item)
    task.spawn(function()
        for _ = 1, SNO_COUNT do
            if not item.Parent then break end
            local sp = item:FindFirstChild("SoundPart", true)
            if sp then
                pcall(function()
                    ReplicatedStorage.GrabEvents.SetNetworkOwner:FireServer(sp, sp.CFrame)
                end)
            end
            task.wait(SNO_INTERVAL)
        end
    end)
end

local handSnoBusy = {}

local function resendHandSNO(item)
    if handSnoBusy[item] then return end
    handSnoBusy[item] = true
    task.spawn(function()
        for _ = 1, HAND_RECLAIM_COUNT do
            if not item.Parent then break end
            local sp = item:FindFirstChild("SoundPart", true)
            if sp then
                pcall(function()
                    ReplicatedStorage.GrabEvents.SetNetworkOwner:FireServer(sp, sp.CFrame)
                end)
            end
            task.wait(SNO_INTERVAL)
        end
        handSnoBusy[item] = nil
    end)
end

local function findMyHandItem(obj)
    local m = obj
    while m and m ~= workspace do
        if handHandled[m] then return m end
        m = m.Parent
    end
    return nil
end

local function startHandMonitor()
    if handGrabConn then return end
    local grabEvents = ReplicatedStorage:FindFirstChild("GrabEvents")
    local remote = grabEvents and grabEvents:FindFirstChild("CreateGrabLine")
    if not remote then
        warn("[手] CreateGrabLine が見つからないため監視できません")
        return
    end
    handGrabConn = remote.OnClientEvent:Connect(safe(function(plr, part)
        if typeof(plr) ~= "Instance" or plr == LocalPlayer then return end
        if typeof(part) ~= "Instance" then return end
        local item = findMyHandItem(part)
        if item then
            resendHandSNO(item)
        end
    end))
end

local function stopHandMonitor()
    if handGrabConn then
        handGrabConn:Disconnect()
        handGrabConn = nil
    end
end

local function snapshotHand()
    local pre = {}
    for _, f in ipairs(getCandidateFolders()) do
        for _, it in ipairs(f:GetChildren()) do
            if it.Name == "PalletLightBrown" or it.Name == "LadderLightBrown" then
                pre[it] = true
            end
        end
    end
    return pre
end

local function collectHand(toyName)
    local best = {}
    for _, f in ipairs(getCandidateFolders()) do
        local list = {}
        for _, it in ipairs(f:GetChildren()) do
            if it.Name == toyName and not handPre[it] then
                table.insert(list, it)
            end
        end
        if #list > #best then best = list end
    end
    for _, it in ipairs(best) do
        if not handHandled[it] then
            handHandled[it] = true
            sendHandSNO(it)
        end
    end
    return best
end

local function makeHandSpawn(toyName)
    return function()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return false end

        local inPlot
        if handInPlot ~= nil then
            inPlot = handInPlot
        else
            inPlot = getMyPlotNameCached() ~= nil
        end

        local y
        if toyName == "PalletLightBrown" then
            y = inPlot and -48.5 or -40
        else
            y = inPlot and -61 or -129
        end

        local pos = (root.CFrame * CFrame.new(0, 0, -5)).Position
        local ok, result = pcall(function()
            return ReplicatedStorage.MenuToys.SpawnToyRemoteFunction:InvokeServer(
                toyName, CFrame.new(pos), Vector3.new(0, y, 0))
        end)
        task.wait(0.01)

        if ok and typeof(result) == "Instance" then
            if result.Parent then
                handInPlot = table.find(PLOT_NAMES, result.Parent.Name) ~= nil
            end
            if not handHandled[result] then
                handHandled[result] = true
                sendHandSNO(result)
            end
            return result
        end
        return false
    end
end

local function measureItem(item)
    local pivot = item:GetPivot()
    local mn = Vector3.new(math.huge, math.huge, math.huge)
    local mx = -mn
    local function add(p)
        local s = p.Size / 2
        for _, sx in ipairs({ -1, 1 }) do
            for _, sy in ipairs({ -1, 1 }) do
                for _, sz in ipairs({ -1, 1 }) do
                    local c = pivot:PointToObjectSpace(
                        p.CFrame:PointToWorldSpace(Vector3.new(sx * s.X, sy * s.Y, sz * s.Z)))
                    mn = Vector3.new(math.min(mn.X, c.X), math.min(mn.Y, c.Y), math.min(mn.Z, c.Z))
                    mx = Vector3.new(math.max(mx.X, c.X), math.max(mx.Y, c.Y), math.max(mx.Z, c.Z))
                end
            end
        end
    end
    if item:IsA("BasePart") then add(item) end
    for _, d in ipairs(item:GetDescendants()) do
        if d:IsA("BasePart") then add(d) end
    end
    return mx - mn, (mx + mn) / 2
end

local function sortedSize(size)
    local t = { size.X, size.Y, size.Z }
    table.sort(t, function(a, b) return a > b end)
    return t[1], t[2], t[3]
end

local function makeM(size, targets)
    local axes = { { 1, size.X }, { 2, size.Y }, { 3, size.Z } }
    table.sort(axes, function(a, b) return a[2] > b[2] end)
    local cols = {}
    for rank, a in ipairs(axes) do cols[a[1]] = targets[rank] end
    if cols[1]:Dot(cols[2]:Cross(cols[3])) < 0 then cols[3] = -cols[3] end
    return CFrame.fromMatrix(Vector3.zero, cols[1], cols[2], cols[3])
end

local X_, Y_, Z_
pcall(function()
X_, Y_, Z_ = Vector3.xAxis, Vector3.yAxis, Vector3.zAxis
end)

local function buildHand(pallet, ladders)
    handItems, handRels, handParts = {}, {}, {}
    handCenters = {}
    handPose = nil

    local function place(item, cfCenter, M)
        local _, c = measureItem(item)
        table.insert(handItems, item)
        table.insert(handRels, cfCenter * M * CFrame.new(-c))
        handCenters[#handItems] = c

        local parts = {}
        if item:IsA("BasePart") then table.insert(parts, item) end
        for _, d in ipairs(item:GetDescendants()) do
            if d:IsA("BasePart") then table.insert(parts, d) end
        end
        table.insert(handParts, parts)
    end

    local palSize = measureItem(pallet)
    local px, pz, pt = sortedSize(palSize)
    local ladSize = measureItem(ladders[1])
    local L, w = sortedSize(ladSize)
    local fingerScale = (Options.HandFingerScale and Options.HandFingerScale.Value) or 1.8
    local s = ((px + pz) / 2) / REAL_PALM_CM * fingerScale
    s = math.max(s, L * 0.45 / 4.4)

    place(pallet, CFrame.new(), makeM(palSize, { X_, Z_, Y_ }))

    local fingerM = makeM(ladSize, { Z_, X_, Y_ })

    local angles = { 0.15, 0.2, 0.1 }

    local spacing = math.max(px / 4, w + 0.1)
        * ((Options.HandFingerSpacing and Options.HandFingerSpacing.Value) or 1.3)
    local thumbAng = { 0.1, 0.15 }
    local thumbBaseOut = 0.9
    local thumbX = math.max(px * 0.3, 1.5 * spacing + w * 0.6)

    local FAN = { -1, -0.5, 0.25, 0.8 }
    local BASE_FAN = { -1.1, -0.5, 0.1, 0.8 }
    local splayMax = 0.3 * ((Options.HandSplay and Options.HandSplay.Value) or 1)
    local spreadMax = 0.35 * ((Options.HandSpreadAmt and Options.HandSpreadAmt.Value) or 1)

    local fingerIdx = { {}, {}, {}, {} }
    local thumbIdx = {}

    local function pose(open, initial)
        local curlMul = 1 - 0.5 * open
        local li2 = 1

        local function put(cf, idxTable, key)
            if initial then
                place(ladders[li2], cf, fingerM)
                idxTable[key] = #handItems
            else
                local idx = idxTable[key]
                handRels[idx] = cf * fingerM * CFrame.new(-handCenters[idx])
            end
            li2 = li2 + 1
        end

        for f = 1, 4 do
            local F = CFrame.new((f - 2.5) * spacing, 0, pz / 2)
                * CFrame.Angles(0, BASE_FAN[f] * splayMax + FAN[f] * spreadMax * open, 0)
            for j = 1, 3 do
                local len = FINGER_CM[f][j] * s
                F = F * CFrame.Angles(angles[j] * curlMul, 0, 0)
                local off = (L >= len) and (len - L / 2) or (len / 2)
                put(F * CFrame.new(0, 0, off), fingerIdx[f], j)
                F = F * CFrame.new(0, 0, len)
            end
        end

        local T = CFrame.new(thumbX, -pt / 2, -pz * 0.35)
            * CFrame.Angles(0, thumbBaseOut + 0.35 * open * ((Options.HandSpreadAmt and Options.HandSpreadAmt.Value) or 1), 0)
        for j = 1, 2 do
            local len = THUMB_CM[j] * s
            T = T * CFrame.Angles(thumbAng[j] * curlMul, 0, 0)
            local off = (L >= len) and (len - L / 2) or (len / 2)
            put(T * CFrame.new(0, 0, off), thumbIdx, j)
            T = T * CFrame.new(0, 0, len)
        end
    end

    pose(0, true)
    handPose = function(open) pose(open, false) end
end

local function stopHand()
    if handConn then
        handConn:Disconnect()
        handConn = nil
    end
    if handRenderConn then
        handRenderConn:Disconnect()
        handRenderConn = nil
    end
    stopHandMonitor()
    for _, c in ipairs(handNoCol) do
        if c.Parent then c:Destroy() end
    end
    handNoCol = {}
    for _, it in ipairs(handItems) do
        if it.Parent then setCollision(it, true) end
    end
end

local handCur, handLastT, handLastPos
local handVel
pcall(function()
handVel = Vector3.zero
end)

local function updateHand()
    local now = os.clock()
    local dt = handLastT and (now - handLastT) or 0
    handLastT = now

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local look = root.CFrame.LookVector
    look = Vector3.new(look.X, 0, look.Z)
    if look.Magnitude < 0.01 then return end
    look = look.Unit
    local up = Vector3.yAxis
    local right = look:Cross(up)

    local pos = root.Position + Vector3.new(0, 20, 0) + right * 15

    local targetCF = CFrame.fromMatrix(pos, -right, -look, up)

    if not handCur then
        handCur = targetCF
    else
        local k = (Options.HandFollow and Options.HandFollow.Value) or 4
        local alpha = 1 - math.exp(-k * dt)
        handCur = handCur:Lerp(targetCF, alpha)
    end

    local amp = (Options.HandBobAmp and Options.HandBobAmp.Value) or 1
    local sp = (Options.HandBobSpeed and Options.HandBobSpeed.Value) or 1.5
    local bob = amp * (math.sin(now * sp) + 0.3 * math.sin(now * sp * 2.3 + 1.7))
    local finalCF = handCur + Vector3.new(0, bob, 0)

    if handPose then
        local fsp = (Options.HandFingerSpeed and Options.HandFingerSpeed.Value) or 1
        local open = 0.5 + 0.5 * math.sin(now * fsp)
        handPose(open)
    end

    local fp = finalCF.Position
    if handLastPos and dt > 0.001 then
        handVel = (fp - handLastPos) / dt
        if handVel.Magnitude > 300 then handVel = handVel.Unit * 300 end
    end
    if dt > 0.001 or not handLastPos then handLastPos = fp end

    for i, it in ipairs(handItems) do
        if it.Parent then
            it:PivotTo(finalCF * handRels[i])
            for _, p in ipairs(handParts[i]) do
                p.AssemblyLinearVelocity = handVel
                p.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end
end

local function applyHandCollision()
    local on = Toggles.HandCollision and Toggles.HandCollision.Value
    on = on and true or false
    for _, parts in ipairs(handParts) do
        for _, p in ipairs(parts) do
            if p.Parent then
                p.CanCollide = on
                p.CanTouch = on
            end
        end
    end
end

local function buildHandNoCollide()
    for _, c in ipairs(handNoCol) do
        if c.Parent then c:Destroy() end
    end
    handNoCol = {}
    for i = 1, #handParts do
        for k = i + 1, #handParts do
            for _, a in ipairs(handParts[i]) do
                for _, b in ipairs(handParts[k]) do
                    local c = Instance.new("NoCollisionConstraint")
                    c.Part0 = a
                    c.Part1 = b
                    c.Parent = a
                    table.insert(handNoCol, c)
                end
            end
        end
    end
end

local function startHandFollow()
    handCur, handLastT, handLastPos = nil, nil, nil
    handVel = Vector3.zero
    buildHandNoCollide()
    applyHandCollision()
    handRenderConn = RunService.RenderStepped:Connect(safe(updateHand))
    handConn = RunService.Heartbeat:Connect(safe(updateHand))
end

