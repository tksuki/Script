----------------------------------------------------------------
-- レイアウト
----------------------------------------------------------------
local layout = {}
local function scaleCF(cf)
    local p = cf.Position * PLATE
    return CFrame.new(p) * (cf - cf.Position)
end
local function plate(seg, x, y, z, rx, ry, rz)
    local cf = CFrame.new(x, y, z) * CFrame.Angles(rad(rx or 0), rad(ry or 0), rad(rz or 0))
    table.insert(layout, { kind = "plate", seg = seg, cf = scaleCF(cf) })
end
local function tube(seg)
    plate(seg, 0, 0.5, 0)
    plate(seg, 0, -0.5, 0)
    plate(seg, -0.5, 0, 0, 0, 0, 90)
    plate(seg, 0.5, 0, 0, 0, 0, 90)
end
for i = 0, SEG_COUNT - 1 do
    tube(i)
    if i >= 1 then
        for _, s in ipairs({-1, 1}) do
            table.insert(layout, {kind = "leg", seg = i, side = s, base = Vector3.new(s * 0.5, -0.1, 0)})
        end
    end
    if i == 0 then
        local a, p = 35, 0.1
        plate(i, 0, 0.5-p, -0.9, -a)
        plate(i, 0, -0.5+p, -0.9, a)
        plate(i, -0.5+p, 0, -0.9, 0, -a, 90)
        plate(i, 0.5-p, 0, -0.9, 0, a, 90)
        for _, s in ipairs({-1, 1}) do
            table.insert(layout, {kind = "antenna", seg = i, side = s, base = Vector3.new(s * 0.35, 0.5, -0.4)})
        end
    end
    if i == SEG_COUNT - 1 then
        local a, p = 35, 0.1
        plate(i, 0, 0.5-p, 0.9, a)
        plate(i, 0, -0.5+p, 0.9, -a)
        plate(i, -0.5+p, 0, 0.9, 0, a, 90)
        plate(i, 0.5-p, 0, 0.9, 0, -a, 90)
        for _, s in ipairs({-1, 1}) do
            table.insert(layout, {kind = "tailhorn", seg = i, side = s, base = Vector3.new(s * 0.2, 0, 0.8)})
        end
    end
end
local plateItems, ladderItems = {}, {}
for _, item in ipairs(layout) do
    table.insert(item.kind == "plate" and plateItems or ladderItems, item)
end
local NP, NL = #plateItems, #ladderItems

local function ladderLocal(startPos, dir)
    dir = dir.Unit
    local center = startPos + dir * (LADDER_LEN / PLATE / 2)
    local up = Vector3.yAxis
    local axis = up:Cross(dir)
    local rot
    if axis.Magnitude < 1e-4 then
        rot = dir.Y > 0 and CFrame.identity or CFrame.Angles(math.pi, 0, 0)
    else
        rot = CFrame.fromAxisAngle(axis.Unit, math.acos(math.clamp(up:Dot(dir), -1, 1)))
    end
    return scaleCF(CFrame.new(center) * rot) * LADDER_FIX
end

