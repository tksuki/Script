local function stopControl()
    controlling = false
    autoApproach = false
    approachTarget = nil
    pickupPhase = "idle"
    pickupClock = 0
    pickupRoot = nil
    pickupStartCFrame = nil
    table.clear(held)
    curSpeed, curTurn = 0, 0
    gui.Enabled = false
end

local function startControl()
    if controlling then return end
    if not active then
        Library:Notify({Title = "ムカデ", Description = "先に『ムカデを有効化』で組み立ててください", Time = 3})
        return
    end
    local root = getRootPart()
    if not root then return end
    tracking = false
    approachTarget = root.Position
    autoApproach = true
    pickupPhase = "idle"
    pickupClock = 0
    pickupRoot = root
    controlling = true
    table.clear(held)
    gui.Enabled = true
    local char = localPlayer.Character
    if char then
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("BasePart") then d.CanCollide = false; d.CanTouch = false; d.CanQuery = false end
        end
    end
end

local function toggleControl()
    if controlling then stopControl() else startControl() end
end

local function startTracking()
    if not active then
        Library:Notify({Title = "ムカデ追跡", Description = "先にムカデを組み立ててください", Time = 3})
        return
    end
    local player = getSelectedTarget()
    if not player then
        Library:Notify({Title = "ムカデ追跡", Description = "先に追跡対象を選択してください", Time = 3})
        return
    end
    stopControl()
    tracking = true
    autoApproach = false
    approachTarget = nil
    pickupPhase = "idle"
    pickupClock = 0
    pickupRoot = nil
    curSpeed, curTurn, trackingSpeed = 0, 0, 0
    Library:Notify({Title = "ムカデ追跡", Description = player.DisplayName .. " を20スタッド後方から追跡します", Time = 3})
end

local function stopTracking()
    tracking = false
    trackingSpeed = 0
    curSpeed, curTurn = 0, 0
end

local function toggleTracking()
    if tracking then
        stopTracking()
        Library:Notify({Title = "ムカデ追跡", Description = "追跡を停止しました", Time = 2})
    else
        startTracking()
    end
end

