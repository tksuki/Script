-- 停止・削除・作成
----------------------------------------------------------------
local function stopHold()
    stopControl()
    stopTracking()
    active = false
    for _, entry in ipairs(entries) do
        pcall(function()
            local part = entry.part
            if part and part.Parent then
                part.CanCollide = true
                part.CanTouch = true
                part.CanQuery = true
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
            end
        end)
        pcall(function() if entry.bv then entry.bv:Destroy() end; if entry.bg then entry.bg:Destroy() end end)
    end
    table.clear(entries)
    table.clear(filterModels)
end
local function removeAll()
    local models = {}
    for _, entry in ipairs(entries) do table.insert(models, entry.model) end
    stopHold()
    for _, model in ipairs(models) do
        if model and model.Parent then pcall(function() destroyToyRemote:FireServer(model) end); task.wait(0.03) end
    end
end
local function initHead()
    local root = getRootPart()
    if not root then return false end
    local _, yaw = root.CFrame:ToOrientation()
    hf = CFrame.Angles(0, yaw, 0).LookVector
    hu = Vector3.yAxis
    hp = root.Position + hf * FRONT_DIST + Vector3.new(0, BODY_H, 0)
    rebuildFilter()
    local hit = ray(hp + Vector3.new(0, 40, 0), Vector3.new(0, -400, 0))
    if hit then hp = hit.Position + Vector3.new(0, BODY_H, 0) end
    table.clear(trail)
    local n = math.ceil((SEG_COUNT * SEG_SPACING + SEG_SPACING * 2) / TRAIL_STEP) + 8
    for k = 1, n do
        local p = hp - hf * (TRAIL_STEP * k)
        local g = ray(p + Vector3.new(0, 40, 0), Vector3.new(0, -400, 0))
        if g then p = Vector3.new(p.X, g.Position.Y + BODY_H, p.Z) end
        table.insert(trail, {p = p, u = Vector3.yAxis})
    end
    curSpeed, curTurn, legPhase = 0, 0, 0
    pickupPhase, pickupClock, autoApproach, approachTarget = "idle", 0, false, nil
    tracking, trackingSpeed = false, 0
    return true
end
local function createAll()
    stopHold()
    if not getRootPart() then return false end
    local found = collect({[PLATE_NAME]=NP, [LADDER_NAME]=NL}, 20)
    local gotP, gotL = #found[PLATE_NAME], #found[LADDER_NAME]
    if gotP < NP or gotL < NL then
        Library:Notify({Title="ムカデ", Description=string.format("足りません 板 %d/%d 梯子 %d/%d", gotP, NP, gotL, NL), Time=4})
        return false
    end
    for _, list in pairs(found) do for _, f in ipairs(list) do table.insert(filterModels, f.model) end end
    if not initHead() then return false end
    computeFrames()
    local t = os.clock()
    local function attach(list, items)
        for index, f in ipairs(list) do
            local item = items[index]
            local target = targetFor(item, t)
            pcall(function()
                for _, d in ipairs(f.model:GetDescendants()) do
                    if d:IsA("BasePart") then d.CanCollide=false; d.CanTouch=false; d.CanQuery=true end
                end
            end)
            local bv, bg
            pcall(function()
                bv, bg = setupPhysics(f.part)
                bv.Velocity = (target.Position - f.part.Position) * FOLLOW_SPEED
                bg.CFrame = target
            end)
            table.insert(entries, {model=f.model, part=f.part, item=item, bv=bv, bg=bg})
        end
    end
    attach(found[PLATE_NAME], plateItems)
    attach(found[LADDER_NAME], ladderItems)
    active = true
    return true
end
local function startHold()
    if starting then return false end
    starting = true
    local ok, result = pcall(createAll)
    starting = false
    return ok and result
end
local function unload()
    if unloaded then return end
    unloaded = true
    stopHold()
    for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
    table.clear(connections)
    pcall(function() ContextActionService:UnbindAction(ACTION_NAME) end)
    pcall(function() gui:Destroy() end)
    genv.__ToyBoxCentipede.Unload = nil
    pcall(function() if Library.Unload then Library:Unload() elseif Library.Destroy then Library:Destroy() end end)
end
genv.__ToyBoxCentipede.Unload = unload

