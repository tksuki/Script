end

----------------------------------------------------------------
-- 軌跡と節フレーム
----------------------------------------------------------------
local function sampleTrail(d)
    local prevP, prevU, acc = hp, hu, 0
    for i = 1, #trail do
        local pt = trail[i]
        local len = (prevP - pt.p).Magnitude
        if acc + len >= d then
            local t = len > 1e-6 and (d - acc) / len or 0
            local u = prevU:Lerp(pt.u, t)
            return prevP:Lerp(pt.p, t), (u.Magnitude > 1e-3 and u.Unit or prevU)
        end
        acc += len
        prevP, prevU = pt.p, pt.u
    end
    return prevP, prevU
end
local function computeFrames()
    for i = 0, SEG_COUNT - 1 do
        local pos, up, fwd
        if i == 0 then
            pos, up, fwd = hp, hu, hf
        else
            local d = i * SEG_SPACING
            pos, up = sampleTrail(d)
            local pf = sampleTrail(math.max(0, d - SEG_SPACING * 0.4))
            local pb = sampleTrail(d + SEG_SPACING * 0.4)
            fwd = pf - pb
            fwd = fwd.Magnitude > 1e-3 and fwd.Unit or hf
        end
        local u = up - fwd * up:Dot(fwd)
        u = u.Magnitude > 1e-3 and u.Unit or hu
        local right = fwd:Cross(u).Unit
        u = right:Cross(fwd)
        segFrames[i] = CFrame.fromMatrix(pos, right, u)
    end
end

----------------------------------------------------------------
-- 触角・足アニメーション
----------------------------------------------------------------
local function pickupBlend()
    if pickupPhase == "reach" then
        return math.clamp(pickupClock / ANTENNA_REACH_TIME, 0, 1)
    elseif pickupPhase == "lift" then
        return 1
    elseif pickupPhase == "place" or pickupPhase == "riding" then
        return 0
    end
    return 0
end
local function ladderDir(item, t)
    local s = item.side
    if item.kind == "leg" then
        local ph = legPhase - item.seg * 0.65 + (s > 0 and math.pi or 0)
        local lift = math.max(0, math.cos(ph))
        local a = rad(54 + 14 * lift)
        return Vector3.new(s * math.sin(a), -math.cos(a), -0.45 * math.sin(ph))
    elseif item.kind == "antenna" then
        local base = Vector3.new(
            s * (0.45 + 0.15 * math.sin(t * 2.3 + s)) - curTurn * 0.35,
            0.6 + 0.18 * math.sin(t * 3.1 + s * 1.7),
            -0.7 + 0.15 * math.sin(t * 1.7 + s)
        )
        if pickupPhase == "reach" or pickupPhase == "lift" then
            local target = approachTarget or (hp + hf * 5)
            local f = segFrames[0]
            local basePos = (f * CFrame.new(item.base * PLATE)).Position
            local toPlayer = target - basePos
            if toPlayer.Magnitude > 0.1 then
                local sideAxis = f.RightVector
                local reachVector = toPlayer + sideAxis * (s * 5) + hu * 2 + hf * 1.5
                local reachDir = reachVector.Unit
                if pickupPhase == "lift" then
                    local lift = math.clamp(pickupClock / ANTENNA_LIFT_TIME, 0, 1)
                    reachDir = (reachVector + hu * (8 + lift * 12) + sideAxis * (s * 2)).Unit
                end
                local alpha = pickupBlend()
                if pickupPhase == "lift" then alpha = 1 end
                return base:Lerp(reachDir, alpha).Unit
            end
        elseif pickupPhase == "place" then
            local returnAlpha = math.clamp(pickupClock / ANTENNA_PLACE_TIME, 0, 1)
            local target = Vector3.new(s * 0.65, 0.95, -0.25)
            return base:Lerp(target, returnAlpha).Unit
        end
        return base
    else
        return Vector3.new(s * 0.35 + 0.12 * math.sin(t * 2 + s) + curTurn * 0.2,
            0.1 + 0.08 * math.sin(t * 2.7 + s), 0.9)
    end
end
local function targetFor(item, t)
    local f = segFrames[item.seg]
    if item.kind == "plate" then return f * item.cf end
    return f * ladderLocal(item.base, ladderDir(item, t))
end

