-- 崖上テレポート機能
----------------------------------------------------------------
local function teleportToCliff()
    if not active then
        Library:Notify({Title = "ムカデ", Description = "ムカデが有効化されていません", Time = 3})
        return
    end
    stopControl()
    stopTracking()

    -- 指定された座標からX方向に20スタッド右へずらした位置にヘッドを設定
    hp = Vector3.new(560.07, 163.34, 129.67)
    hu = Vector3.yAxis
    hf = Vector3.new(0, 0, -1)

    -- 軌跡（trail）を再生成
    table.clear(trail)
    local n = math.ceil((SEG_COUNT * SEG_SPACING + SEG_SPACING * 2) / TRAIL_STEP) + 8
    for k = 1, n do
        local p = hp - hf * (TRAIL_STEP * k)
        local gRay = ray(p + Vector3.new(0, 40, 0), Vector3.new(0, -400, 0))
        if gRay then p = Vector3.new(p.X, gRay.Position.Y + BODY_H, p.Z) end
        table.insert(trail, {p = p, u = Vector3.yAxis})
    end

    computeFrames()

    -- 各パーツを即座に新しいターゲット位置へワープさせる
    local t = os.clock()
    for _, entry in ipairs(entries) do
        local target = targetFor(entry.item, t)
        pcall(function()
            entry.part.CFrame = target
            entry.part.AssemblyLinearVelocity = Vector3.zero
            entry.part.AssemblyAngularVelocity = Vector3.zero
            if entry.bv then entry.bv.Velocity = Vector3.zero end
            if entry.bg then entry.bg.CFrame = target end
        end)
    end

    Library:Notify({Title = "ムカデ", Description = "崖上の座標 (560.07, 163.34, 129.67) にテレポートしました", Time = 3})
end

