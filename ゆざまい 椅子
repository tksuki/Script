local ACTION_NAME = "ToyBoxCentipedeKeys"
local moveKeySet = {
    [Enum.KeyCode.W]=true, [Enum.KeyCode.A]=true, [Enum.KeyCode.S]=true, [Enum.KeyCode.D]=true,
    [Enum.KeyCode.Up]=true, [Enum.KeyCode.Down]=true, [Enum.KeyCode.Left]=true, [Enum.KeyCode.Right]=true,
    [Enum.KeyCode.Q]=true, [Enum.KeyCode.E]=true,
}
local function onAction(_, state, input)
    local key = input.KeyCode
    if key == Enum.KeyCode.T then if state == Enum.UserInputState.Begin then toggleControl() end; return Enum.ContextActionResult.Sink end
    if key == Enum.KeyCode.R then
        if state == Enum.UserInputState.Begin then
            if controlling then stopControl() elseif tracking then stopTracking() end
        end
        return Enum.ContextActionResult.Sink
    end
    if not controlling then return Enum.ContextActionResult.Pass end
    if moveKeySet[key] then
        if state == Enum.UserInputState.Begin then held[key] = true
        elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then held[key] = nil end
        return Enum.ContextActionResult.Sink
    end
    return Enum.ContextActionResult.Pass
end
local bindKeys = {Enum.KeyCode.T, Enum.KeyCode.R}
for k in pairs(moveKeySet) do table.insert(bindKeys, k) end
ContextActionService:BindActionAtPriority(ACTION_NAME, onAction, false, Enum.ContextActionPriority.High.Value, table.unpack(bindKeys))


