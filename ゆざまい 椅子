----------------------------------------------------------------
local function collect(needs, timeout)
    local found, seen = {}, {}
    for name in pairs(needs) do found[name] = {} end
    local function done()
        for name, n in pairs(needs) do if #found[name] < n then return false end end
        return true
    end
    local deadline = os.clock() + (timeout or 20)
    while os.clock() < deadline and not done() do
        local root = getRootPart()
        if root then
            for _, part in ipairs(Workspace:GetPartBoundsInRadius(root.Position, SEARCH_RADIUS)) do
                for name, n in pairs(needs) do
                    if #found[name] < n then
                        local model = getModelByName(part, name)
                        if model and not seen[model] then
                            local mainPart = getMainPart(model)
                            if mainPart and mainPart:IsDescendantOf(Workspace) then
                                seen[model] = true
                                pcall(function() setNetworkOwnerRemote:FireServer(mainPart, mainPart.CFrame) end)
                                table.insert(found[name], {model = model, part = mainPart})
                            end
                        end
                    end
                end
            end
        end
        if not done() then task.wait(0.05) end
    end
    return found
end
local function setupPhysics(part)
    part.CanCollide, part.CanTouch, part.CanQuery = false, false, true
    local bv = part:FindFirstChild("ToyBoxForce") or Instance.new("BodyVelocity")
    bv.Name = "ToyBoxForce"
    bv.MaxForce = Vector3.new(1, 1, 1) * 1e8
    bv.Parent = part
    local bg = part:FindFirstChild("ToyBoxGyro") or Instance.new("BodyGyro")
    bg.Name = "ToyBoxGyro"
    bg.MaxTorque = Vector3.new(1, 1, 1) * 1e8
    bg.P, bg.D = 200000, 2000
    bg.Parent = part
    return bv, bg
end
local function updateCentipede()
    local t = os.clock()
    for _, entry in ipairs(entries) do
        local part = entry.part
        if part and part.Parent then
            local target = targetFor(entry.item, t)
            if (target.Position - part.Position).Magnitude > 50 then
                pcall(function()
                    part.CFrame = target
                    part.AssemblyLinearVelocity = Vector3.zero
                    part.AssemblyAngularVelocity = Vector3.zero
                end)
            else
                pcall(function()
                    if entry.bv and entry.bv.Parent then entry.bv.Velocity = (target.Position - part.Position) * FOLLOW_SPEED end
                    if entry.bg and entry.bg.Parent then entry.bg.CFrame = target end
                end)
            end
        end
    end
end

----------------------------------------------------------------
-- 地形判定
----------------------------------------------------------------
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true
rayParams.RespectCanCollide = true
local function rebuildFilter()
    local list = table.clone(filterModels)
    for _, p in ipairs(Players:GetPlayers()) do if p.Character then table.insert(list, p.Character) end end
    rayParams.FilterDescendantsInstances = list
end
local function ray(origin, dir) return Workspace:Raycast(origin, dir, rayParams) end
local function alignTo(n, maxAngle)
    local ang = math.acos(math.clamp(hu:Dot(n), -1, 1))
    if ang < 1e-3 then return end
    local axis = hu:Cross(n)
    if axis.Magnitude < 1e-4 then axis = hf:Cross(hu) end
    local rot = CFrame.fromAxisAngle(axis.Unit, math.min(ang, maxAngle))
    hu = rot:VectorToWorldSpace(hu).Unit
    hf = rot:VectorToWorldSpace(hf)
    hf = (hf - hu * hf:Dot(hu)).Unit
end
local function isDown(...)
    for _, k in ipairs({...}) do if held[k] then return true end end
    return false
end
local function axisVal(pos, neg) return (pos and 1 or 0) - (neg and 1 or 0) end

----------------------------------------------------------------
-- 触角でプレイヤーを持ち上げて頭上へ移動
----------------------------------------------------------------
local function updatePickup(dt)
    if pickupPhase == "idle" or pickupPhase == "riding" then return end
    local root = pickupRoot or getRootPart()
    if not root or not root.Parent then pickupPhase = "idle"; return end
    pickupClock += dt

    if pickupPhase == "reach" then
        if pickupClock >= ANTENNA_REACH_TIME then
            pickupPhase = "lift"
            pickupClock = 0
            pickupStartCFrame = root.CFrame
        end
    elseif pickupPhase == "lift" then
        local alpha = math.clamp(pickupClock / ANTENNA_LIFT_TIME, 0, 1)
        alpha = alpha * alpha * (3 - 2 * alpha)
        local right = hf:Cross(hu).Unit
        local targetPos = hp + hu * (PLATE * 0.5 + 4)
        local targetCF = CFrame.fromMatrix(targetPos, right, hu)
        if pickupStartCFrame then
            root.CFrame = pickupStartCFrame:Lerp(targetCF, alpha)
        else
            root.CFrame = targetCF
        end
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        if alpha >= 1 then
            pickupPhase = "place"
            pickupClock = 0
        end
    elseif pickupPhase == "place" then
        local right = hf:Cross(hu).Unit
        local targetPos = hp + hu * (PLATE * 0.5 + 4)
        root.CFrame = CFrame.fromMatrix(targetPos, right, hu)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        if pickupClock >= ANTENNA_PLACE_TIME then
            pickupPhase = "riding"
            pickupClock = 0
            approachTarget = nil
            autoApproach = false
        end
    end
end

local function stepHead(dt)
    local KC = Enum.KeyCode
    local fw = (isDown(KC.W, KC.Up) and 1 or 0) - (isDown(KC.S, KC.Down) and 1 or 0)
    local brake = isDown(KC.S, KC.Down)
    local turn = axisVal(isDown(KC.A, KC.Left), isDown(KC.D, KC.Right))
    trackingSpeed = 0

    if UserInputService.TouchEnabled and not tracking and not autoApproach and pickupPhase == "riding" then
        local character = localPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            local md = humanoid.MoveDirection
            md = md - hu * md:Dot(hu)
            if md.Magnitude > 0.1 then
                md = md.Unit
                local right = hf:Cross(hu).Unit
                fw = math.clamp(md:Dot(hf), -1, 1)
                turn = math.clamp(-md:Dot(right), -1, 1)
                brake = false
            else
                fw, turn = 0, 0
            end
        end
    end

    if not tracking then
        if isDown(KC.E) then moveSpeed = math.clamp(moveSpeed + 60 * dt, 10, 200) end
        if isDown(KC.Q) then moveSpeed = math.clamp(moveSpeed - 60 * dt, 10, 200) end
    end

    if tracking then
        local targetPlayer, targetCharacter, targetRoot = getSelectedTarget()
        if not targetRoot then
            tracking = false
            trackingSpeed = 0
            curSpeed = 0
            Library:Notify({Title = "ムカデ追跡", Description = "対象プレイヤーが見つからないため追跡を停止しました", Time = 3})
        else
            local followPosition = (targetRoot.CFrame * CFrame.new(0, 0, TRACK_DISTANCE)).Position
            local delta = followPosition - hp
            delta = delta - hu * delta:Dot(hu)
            local distance = delta.Magnitude
            local velocity = targetRoot.AssemblyLinearVelocity
            local horizontalVelocityVector = Vector3.new(velocity.X, 0, velocity.Z)
            local horizontalVelocity = horizontalVelocityVector.Magnitude
            local targetHumanoid = targetCharacter:FindFirstChildOfClass("Humanoid")
            local measuredSpeed = horizontalVelocity
            if targetHumanoid and targetHumanoid.MoveDirection.Magnitude > 0.05 then
                measuredSpeed = math.max(measuredSpeed, targetHumanoid.WalkSpeed * targetHumanoid.MoveDirection.Magnitude)
                if horizontalVelocityVector.Magnitude < 0.1 then
                    horizontalVelocityVector = targetHumanoid.MoveDirection * measuredSpeed
                end
            end
            local direction = nil
            if distance > 2.5 then
                trackingSpeed = math.max(measuredSpeed, math.min(TRACK_MAX_CATCHUP_SPEED, distance * 2))
                direction = delta.Unit
            else
                trackingSpeed = measuredSpeed
                if horizontalVelocityVector.Magnitude > 0.1 then
                    direction = horizontalVelocityVector.Unit
                end
            end
            if direction then
                local angle = math.atan2(hu:Dot(hf:Cross(direction)), hf:Dot(direction))
                local rotation = math.clamp(angle, -ROT_RATE * dt, ROT_RATE * dt)
                hf = CFrame.fromAxisAngle(hu, rotation):VectorToWorldSpace(hf)
                fw, turn, brake = 1, 0, false
            else
                fw, turn, brake = 0, 0, true
            end
        end
    elseif autoApproach and approachTarget then
        local delta = approachTarget - hp
        delta = delta - hu * delta:Dot(hu)
        if delta.Magnitude <= APPROACH_STOP_DISTANCE then
            autoApproach = false
            pickupPhase = "reach"
            pickupClock = 0
            pickupRoot = getRootPart()
            pickupStartCFrame = pickupRoot and pickupRoot.CFrame or nil
            fw, turn, brake = 0, 0, true
        else
            local direction = delta.Unit
            local angle = math.atan2(hu:Dot(hf:Cross(direction)), hf:Dot(direction))
            local rotation = math.clamp(angle, -ROT_RATE * dt, ROT_RATE * dt)
            hf = CFrame.fromAxisAngle(hu, rotation):VectorToWorldSpace(hf)
            fw, turn, brake = 1, 0, false
        end
    end

    local targetSpeed = tracking and trackingSpeed or (autoApproach and APPROACH_SPEED or (brake and 0 or fw * moveSpeed))
    curSpeed += (targetSpeed - curSpeed) * math.clamp(dt * (brake and 8 or 3), 0, 1)
    curTurn += (turn * rad(turnRateDeg) - curTurn) * math.clamp(dt * 6, 0, 1)
    hf = CFrame.fromAxisAngle(hu, curTurn * dt):VectorToWorldSpace(hf)

    rebuildFilter()
    local H = BODY_H
    local look = H + PLATE * 1.2
    local targetN, stepLimit = nil, math.huge
    local hitMid = ray(hp, hf * look)
    local hitLow = ray(hp - hu * (H * 0.7), hf * look)
    local hitF = hitMid
    if hitMid and hitLow then hitF = hitMid.Distance < hitLow.Distance and hitMid or hitLow elseif hitLow then hitF = hitLow end
    if hitF and hitF.Normal:Dot(hu) < 0.9 and hitF.Normal:Dot(hf) < -0.2 then
        targetN = hitF.Normal
        stepLimit = math.max(0, (hp - hitF.Position):Dot(hitF.Normal) - H)
    end
    local gDown = ray(hp + hu * 2, -hu * (H * 2.4))
    local ahead = hp + hf * (H * 0.8)
    local gAhead = ray(ahead + hu * 2, -hu * (H * 2.4))
    if not targetN then
        if gAhead then
            targetN = gAhead.Normal
            if gDown then
                local sum = gAhead.Normal + gDown.Normal
                if sum.Magnitude > 0.1 then targetN = sum.Unit end
            end
        elseif gDown then
            local edge = ray(ahead - hu * (H * 1.2), -hf * (H * 1.5))
            targetN = (edge and edge.Normal:Dot(hf) > 0.3) and edge.Normal or gDown.Normal
        end
    end
    if targetN then alignTo(targetN, ROT_RATE * dt) end

    local step = math.min(curSpeed * dt, stepLimit)
    if step > 0 then hp += hf * step end
    local gSnap = ray(hp + hu * 2, -hu * (H * 2.4))
    if gSnap then
        hp = hp:Lerp(gSnap.Position + hu * H, math.clamp(dt * 12, 0, 1))
    else
        hp += Vector3.new(0, -GRAVITY * dt, 0)
        alignTo(Vector3.yAxis, ROT_RATE * dt * 0.5)
    end

    local last = trail[1]
    if not last or (hp - last.p).Magnitude >= TRAIL_STEP then
        table.insert(trail, 1, {p = hp, u = hu})
        local maxN = math.ceil((SEG_COUNT * SEG_SPACING + SEG_SPACING * 2) / TRAIL_STEP) + 8
        while #trail > maxN do table.remove(trail) end
    end
    legPhase += (math.abs(curSpeed) * dt / STRIDE) * 2 * math.pi

    local root = getRootPart()
    if root and not tracking then
        if pickupPhase == "riding" then
            local right = hf:Cross(hu).Unit
            root.CFrame = CFrame.fromMatrix(hp + hu * (PLATE * 0.5 + 4), right, hu)
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        elseif pickupPhase == "idle" and not autoApproach then
        end
    end
    updatePickup(dt)
end

