                        Pallete = inv:FindFirstChild("RagdollPalete")
                        if not Pallete then continue end
                        local SoundPart = Pallete:FindFirstChild("SoundPart")
                        if not SoundPart then continue end
                        if not etc.Root then continue end
                        if not etc.Hum then continue end

                        if CFP(etc["Hum"], "Ragdolled") and not (etc["Hum"].Ragdolled.Value) then
                            -- 相手の現在のLookVector（縦横回転中の向き）を取得して正面から真っ直ぐ当てる
                            local look = etc.Root.CFrame.LookVector
                            local hitPos = etc.Root.Position + look * V3_PALLETE_RADIUS
                            SoundPart.CFrame = CFrame.new(hitPos, hitPos + look)
                        end
                    end
                end)

                while bool.LoopGrabKickV3 and RunService.RenderStepped:Wait() do
                    etc.TargetPLR = selectedPlrName and game.Players:FindFirstChild(selectedPlrName)
                    if not etc.TargetPLR then continue end
                    etc.Head = etc["TargetPLR"].Character and etc["TargetPLR"].Character:FindFirstChild("Head")
                    etc.Root = etc["TargetPLR"].Character and etc["TargetPLR"].Character:FindFirstChild("HumanoidRootPart")
                    etc.Hum = etc["TargetPLR"].Character and etc["TargetPLR"].Character:FindFirstChild("Humanoid")
                    local BodyPos = etc.Root and etc.Root:FindFirstChild("KickBodyPos")
                    local BodyForce = etc.Root and etc.Root:FindFirstChild("KickAntiGravity")

                    if (etc.Head and etc.Hum and etc.Root and etc.Hum.Health ~= 0) and GetMagnitude(hrp, etc["Root"]) <= 30 then
                        if not (BodyPos) then
                            BodyPos = Instance.new("BodyPosition")
                            BodyPos.Name = "KickBodyPos"
                            BodyPos.MaxForce = Vector3.new(Huge())
                            BodyPos.Parent = etc.Root
                            BodyPos.P = 300000
                            BodyPos.D = 30000
                            BodyPos.Position = hrp.Position + Vector3.new(0, 15, -10)
                        end

                        if not (BodyForce) then
                            BodyForce = Instance.new("BodyForce")
                            BodyForce.Name = "KickAntiGravity"
                            BodyForce.Parent = etc.Root
                        end

                        local BodyGyro = etc.Root:FindFirstChild("KickBodyGyro")
                        if not BodyGyro then
                            BodyGyro = Instance.new("BodyGyro")
                            BodyGyro.Name = "KickBodyGyro"
                            BodyGyro.MaxTorque = Vector3.new(Huge())
                            BodyGyro.P = 300000
                            BodyGyro.D = 30000
                            BodyGyro.CFrame = etc.Root.CFrame
                            BodyGyro.Parent = etc.Root
                        end

                        -- ★ 毎秒50回転（300度/frame@60fps）をランダム軸で適用
                        kickV3Angle = (kickV3Angle + 300) % 360
                        local radV3 = math.rad(kickV3Angle)
                        local rpV3  = math.rad(kickV3Angle * 1.7 + math.random(0, 360))
                        local rrV3  = math.rad(kickV3Angle * 2.3 + math.random(0, 360))
                        local rotCF = CFrame.new(etc.Root.Position)
                            * CFrame.Angles(rpV3, radV3, rrV3)
                        BodyGyro.CFrame = rotCF

                        local totalMass = 0
                        for _, part in pairs(etc.TargetPLR.Character:GetDescendants()) do
                            if part:IsA("BasePart") then
                                totalMass = totalMass + part.AssemblyMass
                            end
                        end
                        BodyForce.Force = Vector3.new(0, totalMass * workspace.Gravity, 0)

                        BodyPos.Position = hrp.Position + Vector3.new(0, 15, -10)

                        if (etc.Root.Position.Y <= hrp.Position.Y + 15) and etc["TargetPLR"].IsHeld.Value then
                            for _, v in pairs(etc.TargetPLR.Character:GetChildren()) do
                                if v:IsA("Part") then
                                    v.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 15, -10))
                                end
                            end
                        end

                        etc["Root"].AssemblyAngularVelocity, etc["Root"].AssemblyLinearVelocity = Vector3.zero, Vector3.zero
                        etc.Hum.PlatformStand = true
                        etc.Hum.Sit = true

                        local fixPos = hrp.Position + Vector3.new(0, 15, -10)
                        if BodyPos then BodyPos.Position = fixPos end

                        -- 1フレーム目: SNO×3
                        local rootCF = etc["Root"].CFrame
                        etc["Root"].AssemblyLinearVelocity = Vector3.zero
                        etc["Root"].AssemblyAngularVelocity = Vector3.zero
                        SetNetworkOwner:FireServer(etc["Root"], rootCF)
                        SetNetworkOwner:FireServer(etc["Root"], rootCF)
                        SetNetworkOwner:FireServer(etc["Root"], rootCF)
                        RunService.RenderStepped:Wait()
                        -- 2フレーム目: UNSNO×2
                        DestroyGrabLine:FireServer(etc["Root"])
                        RunService.RenderStepped:Wait()

                        -- パレットのスポーン確認
                        if bool.DoRagdoll then
                            Pallete = inv:FindFirstChild("RagdollPalete")
                            if not Pallete then
                                Pallete = SpawnPallete()
                            end
                        end

                    else
                        if not etc["Head"] or not etc["Hum"] or etc["Hum"].Health == 0 then
                            etc.TargetPLR.CharacterAdded:Wait()
                            etc.Head = FWD(etc.TargetPLR.Character, "Head", 5)
                            etc.Hum = FWD(etc.TargetPLR.Character, "Humanoid", 5)
                            BodyPos = Instance.new("BodyPosition")
                            BodyPos.Name = "KickBodyPos"
                            BodyPos.MaxForce = Vector3.new(Huge())
                            BodyPos.Parent = etc.Root
                            BodyPos.P = 300000
                            BodyPos.D = 30000
                            BodyPos.Position = hrp.Position + Vector3.new(0, 15, -10)
                        end

                        local oldCF = hrp.CFrame
                        while (etc["Head"] and etc["Hum"] and etc['Hum'].Health ~= 0) and task.wait(0.01) and bool.LoopGrabKickV3 do
                            etc["TargetPLR"] = selectedPlrName and Players:FindFirstChild(selectedPlrName)
                            if not etc["TargetPLR"] then break end
                            if etc["TargetPLR"].InPlot.Value then continue end
                            etc["Head"] = etc["TargetPLR"].Character and etc["TargetPLR"].Character:FindFirstChild("Head")
                            etc["Hum"] = etc["TargetPLR"].Character and etc["TargetPLR"].Character:FindFirstChild("Humanoid")
                            if not (etc["Head"]) or not (etc["Hum"]) then break end
                            char:PivotTo(etc["Head"].CFrame * CFrame.new(0, 10, 0))
                            sno(etc["Head"])
                            if CheckForPartOwner(etc["Head"]) then
                                break
                            end
                        end

                        hrp.CFrame = oldCF

                        if etc.Head and CheckForPartOwner(etc.Head) then
                            for _, v in pairs(etc.TargetPLR.Character:GetChildren()) do
                                if v:IsA("Part") then
                                    v.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 15, -10))
                                end
                            end
                        end
                    end
                end

                if etc["Root"] then
                    for _, v in pairs(etc["Root"]:GetChildren()) do
                        if v.Name == "KickBodyPos" or v.Name == "KickAntiGravity" or v.Name == "KickBodyGyro" then
                            v:Destroy()
                        end
                    end
                end
            end)
        end
    end
})

