-- ============ LoopGrab [KICK] ============
TarTab:AddToggle({
    Name = "LoopGrab<font color=\"rgb(100, 255, 200)\"><b>[KICK]</b></font>",
    Default = false,
    Callback = function(Value)
        bool.LoopGrabKick = Value
        if bool.LoopGrabKick then
            task.spawn(function()
                etc.TargetPLR = selectedPlrName and game.Players:FindFirstChild(selectedPlrName)
                etc.Head = etc.TargetPLR and etc.TargetPLR.Character and etc.TargetPLR.Character:FindFirstChild("Head")
                etc.Root = etc.TargetPLR and etc.TargetPLR.Character and etc.TargetPLR.Character:FindFirstChild("HumanoidRootPart")
                local Pallete = inv:FindFirstChild("RagdollPalete")

                local function SpawnPallete()
                    Pallete = SpawnToy("PalletLightBrown")
                    if not Pallete then return end
                    local SoundPart = FWD(Pallete, "SoundPart")
                    repeat sno(SoundPart) task.wait(0.05) until CFP(SoundPart, "PartOwner") or not bool.LoopGrabKick
                    for _, v in pairs(Pallete:GetDescendants()) do
                        if v:IsA("BasePart") then
                            v.CanCollide = false
                            v.Transparency = 0.8
                        end
                    end
                    Pallete.Name = "RagdollPalete"
                    task.delay(1, RenameInShop, Pallete, "PalletLightBrown", "Ragdoll")
                    local bv = Instance.new("BodyVelocity")
                    bv.MaxForce = Vector3.new(0, math.huge, 0)
                    bv.Velocity = Vector3.new(0, 900, 0)
                    bv.Parent = Pallete.SoundPart
                    return Pallete
                end

                if not (Pallete) and bool.DoRagdoll then
                    Pallete = SpawnPallete()
                end

                while bool.LoopGrabKick and RunService.RenderStepped:Wait() do
                    etc.TargetPLR = selectedPlrName and game.Players:FindFirstChild(selectedPlrName)
                    if not etc.TargetPLR then continue end
                    etc.Head = etc["TargetPLR"].Character and etc["TargetPLR"].Character:FindFirstChild("Head")
                    etc.Root = etc["TargetPLR"].Character and etc["TargetPLR"].Character:FindFirstChild("HumanoidRootPart")
                    etc.Hum = etc["TargetPLR"].Character and etc["TargetPLR"].Character:FindFirstChild("Humanoid")
                    local BodyPos = etc.Root and etc.Root:FindFirstChild("BodyPosition")

                    if (etc.Head and etc.Hum and etc.Root and etc.Hum.Health ~= 0) and GetMagnitude(hrp, etc["Root"]) <= 30 then
                        if not (BodyPos) then
                            BodyPos = Instance.new("BodyPosition")
                            BodyPos.MaxForce = Vector3.new(Huge())
                            BodyPos.Parent = etc.Root
                            BodyPos.P = 75000
                            BodyPos.D = 12000
                            BodyPos.Position = hrp.Position + Vector3.new(0, 15, 0)
                        end
                        BodyPos.Position = hrp.Position + Vector3.new(0, 15, 0)
                        if (etc.Root.Position.Y <= hrp.Position.Y + 15) and etc["TargetPLR"].IsHeld.Value then
                            for _, v in pairs(etc.TargetPLR.Character:GetChildren()) do
                                if v:IsA("Part") then
                                    v.CFrame = hrp.CFrame * CFrame.new(0, 15, 0)
                                end
                            end
                        end
                        etc["Root"].AssemblyAngularVelocity, etc["Root"].AssemblyLinearVelocity = Vector3.zero, Vector3.zero
                        etc.Hum.PlatformStand = true
                        sno(etc["Root"])
                        RunService.RenderStepped:Wait()
                        unsno(etc["Root"])
                        unsno(etc["Root"])
                        RunService.RenderStepped:Wait()
                        if bool.DoRagdoll then
                            Pallete = inv:FindFirstChild("RagdollPalete")
                            if not Pallete then
                                Pallete = SpawnPallete()
                            end
                            if CFP(etc["Hum"], "Ragdolled") and not (etc["Hum"].Ragdolled.Value) then
                                Pallete.SoundPart.Position = etc["Root"].Position
                            end
                        end
                        RunService.RenderStepped:Wait()
                        unsno(etc["Root"])
                        unsno(etc["Root"])
                    else
                        if not etc["Head"] or not etc["Hum"] or etc["Hum"].Health == 0 then
                            etc.TargetPLR.CharacterAdded:Wait()
                            etc.Head = FWD(etc.TargetPLR.Character, "Head", 5)
                            etc.Hum = FWD(etc.TargetPLR.Character, "Humanoid", 5)
                            BodyPos = Instance.new("BodyPosition")
                            BodyPos.MaxForce = Vector3.new(Huge())
                            BodyPos.Parent = etc.Root
                            BodyPos.P = 75000
                            BodyPos.D = 12000
                            BodyPos.Position = hrp.Position + Vector3.new(0, 15, 0)
                        end
                        local oldCF = hrp.CFrame
                        while (etc["Head"] and etc["Hum"] and etc['Hum'].Health ~= 0) and task.wait(0.01) and bool.LoopGrabKick do
                            etc["TargetPLR"] = selectedPlrName and Players:FindFirstChild(selectedPlrName)
                            if not etc["TargetPLR"] then break end
                            if etc["TargetPLR"].InPlot.Value then continue end
                            etc["Head"] = etc["TargetPLR"].Character and etc["TargetPLR"].Character:FindFirstChild("Head")
                            etc["Hum"] = etc["TargetPLR"].Character and etc["TargetPLR"].Character:FindFirstChild("Humanoid")
                            if not (etc["Head"]) or not (etc["Hum"]) then break end
                            char:PivotTo(etc["Head"].CFrame * CFrame.new(0, 10, 0))
                            sno(etc["Head"])
                            if CheckForPartOwner(etc["Head"]) then
                                break
                            end
                        end
                        hrp.CFrame = oldCF
                        if etc.Head and CheckForPartOwner(etc.Head) then
                            for _, v in pairs(etc.TargetPLR.Character:GetChildren()) do
                                if v:IsA("Part") then
                                    v.CFrame = hrp.CFrame * CFrame.new(0, 15, 0)
                                end
                            end
                        end
                    end
                end
                if etc["Root"] then
                    for _, v in pairs(etc["Root"]:GetChildren()) do
                        if v.Name == "BodyPosition" then
                            v:Destroy()
                        end
                    end
                end
            end)
        end
    end
})

-- ============ LoopGrab [KICK v2] (回転 + 高速回転パレット) ============
local kickV2Angle = 0       -- 相手の回転角度（BodyGyro用）
local palleteAngle = 0      -- パレット独立高速回転角度
local PALLETE_RADIUS = 3    -- 相手中心からパレットを当てる半径（スタッド）
local PALLETE_SPEED = 45    -- パレットの回転速度（度/frame、大きいほど速い）

TarTab:AddToggle({
    Name = "LoopGrab<font color=\"rgb(255, 100, 0)\"><b>[KICK v2]</b></font>",
    Default = false,
    Callback = function(Value)
        bool.LoopGrabKickV2 = Value
        kickV2Angle = 0
        palleteAngle = 0
        if bool.LoopGrabKickV2 then
            task.spawn(function()
                etc.TargetPLR = selectedPlrName and game.Players:FindFirstChild(selectedPlrName)
                etc.Head = etc.TargetPLR and etc.TargetPLR.Character and etc.TargetPLR.Character:FindFirstChild("Head")
                etc.Root = etc.TargetPLR and etc.TargetPLR.Character and etc.TargetPLR.Character:FindFirstChild("HumanoidRootPart")
                local Pallete = inv:FindFirstChild("RagdollPalete")

                local function SpawnPallete()
                    Pallete = SpawnToy("PalletLightBrown")
                    if not Pallete then return end
                    local SoundPart = FWD(Pallete, "SoundPart")
                    repeat sno(SoundPart) task.wait(0.05) until CFP(SoundPart, "PartOwner") or not bool.LoopGrabKickV2
                    for _, v in pairs(Pallete:GetDescendants()) do
                        if v:IsA("BasePart") then
                            v.CanCollide = false
                            v.Transparency = 0.8
                        end
                    end
                    Pallete.Name = "RagdollPalete"
                    task.delay(1, RenameInShop, Pallete, "PalletLightBrown", "Ragdoll")
                    -- BodyVelocityは使わない（CFrameで直接操作するため）
                    return Pallete
                end

                if not (Pallete) and bool.DoRagdoll then
                    Pallete = SpawnPallete()
                end

                -- ★ パレット専用ループ: 相手の現在の向き正面から真っ直ぐ当て続ける
                task.spawn(function()
                    while bool.LoopGrabKickV2 and RunService.RenderStepped:Wait() do
                        if not bool.DoRagdoll then continue end
                        Pallete = inv:FindFirstChild("RagdollPalete")
                        if not Pallete then continue end
                        local SoundPart = Pallete:FindFirstChild("SoundPart")
                        if not SoundPart then continue end
                        if not etc.Root then continue end
                        if not etc.Hum then continue end

                        if CFP(etc["Hum"], "Ragdolled") and not (etc["Hum"].Ragdolled.Value) then
                            -- 相手の現在のLookVector（BodyGyroで回転中の向き）を取得
                            local look = etc.Root.CFrame.LookVector
                            -- 相手の正面PALLETE_RADIUS前にパレットを配置し、同じ向きを向かせる
                            local hitPos = etc.Root.Position + look * PALLETE_RADIUS
                            SoundPart.CFrame = CFrame.new(hitPos, hitPos + look)
                        end
                    end
                end)

                while bool.LoopGrabKickV2 and RunService.RenderStepped:Wait() do
                    etc.TargetPLR = selectedPlrName and game.Players:FindFirstChild(selectedPlrName)
                    if not etc.TargetPLR then continue end
                    etc.Head = etc["TargetPLR"].Character and etc["TargetPLR"].Character:FindFirstChild("Head")
                    etc.Root = etc["TargetPLR"].Character and etc["TargetPLR"].Character:FindFirstChild("HumanoidRootPart")
                    etc.Hum = etc["TargetPLR"].Character and etc["TargetPLR"].Character:FindFirstChild("Humanoid")
                    local BodyPos = etc.Root and etc.Root:FindFirstChild("KickBodyPos")
                    local BodyForce = etc.Root and etc.Root:FindFirstChild("KickAntiGravity")

                    if (etc.Head and etc.Hum and etc.Root and etc.Hum.Health ~= 0) and GetMagnitude(hrp, etc["Root"]) <= 30 then
                        if not (BodyPos) then
                            BodyPos = Instance.new("BodyPosition")
                            BodyPos.Name = "KickBodyPos"
                            BodyPos.MaxForce = Vector3.new(Huge())
                            BodyPos.Parent = etc.Root
                            BodyPos.P = 300000
                            BodyPos.D = 30000
                            BodyPos.Position = hrp.Position + Vector3.new(0, 15, -10)
                        end

                        if not (BodyForce) then
                            BodyForce = Instance.new("BodyForce")
                            BodyForce.Name = "KickAntiGravity"
                            BodyForce.Parent = etc.Root
                        end

                        local BodyGyro = etc.Root:FindFirstChild("KickBodyGyro")
                        if not BodyGyro then
                            BodyGyro = Instance.new("BodyGyro")
                            BodyGyro.Name = "KickBodyGyro"
                            BodyGyro.MaxTorque = Vector3.new(Huge())
                            BodyGyro.P = 300000
                            BodyGyro.D = 30000
                            BodyGyro.CFrame = etc.Root.CFrame
                            BodyGyro.Parent = etc.Root
                        end

                        -- ★ 毎秒50回転（300度/frame@60fps）をランダム軸で適用
                        kickV2Angle = (kickV2Angle + 300) % 360
                        local rad = math.rad(kickV2Angle)
                        local rp = math.rad(kickV2Angle * 1.7 + math.random(0, 360))
                        local rr = math.rad(kickV2Angle * 2.3 + math.random(0, 360))
                        local rotCF = CFrame.new(etc.Root.Position)
                            * CFrame.Angles(rp, rad, rr)
                        BodyGyro.CFrame = rotCF

                        local totalMass = 0
                        for _, part in pairs(etc.TargetPLR.Character:GetDescendants()) do
                            if part:IsA("BasePart") then
                                totalMass = totalMass + part.AssemblyMass
                            end
                        end
                        BodyForce.Force = Vector3.new(0, totalMass * workspace.Gravity, 0)

                        BodyPos.Position = hrp.Position + Vector3.new(0, 15, -10)

                        if (etc.Root.Position.Y <= hrp.Position.Y + 15) and etc["TargetPLR"].IsHeld.Value then
                            for _, v in pairs(etc.TargetPLR.Character:GetChildren()) do
                                if v:IsA("Part") then
                                    v.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 15, -10))
                                end
                            end
                        end

                        etc["Root"].AssemblyAngularVelocity, etc["Root"].AssemblyLinearVelocity = Vector3.zero, Vector3.zero
                        etc.Hum.PlatformStand = true
                        etc.Hum.Sit = true

                        local fixPos = hrp.Position + Vector3.new(0, 15, -10)
                        if BodyPos then BodyPos.Position = fixPos end

                        -- 1フレーム目: UNSNO,SNO,SNO,UNSNO
                        local rootCF = etc["Root"].CFrame
                        etc["Root"].AssemblyLinearVelocity = Vector3.zero
                        etc["Root"].AssemblyAngularVelocity = Vector3.zero
                        DestroyGrabLine:FireServer(etc["Root"])
                        SetNetworkOwner:FireServer(etc["Root"], rootCF)
                        SetNetworkOwner:FireServer(etc["Root"], rootCF)
                        DestroyGrabLine:FireServer(etc["Root"])
                        RunService.RenderStepped:Wait()
                        -- 2フレーム目: SNO×1
                        etc["Root"].AssemblyLinearVelocity = Vector3.zero
                        etc["Root"].AssemblyAngularVelocity = Vector3.zero
                        SetNetworkOwner:FireServer(etc["Root"], etc["Root"].CFrame)
                        RunService.RenderStepped:Wait()
                        -- 3フレーム目: UNSNO×1,SNO×1
                        DestroyGrabLine:FireServer(etc["Root"])
                        SetNetworkOwner:FireServer(etc["Root"], etc["Root"].CFrame)
                        RunService.RenderStepped:Wait()
                        -- 4フレーム目: UNSNO×1
                        DestroyGrabLine:FireServer(etc["Root"])
                        RunService.RenderStepped:Wait()
                        -- 5フレーム目: SNO×1
                        etc["Root"].AssemblyLinearVelocity = Vector3.zero
                        etc["Root"].AssemblyAngularVelocity = Vector3.zero
                        SetNetworkOwner:FireServer(etc["Root"], etc["Root"].CFrame)
                        RunService.RenderStepped:Wait()

                        -- パレットのスポーン確認（パレットループ側で回転・配置を行うのでここは存在確認のみ）
                        if bool.DoRagdoll then
                            Pallete = inv:FindFirstChild("RagdollPalete")
                            if not Pallete then
                                Pallete = SpawnPallete()
                            end
                        end

                    else
                        if not etc["Head"] or not etc["Hum"] or etc["Hum"].Health == 0 then
                            etc.TargetPLR.CharacterAdded:Wait()
                            etc.Head = FWD(etc.TargetPLR.Character, "Head", 5)
                            etc.Hum = FWD(etc.TargetPLR.Character, "Humanoid", 5)
                            BodyPos = Instance.new("BodyPosition")
                            BodyPos.Name = "KickBodyPos"
                            BodyPos.MaxForce = Vector3.new(Huge())
                            BodyPos.Parent = etc.Root
                            BodyPos.P = 300000
                            BodyPos.D = 30000
                            BodyPos.Position = hrp.Position + Vector3.new(0, 15, -10)
                        end

                        local oldCF = hrp.CFrame
                        while (etc["Head"] and etc["Hum"] and etc['Hum'].Health ~= 0) and task.wait(0.01) and bool.LoopGrabKickV2 do
                            etc["TargetPLR"] = selectedPlrName and Players:FindFirstChild(selectedPlrName)
                            if not etc["TargetPLR"] then break end
                            if etc["TargetPLR"].InPlot.Value then continue end
                            etc["Head"] = etc["TargetPLR"].Character and etc["TargetPLR"].Character:FindFirstChild("Head")
                            etc["Hum"] = etc["TargetPLR"].Character and etc["TargetPLR"].Character:FindFirstChild("Humanoid")
                            if not (etc["Head"]) or not (etc["Hum"]) then break end
                            char:PivotTo(etc["Head"].CFrame * CFrame.new(0, 10, 0))
                            sno(etc["Head"])
                            if CheckForPartOwner(etc["Head"]) then
                                break
                            end
                        end

                        hrp.CFrame = oldCF

                        if etc.Head and CheckForPartOwner(etc.Head) then
                            for _, v in pairs(etc.TargetPLR.Character:GetChildren()) do
                                if v:IsA("Part") then
                                    v.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 15, -10))
                                end
                            end
                        end
                    end
                end

                if etc["Root"] then
                    for _, v in pairs(etc["Root"]:GetChildren()) do
                        if v.Name == "KickBodyPos" or v.Name == "KickAntiGravity" or v.Name == "KickBodyGyro" then
                            v:Destroy()
                        end
                    end
                end
            end)
        end
    end
})

