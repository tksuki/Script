-- 1. CFrame Walk Speed
RunService.Heartbeat:Connect(function(delta)
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not hrp then return end

    local isSeatedState = (humanoid:GetState() == Enum.HumanoidStateType.Seated) or (humanoid.SeatPart ~= nil)
    local isSpinOn = Toggles.SpinToggle and Toggles.SpinToggle.Value
    local isUserWalkSpeedOn = Toggles.WalkSpeedToggle and Toggles.WalkSpeedToggle.Value
    local shouldApplySecretSpeed = isSpinOn and isSeatedState and not isUserWalkSpeedOn

    if isUserWalkSpeedOn then
        local moveDirection = humanoid.MoveDirection
        if moveDirection.Magnitude > 0 then
            hrp.CFrame = hrp.CFrame + (moveDirection * Options.WalkSpeedSlider.Value * delta)
        end
    elseif shouldApplySecretSpeed then
        local moveDirection = humanoid.MoveDirection
        if moveDirection.Magnitude > 0 then
            hrp.CFrame = hrp.CFrame + (moveDirection * 16 * delta)
        end
    end
end)

