-- [Sticky ESP] SpawnedInToysフォルダ内で、StickyPartを含むオブジェクトのPartを発光＋枠付きで可視化
local STICKY_NAME = "StickyPart"
local TOYS_FOLDER_KEY = "SpawnedInToys"
local stickyToys = {} -- [toyオブジェクト] = { parts = { [part] = {adorn, box} }, last = 0 }

-- StickyPartが入っているオブジェクト（SpawnedInToysフォルダの直下の子）を探す
local function findToy(inst)
    local p = inst
    while p and p.Parent and p.Parent ~= workspace do
        local par = p.Parent
        if par:IsA("Folder") and string.find(par.Name, TOYS_FOLDER_KEY, 1, true) then
            return p
        end
        p = par
    end
    return nil
end

local function removePartESP(d, part)
    local e = d.parts[part]
    if not e then return end
    e.adorn:Destroy()
    e.box:Destroy()
    d.parts[part] = nil
end

local function clearToyVisuals(d)
    for part in pairs(d.parts) do removePartESP(d, part) end
    d.last = 0
end

local function removeToy(toy)
    local d = stickyToys[toy]
    if not d then return end
    clearToyVisuals(d)
    stickyToys[toy] = nil
end

local function trackSticky(inst)
    if inst.Name == STICKY_NAME then
        local toy = findToy(inst)
        if toy and toy ~= inst and toy.Name ~= "CreatureBlobman" and not stickyToys[toy] then
            stickyToys[toy] = { parts = {}, last = 0 }
        end
    end
end

for _, d in ipairs(workspace:GetDescendants()) do trackSticky(d) end
workspace.DescendantAdded:Connect(trackSticky)
workspace.DescendantRemoving:Connect(function(inst)
    if stickyToys[inst] then
        removeToy(inst)
        return
    end
    for _, d in pairs(stickyToys) do
        if d.parts[inst] then removePartESP(d, inst) end
    end
end)

RunService.RenderStepped:Connect(function()
    if not (Toggles.StickyESPToggle and Toggles.StickyESPToggle.Value) then
        for _, d in pairs(stickyToys) do clearToyVisuals(d) end
        return
    end

    local now = tick()
    local col = getDynamicColor(0)

    for toy, d in pairs(stickyToys) do
        -- 0.5秒ごとにPart一覧を更新
        if now - d.last > 0.5 then
            d.last = now
            if not toy:IsDescendantOf(workspace) or not toy:FindFirstChild(STICKY_NAME, true) then
                removeToy(toy)
                continue
            end

            d.mine = isMine(toy)
            local seen = {}
            for _, desc in ipairs(toy:GetDescendants()) do
                if desc:IsA("BasePart") and desc.Name ~= STICKY_NAME then
                    seen[desc] = true
                    if not d.parts[desc] then
                        local adorn = Instance.new("BoxHandleAdornment")
                        adorn.Adornee = desc
                        adorn.AlwaysOnTop = true
                        adorn.ZIndex = 1
                        adorn.Transparency = 0.35 -- 発光した見た目
                        adorn.Size = desc.Size
                        adorn.Parent = ESPFolder

                        local box = Instance.new("SelectionBox")
                        box.Adornee = desc
                        box.LineThickness = 0.04
                        box.SurfaceTransparency = 1
                        box.Parent = ESPFolder

                        d.parts[desc] = { adorn = adorn, box = box }
                    end
                end
            end
            for part in pairs(d.parts) do
                if not seen[part] then removePartESP(d, part) end
            end
        end

        local c = d.mine and MINE_COLOR or col
        for part, e in pairs(d.parts) do
            e.adorn.Size = part.Size
            e.adorn.Color3 = c
            e.box.Color3 = c
        end
    end
end)

-- [Blobman ESP] CreatureBlobman を探して可視化（Highlightを使わないので31個制限なし）
local BLOB_NAME = "CreatureBlobman"
local blobFound = {} -- [instance] = { parts = { [part] = {adorn, box} }, last = 0, mine = false }

local function removeBlob(inst)
    local d = blobFound[inst]
    if not d then return end
    for part in pairs(d.parts) do removePartESP(d, part) end
    blobFound[inst] = nil
end

local function hasBlobAncestor(inst)
    local p = inst.Parent
    while p and p ~= workspace do
        if p.Name == BLOB_NAME then return true end
        p = p.Parent
    end
    return false
end

local function trackBlob(inst)
    if inst.Name == BLOB_NAME and (inst:IsA("Model") or inst:IsA("BasePart"))
        and not blobFound[inst] and not hasBlobAncestor(inst) then
        blobFound[inst] = { parts = {}, last = 0, mine = false }
    end
end

for _, d in ipairs(workspace:GetDescendants()) do trackBlob(d) end
workspace.DescendantAdded:Connect(trackBlob)
workspace.DescendantRemoving:Connect(function(inst)
    if blobFound[inst] then
        removeBlob(inst)
        return
    end
    for _, d in pairs(blobFound) do
        if d.parts[inst] then removePartESP(d, inst) end
    end
end)

RunService.RenderStepped:Connect(function()
    if not (Toggles.BlobmanESPToggle and Toggles.BlobmanESPToggle.Value) then
        for _, d in pairs(blobFound) do
            for part in pairs(d.parts) do removePartESP(d, part) end
            d.last = 0
        end
        return
    end

    local now = tick()
    local col = getDynamicColor(0)

    for inst, d in pairs(blobFound) do
        if now - d.last > 0.5 then
            d.last = now
            if not inst:IsDescendantOf(workspace) then
                removeBlob(inst)
                continue
            end
            if hasBlobAncestor(inst) then
                removeBlob(inst)
                continue
            end
            d.mine = isMine(inst)

            -- CreatureBlobman自体は対象外、中の「見えているPart」だけを発光させる
            local seen = {}
            for _, desc in ipairs(inst:GetDescendants()) do
                if desc:IsA("BasePart") and desc.Name ~= BLOB_NAME and desc.Transparency < 0.9 then
                    seen[desc] = true
                    if not d.parts[desc] then
                        local adorn = Instance.new("BoxHandleAdornment")
                        adorn.Adornee = desc
                        adorn.AlwaysOnTop = true
                        adorn.ZIndex = 1
                        adorn.Transparency = 0.35
                        adorn.Size = desc.Size
                        adorn.Parent = ESPFolder

                        local box = Instance.new("SelectionBox")
                        box.Adornee = desc
                        box.LineThickness = 0.04
                        box.SurfaceTransparency = 1
                        box.Parent = ESPFolder

                        d.parts[desc] = { adorn = adorn, box = box }
                    end
                end
            end
            for part in pairs(d.parts) do
                if not seen[part] then removePartESP(d, part) end
            end
        end

        local c = d.mine and MINE_COLOR or col
        for part, e in pairs(d.parts) do
            e.adorn.Size = part.Size
            e.adorn.Color3 = c
            e.box.Color3 = c
        end
    end
end)

