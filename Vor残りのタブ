-- 4. Noclip
local lastVehicle = nil
RunService.Stepped:Connect(function()
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local currentVehicle = humanoid and humanoid.SeatPart and humanoid.SeatPart.Parent or nil

    if Toggles.NoclipToggle and Toggles.NoclipToggle.Value then
        if character then
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
            if currentVehicle then
                lastVehicle = currentVehicle
                for _, part in ipairs(currentVehicle:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        end
    end

    if lastVehicle and (not currentVehicle or currentVehicle ~= lastVehicle) then
        for _, part in ipairs(lastVehicle:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = true end
        end
        lastVehicle = nil
    end
    if currentVehicle then lastVehicle = currentVehicle end
end)

-- 5. Spin
RunService.RenderStepped:Connect(function()
    if Toggles.SpinToggle and Toggles.SpinToggle.Value then
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        if hrp and humanoid then
            local spinSpeed = Options.SpinSpeedSlider.Value
            if humanoid.SeatPart then
                local vehicleModel = humanoid.SeatPart.Parent
                if vehicleModel and vehicleModel:IsA("Model") and vehicleModel.PrimaryPart then
                    vehicleModel:SetPrimaryPartCFrame(vehicleModel.PrimaryPart.CFrame * CFrame.Angles(0, math.rad(spinSpeed * 0.5), 0))
                else
                    humanoid.SeatPart.CFrame = humanoid.SeatPart.CFrame * CFrame.Angles(0, math.rad(spinSpeed * 0.5), 0)
                end
            else
                hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(spinSpeed * 0.5), 0)
            end
        end
    end
end)

-- 6. Third Person
local thirdPersonInitialized = false
RunService.Heartbeat:Connect(function()
    if Toggles.ThirdPersonToggle and Toggles.ThirdPersonToggle.Value then
        pcall(function()
            LocalPlayer.CameraMaxZoomDistance = 999999999
            LocalPlayer.CameraMode = Enum.CameraMode.Classic
        end)
        if not thirdPersonInitialized then
            thirdPersonInitialized = true
            pcall(function()
                local PopperClient = LocalPlayer:WaitForChild("PlayerScripts").PlayerModule.CameraModule.ZoomController.Popper
                for _, v in next, getgc() do
                    if getfenv(v).script == PopperClient and typeof(v) == "function" then
                        for i2, v2 in next, debug.getconstants(v) do
                            if tonumber(v2) == 0.25 then
                                debug.setconstant(v, i2, 0)
                            elseif tonumber(v2) == 0 then
                                debug.setconstant(v, i2, 0.25)
                            end
                        end
                    end
                end
            end)
        end
    elseif thirdPersonInitialized then
        -- オフにした時に一回だけ実行
        thirdPersonInitialized = false
        pcall(function() LocalPlayer.CameraMaxZoomDistance = 0 end)
    end
end)

