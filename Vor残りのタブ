local espCache = {}

local function getDynamicColor(index)
    local mode = Options.ESPColorMode.Value
    if mode == 'Rainbow' then
        return Color3.fromHSV(((tick() + index * 0.2) % 5) / 5, 1, 1)
    elseif mode == 'Gradient' then
        local alpha = (math.sin(tick() * 2 + index * 0.5) + 1) / 2
        return Options.ESPSolidColor.Value:Lerp(Options.ESPGradientColor.Value, alpha)
    end
    return Options.ESPSolidColor.Value
end

local function newLine()
    local f = Instance.new("Frame")
    f.AnchorPoint = Vector2.new(0.5, 0.5)
    f.BorderSizePixel = 0
    f.Visible = false
    f.Parent = ESPGui
    return f
end

local function setLine(f, a, b, col)
    local d = b - a
    f.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
    f.Size = UDim2.fromOffset(d.Magnitude, 1.5)
    f.Rotation = math.deg(math.atan2(d.Y, d.X))
    f.BackgroundColor3 = col
    f.Visible = true
end

local function createESPForPlayer(player)
    if player == LocalPlayer or espCache[player] then return end
    espCache[player] = {
        billboard = nil, imgLabel = nil, nameLabel = nil, userLabel = nil,
        lines = {}, boxLines = {}, tracerLine = newLine(),
    }
end

local function removeESPForPlayer(player)
    local data = espCache[player]
    if not data then return end
    if data.billboard then data.billboard:Destroy() end
    if data.tracerLine then data.tracerLine:Destroy() end
    for _, l in pairs(data.lines) do l:Destroy() end
    for _, l in pairs(data.boxLines) do l:Destroy() end
    espCache[player] = nil
end

Players.PlayerAdded:Connect(createESPForPlayer)
Players.PlayerRemoving:Connect(removeESPForPlayer)
for _, p in ipairs(Players:GetPlayers()) do createESPForPlayer(p) end

local R15Joints = {
    {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
    {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
    {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
    {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
    {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"},
}
local R6Joints = {
    {"Head", "Torso"}, {"Torso", "Left Arm"}, {"Torso", "Right Arm"},
    {"Torso", "Left Leg"}, {"Torso", "Right Leg"},
}

local function hideAll(data)
    if data.billboard then data.billboard.Enabled = false end
    data.tracerLine.Visible = false
    for _, l in ipairs(data.boxLines) do l.Visible = false end
    for _, l in ipairs(data.lines) do l.Visible = false end
end

local function updatePlayerESP(player, data, col)
    local character = player.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local head = character and character:FindFirstChild("Head")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if not (character and hrp and head and humanoid and humanoid.Health > 0) then
        hideAll(data)
        return
    end

    -- 1. Name & Icon (BillboardGui + TextLabel)
    if Toggles.PlayerESPToggle.Value then
        if not data.billboard then
            local bb = Instance.new("BillboardGui")
            bb.Name = "PlayerESP"
            bb.Size = UDim2.new(0, 220, 0, 80)
            bb.StudsOffset = Vector3.new(0, 3.2, 0)
            bb.AlwaysOnTop = true
            bb.ResetOnSpawn = false
            bb.LightInfluence = 0

            local img = Instance.new("ImageLabel")
            img.Name = "Icon"
            img.Size = UDim2.new(0, 30, 0, 30)
            img.Position = UDim2.new(0.5, -15, 0, 0)
            img.BackgroundTransparency = 1
            img.Parent = bb

            -- 表示名
            local nameLabel = Instance.new("TextLabel")
            nameLabel.Name = "DisplayName"
            nameLabel.Size = UDim2.new(1, 0, 0, 24)
            nameLabel.Position = UDim2.new(0, 0, 0, 32)
            nameLabel.BackgroundTransparency = 1
            nameLabel.Font = Enum.Font.GothamBold
            nameLabel.TextSize = 16
            nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            nameLabel.TextStrokeTransparency = 0
            nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
            nameLabel.TextXAlignment = Enum.TextXAlignment.Center
            nameLabel.TextYAlignment = Enum.TextYAlignment.Center
            nameLabel.Parent = bb

            -- ユーザー名
            local userLabel = Instance.new("TextLabel")
            userLabel.Name = "Username"
            userLabel.Size = UDim2.new(1, 0, 0, 20)
            userLabel.Position = UDim2.new(0, 0, 0, 56)
            userLabel.BackgroundTransparency = 1
            userLabel.Font = Enum.Font.Gotham
            userLabel.TextSize = 13
            userLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
            userLabel.TextStrokeTransparency = 0
            userLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
            userLabel.TextXAlignment = Enum.TextXAlignment.Center
            userLabel.TextYAlignment = Enum.TextYAlignment.Center
            userLabel.Parent = bb

            data.billboard, data.imgLabel = bb, img
            data.nameLabel, data.userLabel = nameLabel, userLabel
            bb.Parent = ESPFolder

            task.spawn(function()
                local ok, content = pcall(function()
                    return Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
                end)
                if ok and img.Parent then img.Image = content end
            end)
        end
        data.billboard.Adornee = head
        data.billboard.Enabled = true
        data.nameLabel.Text = player.DisplayName
        data.userLabel.Text = "@" .. player.Name
        data.nameLabel.TextColor3 = col -- 表示名はESPカラーに追従
    elseif data.billboard then
        data.billboard.Enabled = false
    end

    local rootPos, rootOn = Camera:WorldToViewportPoint(hrp.Position)
    local inFront = rootPos.Z > 0

    -- 2. Tracer
    if Toggles.TracerESPToggle.Value and inFront then
        local vs = Camera.ViewportSize
        local origin = Vector2.new(vs.X / 2, vs.Y) -- 一人称: 画面下部中央
        local zoom = (Camera.CFrame.Position - Camera.Focus.Position).Magnitude
        if zoom > 1 then -- 少しでもズームしたら自分のHRPから
            local lchar = LocalPlayer.Character
            local lhrp = lchar and lchar:FindFirstChild("HumanoidRootPart")
            if lhrp then
                local lp = Camera:WorldToViewportPoint(lhrp.Position)
                if lp.Z > 0 then origin = Vector2.new(lp.X, lp.Y) end
            end
        end
        setLine(data.tracerLine, origin, Vector2.new(rootPos.X, rootPos.Y), col)
    else
        data.tracerLine.Visible = false
    end

    -- 3. Box
    if Toggles.BoxESPToggle.Value then
        if #data.boxLines == 0 then
            for i = 1, 4 do data.boxLines[i] = newLine() end
        end
        local topPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.8, 0))
        local botPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
        if inFront and topPos.Z > 0 and botPos.Z > 0 then
            local height = math.abs(botPos.Y - topPos.Y)
            local width = height / 2
            local cx = rootPos.X
            local tl = Vector2.new(cx - width / 2, topPos.Y)
            local tr = Vector2.new(cx + width / 2, topPos.Y)
            local bl = Vector2.new(cx - width / 2, botPos.Y)
            local br = Vector2.new(cx + width / 2, botPos.Y)
            local b = data.boxLines
            setLine(b[1], tl, tr, col)
            setLine(b[2], tr, br, col)
            setLine(b[3], br, bl, col)
            setLine(b[4], bl, tl, col)
        else
            for _, l in ipairs(data.boxLines) do l.Visible = false end
        end
    else
        for _, l in ipairs(data.boxLines) do l.Visible = false end
    end

    -- 4. Skeleton
    if Toggles.SkeletonESPToggle.Value then
        local joints = character:FindFirstChild("UpperTorso") and R15Joints or R6Joints
        for i = #data.lines + 1, #R15Joints do data.lines[i] = newLine() end

        for i, line in ipairs(data.lines) do
            local j = joints[i]
            local p1 = j and character:FindFirstChild(j[1])
            local p2 = j and character:FindFirstChild(j[2])
            if p1 and p2 then
                local v1 = Camera:WorldToViewportPoint(p1.Position)
                local v2 = Camera:WorldToViewportPoint(p2.Position)
                if v1.Z > 0 and v2.Z > 0 then
                    setLine(line, Vector2.new(v1.X, v1.Y), Vector2.new(v2.X, v2.Y), col)
                else
                    line.Visible = false
                end
            else
                line.Visible = false
            end
        end
    else
        for _, l in ipairs(data.lines) do l.Visible = false end
    end
end

