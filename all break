local function Char()
    local Character = LocalPlayer.Character
    if not Character then return end
    return Character, Character:FindFirstChild("HumanoidRootPart"), Character:FindFirstChild("Humanoid")
end

local function getHRP()
    local _, hrp = Char()
    return hrp or LocalPlayer.CharacterAdded:Wait():WaitForChild("HumanoidRootPart")
end

local function getTargetBody(model)
    if not model then return nil end
    if model:FindFirstChild("Body") then return model.Body end
    if model:IsA("BasePart") then return model end
    return model:FindFirstChildWhichIsA("BasePart", true)
end

local function sno(part)
    if part then
        SetNetworkOwner:FireServer(part, part.CFrame)
    end
end

local function SpawnToy(ToyName)
    local InPlot = LocalPlayer:FindFirstChild("InPlot")
    local InOwnedPlot = LocalPlayer:FindFirstChild("InOwnedPlot")
    local CanSpawnToy = LocalPlayer:FindFirstChild("CanSpawnToy")

    if InPlot and InPlot.Value and InOwnedPlot and not InOwnedPlot.Value then
        InPlot:GetPropertyChangedSignal("Value"):Wait()
    end
    if CanSpawnToy and not CanSpawnToy.Value then
        CanSpawnToy:GetPropertyChangedSignal("Value"):Wait()
    end

    local hrp = getHRP()
    if not hrp then return nil end
    
    local SpawnCF = hrp.CFrame * CFrame.new(0, 14, 20)
    local Container = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")

    if not Container then return nil end

    local spawnedObject = nil
    local conn
    conn = Container.ChildAdded:Connect(function(child)
        if child.Name == ToyName then
            spawnedObject = child
            conn:Disconnect()
        end
    end)

    task.spawn(function()
        pcall(function()
            SpawnToyRemoteFunction:InvokeServer(ToyName, SpawnCF, Vector3.new(0, 0, 0))
        end)
    end)

    local start = tick()
    repeat task.wait(0.05) until spawnedObject or (tick() - start) > 3

    if conn then
        pcall(function() conn:Disconnect() end)
    end
    return spawnedObject
end

local function processNormalTargets(targetBodies, rootContainers)
    if #targetBodies == 0 then return end

    for i = 1, 12 do
        local toy = SpawnToy(SelectedToy)
        if toy then
            local stickyPart = toy:FindFirstChild("StickyPart")
            if stickyPart then
                sno(stickyPart)
                task.wait(0.1)
                
                for _, targetBody in ipairs(targetBodies) do
                    pcall(function()
                        StickyEvent:FireServer(stickyPart, targetBody, CFrame.new())
                    end)
                end
            end
        end
        task.wait(0.15)
    end
    
    for _, container in ipairs(rootContainers) do
        if container then
            for _, desc in ipairs(container:GetDescendants()) do
                if desc.Name == "FollowThisPart" then
                    if desc:FindFirstChild("AlignOrientation") then
                        desc.AlignOrientation.Enabled = false
                    end
                    if desc:FindFirstChild("AlignPosition") then
                        desc.AlignPosition.Enabled = false
                    end
                end
            end
        end
    end
end

local function getOceanTargetObject()
    local map = Workspace:FindFirstChild("Map")
    if not map then return nil end
    local alwaysHere = map:FindFirstChild("AlwaysHereTweenedObjects")
    if not alwaysHere then return nil end
    local ocean = alwaysHere:FindFirstChild("Ocean")
    if not ocean then return nil end
    local object = ocean:FindFirstChild("Object")
    if not object then return nil end
    local objectModel = object:FindFirstChild("ObjectModel")
    if not objectModel then return nil end

    local children = objectModel:GetChildren()
    local index = 17
    if index <= #children then
        local target = children[index]
        if target and target:IsA("BasePart") then
            return target, ocean
        end
    end
    return nil
end

local function GetTarget()
    if Mouse and Mouse.Target then return Mouse.Target end

    local size = Camera.ViewportSize
    local ray = Camera:ViewportPointToRay(size.X / 2, size.Y / 2)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude

    local character = Char()
    if character then
        params.FilterDescendantsInstances = {character}
    end

    local result = Workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
    return result and result.Instance
end

local function BreakPart(Part)
    if not Part or not Part:IsA('BasePart') or not DestroyToyRemote then return end

    local toy = SpawnToy(SelectedToy)
    local StickyPart = toy and toy:WaitForChild("StickyPart", 0.5)
    
    if not StickyPart then return end
    sno(StickyPart)

    local Start = tick()
    repeat task.wait() until (StickyPart:FindFirstChild("PartOwner") and StickyPart.PartOwner.Value == LocalPlayer.Name) or (tick() - Start) > 0.5

    if (tick() - Start) > 0.5 then return DestroyToyRemote:FireServer(toy) end
    StickyEvent:FireServer(StickyPart, Part, CFrame.new(1e15, 1e15, 1e15))
end

local function StickToUFO(ufoName)
    local alwaysHere = Workspace.Map.AlwaysHereTweenedObjects
    if not alwaysHere then return end
    
    local ufo = alwaysHere:FindFirstChild(ufoName)
    if not ufo or not ufo:FindFirstChild("Object") or not ufo.Object:FindFirstChild("ObjectModel") then return end
    
    local body = getTargetBody(ufo.Object.ObjectModel)
    if body then
        processNormalTargets({body}, {ufo})
    end
end

local function StickToRock()
    local alwaysHere = Workspace.Map.AlwaysHereTweenedObjects
    
    local smlDebris = alwaysHere:FindFirstChild(SelectedSmlDebris)
    if smlDebris then
        local rock = smlDebris:FindFirstChild("Rock", true)
        if rock then
            local body = getTargetBody(rock)
            if body then processNormalTargets({body}, {smlDebris}) end
        end
    end

    task.wait(0.5)

    local lrgDebris = alwaysHere:FindFirstChild(SelectedLrgDebris)
    if lrgDebris then
        local objModel = lrgDebris:FindFirstChild("ObjectModel", true)
        if objModel then
            local rock = objModel:FindFirstChild("Rock")
            if rock then
                local body = getTargetBody(rock)
                if body then processNormalTargets({body}, {lrgDebris}) end
            end
        end
    end
end

local function StickToCaveCart()
    local alwaysHere = Workspace.Map.AlwaysHereTweenedObjects
    if not alwaysHere then return end
    
    local caveCart = alwaysHere:FindFirstChild("CaveCart")
    if not caveCart then return end
    
    local object = caveCart:FindFirstChild("Object")
    if not object then return end
    
    local objectModel = object:FindFirstChild("ObjectModel")
    if not objectModel then return end
    
    local topPart = nil
    local children = objectModel:GetChildren()
    for _, child in ipairs(children) do
        if child:IsA("BasePart") then
            topPart = child
            break
        end
    end
    
    if topPart then
        processNormalTargets({topPart}, {caveCart})
    end
end

local function StickToTrain()
    local alwaysHere = Workspace.Map.AlwaysHereTweenedObjects
    if not alwaysHere then return end
    
    local train = alwaysHere:FindFirstChild("Train")
    if not train then return end
    
    local object = train:FindFirstChild("Object")
    if not object then return end
    
    local objectModel = object:FindFirstChild("ObjectModel")
    if not objectModel then return end
    
    local topPart = nil
    local children = objectModel:GetChildren()
    for _, child in ipairs(children) do
        if child:IsA("BasePart") then
            topPart = child
            break
        end
    end
    
    if topPart then
        processNormalTargets({topPart}, {train})
    end
end

