BreakTab:CreateToggle({
    Name = "Stick to Ocean",
    CurrentValue = false,
    Flag = "OceanTgl",
    Callback = function(Value)
        if not Value then return end
        task.spawn(function()
            local targetObject, oceanObject = getOceanTargetObject()
            if targetObject then
                targetObject.Anchored = false
                local anchorConn = targetObject:GetPropertyChangedSignal("Anchored"):Connect(function()
                    if targetObject.Anchored then pcall(function() targetObject.Anchored = false end) end
                end)

                for i = 1, 12 do
                    local toy = SpawnToy(SelectedToy)
                    if toy then
                        local sp = toy:FindFirstChild("StickyPart")
                        if sp then
                            sno(sp)
                            local bp = Instance.new("BodyPosition")
                            bp.Position = Vector3.new(math.random(-100, 100), 1e3, math.random(-100, 100))
                            bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                            bp.Parent = sp

                            task.wait(0.1)
                            pcall(function()
                                StickyEvent:FireServer(sp, targetObject, CFrame.new(0, -2.14748365e+09, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1))
                            end)
                        end
                    end
                    task.wait(0.15)
                end

                task.wait(0.5)
                if oceanObject then pcall(function() oceanObject.Collision = false end) end
                if anchorConn then anchorConn:Disconnect() end
            end
            Rayfield.Flags["OceanTgl"]:Set(false)
        end)
    end
})

