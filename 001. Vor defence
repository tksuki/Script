-- ===== Ragdoll Type: 元の RagdollGucci の中身をそのまま関数化 =====
local function startGucciRagdoll()
    if Config.active then
        Config.runId = Config.runId + 1
        Config.active = false
        Config.seatOccupied = false
        Config.monitoring = false
        Config.blobRef = nil
        Config.ragdollLoopActive = false
        if Config.ragdollTask then
            task.cancel(Config.ragdollTask)
            Config.ragdollTask = nil
        end
        Config.permRagActive = false
        if Config.permRagTask then
            task.cancel(Config.permRagTask)
            Config.permRagTask = nil
        end
        local char = localPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root then
            local remote = Config.remoteRef
            if not remote then
                local charEv = service.ReplicatedStorage:FindFirstChild("CharacterEvents")
                remote = (charEv and charEv:FindFirstChild("RagdollRemote"))
                        or service.ReplicatedStorage:FindFirstChild("RagdollRemote")
                        or game:FindFirstChild("RagdollRemote", true)
                if remote then Config.remoteRef = remote end
            end
            if remote and remote:IsA("RemoteEvent") then
                pcall(function() remote:FireServer(root, 0) end)
            end
        end
        local toyFolder = service.Workspace:FindFirstChild(localPlayer.Name .. 'SpawnedInToys')
        if toyFolder then
            for _, child in pairs(toyFolder:GetChildren()) do
                if child.Name == "Gucci" or child.Name == "CreatureBlobman" then
                    pcall(function() child:Destroy() end)
                end
            end
        end
        task.wait(0.3)
    end

    Config.runId = Config.runId + 1
    local currentRunId = Config.runId
    Config.setupDone = false
    Config.seatOccupied = false
    Config.monitoring = false

    local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
    local humanoid = character:FindFirstChild("Humanoid") or character:WaitForChild("Humanoid", 3)
    local rootPart = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 3)
    if not (humanoid and rootPart) then return end
    pcall(function() humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false) end)

    task.spawn(function()
        local startTime = tick()
        while tick() - startTime < 0.8 and currentRunId == Config.runId do
            if rootPart and rootPart.Parent then
                pcall(function()
                    rootPart.Velocity = Vector3.zero
                    rootPart.RotVelocity = Vector3.zero
                end)
            end
            service.RunService.Heartbeat:Wait()
        end
    end)

    local toyFolder = service.Workspace:FindFirstChild(localPlayer.Name .. 'SpawnedInToys')
    local blob = nil
    if toyFolder then
        local connection
        connection = toyFolder.ChildAdded:Connect(safe(function(child)
            if child.Name == "CreatureBlobman" then
                blob = child
                connection:Disconnect()
            end
        end))
        task.spawn(function()
            local menuToys = service.ReplicatedStorage:FindFirstChild("MenuToys")
            if menuToys and menuToys:FindFirstChild("SpawnToyRemoteFunction") then
                pcall(function()
                    menuToys.SpawnToyRemoteFunction:InvokeServer(
                        "CreatureBlobman",
                        rootPart.CFrame * CFrame.new(0, 0, -5),
                        Vector3.new(0, -15.716, 0)
                    )
                end)
            end
        end)
        local spawnStart = tick()
        while not blob and tick() - spawnStart < 4 do
            service.RunService.Heartbeat:Wait()
        end
        if connection then connection:Disconnect() end
    end
    if not blob then return end

    local head = blob:FindFirstChild("Head") or blob:WaitForChild("Head", 3)
    local hitbox = blob:FindFirstChild("GrabbableHitbox") or blob:WaitForChild("GrabbableHitbox", 3)
    local seat = blob:FindFirstChild("VehicleSeat") or blob:WaitForChild("VehicleSeat", 3)

    if seat and not Config.monitoring then
        Config.monitoring = true
        Config.blobRef = blob
        task.spawn(function()
            while Config.active and seat and seat.Parent and blob and blob.Parent do
                local hum = localPlayer.Character and localPlayer.Character:FindFirstChild("Humanoid")
                if hum and seat.Occupant == hum then
                    if not Config.seatOccupied then
                        Config.seatOccupied = true
                        if not Config.ragdollLoopActive then
                            Config.ragdollLoopActive = true
                            if Config.ragdollTask then task.cancel(Config.ragdollTask) end
                            Config.ragdollTask = task.spawn(function()
                                while Config.ragdollLoopActive do
                                    local char = localPlayer.Character
                                    if char then
                                        local h = char:FindFirstChild("Humanoid")
                                        local r = char:FindFirstChild("HumanoidRootPart")
                                        if h and r and h.Health > 0 then
                                            pcall(function()
                                                h.Sit = true
                                                h:ChangeState(Enum.HumanoidStateType.Running)
                                            end)
                                            local cam = service.Workspace.CurrentCamera
                                            if cam then
                                                local look = cam.CFrame.LookVector
                                                pcall(function()
                                                    r.CFrame = CFrame.new(r.Position, r.Position + Vector3.new(look.X, 0, look.Z))
                                                end)
                                            end
                                        end
                                    end
                                    task.wait()
                                end
                            end)
                        end
                        if not Config.permRagActive then
                            Config.permRagActive = true
                            if Config.permRagTask then task.cancel(Config.permRagTask) end
                            Config.permRagTask = task.spawn(function()
                                while Config.permRagActive do
                                    local char = localPlayer.Character
                                    local r = char and char:FindFirstChild("HumanoidRootPart")
                                    if r then
                                        local remote = Config.remoteRef
                                        if not remote then
                                            local charEv = service.ReplicatedStorage:FindFirstChild("CharacterEvents")
                                            remote = (charEv and charEv:FindFirstChild("RagdollRemote"))
                                                    or service.ReplicatedStorage:FindFirstChild("RagdollRemote")
                                                    or game:FindFirstChild("RagdollRemote", true)
                                            if remote then Config.remoteRef = remote end
                                        end
                                        if remote and remote:IsA("RemoteEvent") then
                                            pcall(function() remote:FireServer(r, 1) end)
                                        end
                                    end
                                    task.wait(0.7)
                                end
                            end)
                        end
                        pcall(function()
                            seat.Disabled = true
                            seat.CanTouch = false
                            seat.CanQuery = false
                            for _, child in pairs(seat:GetChildren()) do
                                if child:IsA("Weld") or child.Name == "SeatWeld" then
                                    child:Destroy()
                                end
                            end
                        end)
                        if blob then
                            for _, desc in pairs(blob:GetDescendants()) do
                                if desc:IsA("BasePart") then
                                    pcall(function()
                                        desc.CanCollide = false
                                        desc.CanTouch = false
                                        desc.CanQuery = false
                                        desc.Massless = true
                                    end)
                                end
                            end
                        end
                    end
                else
                    if Config.seatOccupied then
                        Config.seatOccupied = false
                    end
                end
                task.wait(0.1)
            end
            Config.monitoring = false
            Config.seatOccupied = false
            Config.blobRef = nil
        end)
    end

    task.spawn(function()
        local grabEvents = service.ReplicatedStorage:FindFirstChild("GrabEvents")
        local setNetOwner = function(part)
            if part and part:IsA("BasePart") and grabEvents and grabEvents:FindFirstChild("SetNetworkOwner") then
                pcall(function() grabEvents.SetNetworkOwner:FireServer(part, part.CFrame) end)
            end
        end
        local startTime = tick()
        while currentRunId == Config.runId and not Config.setupDone and tick() - startTime < 1.2 do
            if hitbox and hitbox.Parent then setNetOwner(hitbox) end
            if head and head.Parent then setNetOwner(head) end
            if seat and seat.Parent and seat.Occupant ~= humanoid then
                pcall(function() seat:Sit(humanoid) end)
            end
            local characterEvents = service.ReplicatedStorage:FindFirstChild("CharacterEvents")
            if characterEvents and characterEvents:FindFirstChild("RagdollRemote") then
                pcall(function() characterEvents.RagdollRemote:FireServer(rootPart, 0.09) end)
            end
            service.RunService.Heartbeat:Wait()
        end
    end)

    task.wait(0.45)
    if currentRunId ~= Config.runId then
        if blob and blob.Parent then blob:Destroy() end
        return
    end
    Config.setupDone = true
    pcall(function() humanoid.Sit = false end)
    pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.Jumping) end)
    task.wait(0.05)
    local characterEvents = service.ReplicatedStorage:FindFirstChild("CharacterEvents")
    if characterEvents and characterEvents:FindFirstChild("RagdollRemote") then
        pcall(function() characterEvents.RagdollRemote:FireServer(rootPart, false) end)
    end
    pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    blob.Name = "Gucci"
    for _, desc in pairs(blob:GetDescendants()) do
        if desc:IsA("BasePart") then
            pcall(function()
                desc.CanCollide = false
                desc.CanTouch = false
                desc.CanQuery = false
                desc.Massless = true
            end)
        end
    end
    task.spawn(function()
        while currentRunId == Config.runId and head and head.Parent do
            pcall(function()
                head.CFrame = CFrame.new(head.Position.X, 100000, head.Position.Z)
            end)
            service.RunService.Heartbeat:Wait()
        end
    end)
    Config.active = true
end

local function stopGucciRagdoll()
    Config.runId = Config.runId + 1
    Config.active = false
    Config.seatOccupied = false
    Config.monitoring = false
    Config.blobRef = nil
    Config.ragdollLoopActive = false
    if Config.ragdollTask then
        task.cancel(Config.ragdollTask)
        Config.ragdollTask = nil
    end
    Config.permRagActive = false
    if Config.permRagTask then
        task.cancel(Config.permRagTask)
        Config.permRagTask = nil
    end
    local char = localPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        local remote = Config.remoteRef
        if not remote then
            local charEv = service.ReplicatedStorage:FindFirstChild("CharacterEvents")
            remote = (charEv and charEv:FindFirstChild("RagdollRemote"))
                    or service.ReplicatedStorage:FindFirstChild("RagdollRemote")
                    or game:FindFirstChild("RagdollRemote", true)
            if remote then Config.remoteRef = remote end
        end
        if remote and remote:IsA("RemoteEvent") then
            pcall(function() remote:FireServer(root, 0) end)
        end
    end
    local toyFolder = service.Workspace:FindFirstChild(localPlayer.Name .. 'SpawnedInToys')
    if toyFolder then
        for _, child in pairs(toyFolder:GetChildren()) do
            if child.Name == "Gucci" or child.Name == "CreatureBlobman" then
                pcall(function() child:Destroy() end)
            end
        end
    end
end

-- ===== Blobman / Train / Tractor Type: SAVITARの考え方を簡略移植 =====
-- (SAVITAR本家は detection/probe/escape が多段で複雑なため、
--  「乗り物に乗って掴まれないようにし続ける」コア部分のみ移植する)

local GUCCI_SKY_CF = CFrame.new(150, 307, 332)

local function gucciFindExisting(toyName)
    local inv = service.Workspace:FindFirstChild(localPlayer.Name .. "SpawnedInToys")
    if inv then
        local found = inv:FindFirstChild(toyName)
        if found then return found end
    end
    local plotItems = service.Workspace:FindFirstChild("PlotItems")
    if plotItems then
        for _, folder in pairs(plotItems:GetChildren()) do
            if folder:IsA("Folder") and folder.Name ~= "PlayersInPlots" then
                local found = folder:FindFirstChild(toyName)
                if found then return found end
            end
        end
    end
    return nil
end

local function gucciSpawnAndWait(toyName, cf, vel, timeoutEach)
    local existing = gucciFindExisting(toyName)
    if existing then return existing end
    while Config.AntiGucciActive and not existing do
        pcall(function()
            SpawnToyRemoteFunction:InvokeServer(toyName, cf, vel or Vector3.zero)
        end)
        local waitUntil = tick() + (timeoutEach or 1)
        while tick() < waitUntil and Config.AntiGucciActive do
            existing = gucciFindExisting(toyName)
            if existing then break end
            service.RunService.Heartbeat:Wait()
        end
    end
    return existing
end

local function startGucciVehicle(toyName)
    local runId = Config.GucciRunId
    local char = localPlayer.Character or localPlayer.CharacterAdded:Wait()
    local hum = char:WaitForChild("Humanoid", 5)
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    if not (hum and hrp) then return end

    local model = gucciSpawnAndWait(toyName, GUCCI_SKY_CF, Vector3.zero, 1.2)
    if not model or runId ~= Config.GucciRunId or not Config.AntiGucciActive then return end
    model.Name = "Gucci"
    Config.GucciModel = model

    local seat = model:FindFirstChild("VehicleSeat") or model:WaitForChild("VehicleSeat", 3)
    if not seat or runId ~= Config.GucciRunId or not Config.AntiGucciActive then return end

    local savedCF = hrp.CFrame
    seat:Sit(hum)

    local seatStart = tick()
    while runId == Config.GucciRunId and Config.AntiGucciActive do
        if hum.SeatPart == seat or seat.Occupant == hum then break end
        if tick() - seatStart > 4 then return end
        service.RunService.Heartbeat:Wait()
    end
    if runId ~= Config.GucciRunId or not Config.AntiGucciActive then return end

    pcall(function()
        local cam = service.Workspace.CurrentCamera
        SetNetworkOwner:FireServer(hrp, cam and cam.CFrame or hrp.CFrame)
    end)
    pcall(function() hum.PlatformStand = true end)
    service.RunService.Heartbeat:Wait()
    pcall(function() seat.CFrame = CFrame.new(0, 1 / 0 * 0, 0) end) -- 無効化せず位置ずらし用(安全策)
    pcall(function()
        hrp.CFrame = savedCF
        hrp.AssemblyLinearVelocity = Vector3.zero
    end)
    pcall(function() hum.PlatformStand = false end)

    for _, desc in pairs(model:GetDescendants()) do
        if desc:IsA("BasePart") then
            pcall(function()
                desc.CanCollide = false
                desc.CanTouch = false
                desc.CanQuery = false
                desc.Massless = true
            end)
        end
    end

    Config.GucciRagdollLoop = task.spawn(function()
        while runId == Config.GucciRunId and Config.AntiGucciActive do
            pcall(function() RagdollRemote:FireServer(hrp, 0) end)
            service.RunService.Heartbeat:Wait()
        end
    end)
end

local function findTrainSeat()
    local ok, seat = pcall(function()
        return service.Workspace.Map.AlwaysHereTweenedObjects.Train.Object.ObjectModel.Seat
    end)
    if ok then return seat end
    return nil
end

local function startGucciTrain()
    local runId = Config.GucciRunId
    local char = localPlayer.Character or localPlayer.CharacterAdded:Wait()
    local hum = char:WaitForChild("Humanoid", 5)
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    if not (hum and hrp) then return end

    local seat = findTrainSeat()
    local waitStart = tick()
    while not seat and tick() - waitStart < 5 and Config.AntiGucciActive and runId == Config.GucciRunId do
        task.wait(0.2)
        seat = findTrainSeat()
    end
    if not seat or runId ~= Config.GucciRunId or not Config.AntiGucciActive then return end

    local savedCF = hrp.CFrame
    seat:Sit(hum)

    local seatStart = tick()
    while runId == Config.GucciRunId and Config.AntiGucciActive do
        if hum.SeatPart == seat or seat.Occupant == hum then break end
        if tick() - seatStart > 4 then return end
        service.RunService.Heartbeat:Wait()
    end
    if runId ~= Config.GucciRunId or not Config.AntiGucciActive then return end

    pcall(function()
        local cam = service.Workspace.CurrentCamera
        SetNetworkOwner:FireServer(hrp, cam and cam.CFrame or hrp.CFrame)
    end)
    pcall(function() hum.PlatformStand = true end)
    service.RunService.Heartbeat:Wait()
    pcall(function()
        hrp.CFrame = savedCF
        hrp.AssemblyLinearVelocity = Vector3.zero
    end)
    pcall(function() hum.PlatformStand = false end)

    Config.GucciRagdollLoop = task.spawn(function()
        while runId == Config.GucciRunId and Config.AntiGucciActive do
            pcall(function() RagdollRemote:FireServer(hrp, 0) end)
            service.RunService.Heartbeat:Wait()
        end
    end)
end

local function stopGucciVehicle()
    if Config.GucciRagdollLoop then
        task.cancel(Config.GucciRagdollLoop)
        Config.GucciRagdollLoop = nil
    end
    if Config.GucciModel then
        pcall(function() DestroyToy:FireServer(Config.GucciModel) end)
        Config.GucciModel = nil
    end
end

pcall(function()
LeftGroupBox:AddToggle("AntiGucci", {
    Text = "Anti Gucci",
    Default = false,
    Callback = safe(function(Value)
        -- 一旦すべて停止
        stopGucciRagdoll()
        Config.AntiGucciActive = false
        Config.GucciRunId = (Config.GucciRunId or 0) + 1
        stopGucciVehicle()

        if not Value then return end

        local gtype = Options.AntiGucciType and Options.AntiGucciType.Value or "Ragdoll"

        if gtype == "Ragdoll" then
            task.spawn(startGucciRagdoll)
        else
            Config.AntiGucciActive = true
            Config.GucciRunId = (Config.GucciRunId or 0) + 1
            if gtype == "Blobman" then
                task.spawn(function() startGucciVehicle("CreatureBlobman") end)
            elseif gtype == "Tractor" then
                task.spawn(function() startGucciVehicle("TractorGreen") end)
            elseif gtype == "Train" then
                task.spawn(startGucciTrain)
            end
        end
    end)
})
end)

------------------------------------------------------------------
-- 【2】 新しい Anti input lag トグル (SAVITAR Anti Network Ownership 移植)
--       既存の AntiInputLag トグルの Text は "Anti input lag(invis BETA)" に変更済みとする
--       対象トイは YAJU既存の InputLagToySelect ドロップダウン(Config.InputLagToyName)を共有
------------------------------------------------------------------
pcall(function()
LeftGroupBox:AddToggle("AntiNetOwner", {
    Text = "Anti input lag",
    Default = false,
    Callback = safe(function(Value)
        Config.AntiNetOwnerActive = Value
        if Config.AntiNetOwnerTask then
            task.cancel(Config.AntiNetOwnerTask)
            Config.AntiNetOwnerTask = nil
        end
        if Config.AntiNetOwnerObj then
            pcall(function() DestroyToy:FireServer(Config.AntiNetOwnerObj) end)
            Config.AntiNetOwnerObj = nil
        end
        if not Value then return end

        Config.AntiNetOwnerTask = task.spawn(function()
            local function nullify(model)
                for _, d in pairs(model:GetDescendants()) do
                    if d:IsA("BasePart") then
                        pcall(function()
                            d.Transparency = 1
                            d.LocalTransparencyModifier = 1
                            d.CanCollide = false
                            d.CanTouch = false
                            d.CanQuery = false
                        end)
                    end
                end
            end

            local function findExisting()
                local name = Config.InputLagToyName or "FoodHamburger"
                local inv = service.Workspace:FindFirstChild(localPlayer.Name .. "SpawnedInToys")
                return inv and inv:FindFirstChild(name)
            end

            local randFarCF = function()
                return CFrame.new(
                    math.random(-900000, 900000),
                    math.random(300000, 900000),
                    math.random(-900000, 900000)
                )
            end

            while Config.AntiNetOwnerActive do
                local char = localPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then
                    task.wait(0.2)
                    continue
                end

                local item = findExisting()
                if not item or not item.Parent then
                    local name = Config.InputLagToyName or "FoodHamburger"
                    if localPlayer.CanSpawnToy and not localPlayer.CanSpawnToy.Value then
                        localPlayer.CanSpawnToy:GetPropertyChangedSignal("Value"):Wait()
                    end
                    pcall(function()
                        SpawnToyRemoteFunction:InvokeServer(name, hrp.CFrame * CFrame.new(0, 3, 0), Vector3.zero)
                    end)
                    task.wait(0.3)
                    item = findExisting()
                end
                if not item then
                    task.wait(0.3)
                    continue
                end

                Config.AntiNetOwnerObj = item
                nullify(item)

                local holdPart = item:FindFirstChild("HoldPart") or item:WaitForChild("HoldPart", 2)
                if not holdPart then
                    pcall(function() DestroyToy:FireServer(item) end)
                    task.wait(0.2)
                    continue
                end
                local holdFn = holdPart:FindFirstChild("HoldItemRemoteFunction")
                local dropFn = holdPart:FindFirstChild("DropItemRemoteFunction")
                if not (holdFn and dropFn) then
                    pcall(function() DestroyToy:FireServer(item) end)
                    task.wait(0.2)
                    continue
                end

                while Config.AntiNetOwnerActive and item and item.Parent do
                    nullify(item)
                    local holdingPlayer = holdPart:FindFirstChild("HoldingPlayer")

                    if holdingPlayer and holdingPlayer.Value and holdingPlayer.Value ~= localPlayer then
                        pcall(function()
                            dropFn:InvokeServer(item, randFarCF(), Vector3.zero)
                        end)
                        task.wait()
                        pcall(function() item:Destroy() end)
                        break
                    else
                        local curChar = localPlayer.Character
                        if item.Parent and curChar then
                            pcall(function()
                                dropFn:InvokeServer(item, randFarCF(), Vector3.zero)
                            end)
                            task.wait()
                            pcall(function()
                                holdFn:InvokeServer(item, curChar)
                            end)
                        end
                    end
                    task.wait()
                end
                task.wait(0.1)
            end
        end)
    end)
})
end)

