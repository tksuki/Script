local antiStickyLoopActive = false
local antiStickyCooldowns = {}
local antiStickyCharConn

local function setStickyScriptDisabled(disabled)
    pcall(function()
        local playerScripts = localPlayer:FindFirstChild("PlayerScripts")
        if playerScripts then
            for _, d in pairs(playerScripts:GetDescendants()) do
                if d:IsA("LocalScript") and (d.Name == "StickyPartsTouchDetection"
                    or d.Name:lower():find("sticky") or d.Name:lower():find("touchdetect")) then
                    d.Disabled = disabled
                end
            end
        end
    end)
end

local function isAntiKickRelatedPart(part)
    if not part then return false end
    local inv = service.Workspace:FindFirstChild(localPlayer.Name .. "SpawnedInToys")
    if inv and part:IsDescendantOf(inv) then
        local p = part
        while p and p.Parent ~= inv and p.Parent ~= service.Workspace do p = p.Parent end
        if p and (p.Name == "AntiKickItem" or p.Name == "NinjaShuriken1" or p.Name == "PencilDDD") then
            return true
        end
    end
    return false
end

local function processStickyPart(part)
    if not part or not part:IsA("BasePart") then return end
    if isAntiKickRelatedPart(part) then return end
    local now = tick()
    if now - (antiStickyCooldowns[part] or 0) >= 0.5 then
        antiStickyCooldowns[part] = now
        pcall(function() SetNetworkOwner:FireServer(part, part.CFrame) end)
    end
end

local function scanAntiSticky()
    local char = localPlayer.Character
    if not char then return end
    for _, child in pairs(char:GetChildren()) do
        if child:IsA("BasePart") then
            local ok, connected = pcall(function() return child:GetConnectedParts() end)
            if ok and connected then
                for _, part in pairs(connected) do
                    if part and part:IsA("BasePart") and not part:IsDescendantOf(char) then
                        local stickyPart = (part.Name == "StickyPart") and part
                            or part:FindFirstChild("StickyPart", true) or part
                        if stickyPart and stickyPart:IsA("BasePart") then
                            processStickyPart(stickyPart)
                        end
                    end
                end
            end
        end
    end
    for k in pairs(antiStickyCooldowns) do
        if not k or not k.Parent then antiStickyCooldowns[k] = nil end
    end
end

