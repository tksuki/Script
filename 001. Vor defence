local ctCharConn, ctHeadConn

local function ctHookChar(char)
    if ctHeadConn then
        ctHeadConn:Disconnect()
        ctHeadConn = nil
    end
    if not char then return end
    local head = char:WaitForChild("Head", 8)
    if not head or not (Toggles.GDCounterAttack and Toggles.GDCounterAttack.Value) then return end
    ctHeadConn = head.ChildAdded:Connect(safe(function(child)
        if not (Toggles.GDCounterAttack and Toggles.GDCounterAttack.Value) then return end
        if child.Name ~= "PartOwner" then return end
        local plr = service.Players:FindFirstChild(child.Value)
        if plr and plr ~= localPlayer then
            task.spawn(function() ctApply(plr) end)
        end
    end))
end

