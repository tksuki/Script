            ctHeadConn:Disconnect()
            ctHeadConn = nil
        end
        if ctCharConn then
            ctCharConn:Disconnect()
            ctCharConn = nil
        end
        if not Value then return end
        ctHookChar(localPlayer.Character)
        ctCharConn = localPlayer.CharacterAdded:Connect(safe(function(char)
            task.spawn(function() ctHookChar(char) end)
        end))
    end)
})
end)

