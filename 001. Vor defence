local ctConsequences = {}

local function ctLookAt(a, b)
    local unit = (b - a).Unit
    local right = unit:Cross(Vector3.new(0, 1, 0))
    return CFrame.fromMatrix(a, right, right:Cross(unit))
end

local function ctIsValid(part)
    return part ~= nil and part.Parent ~= nil
end

local function ctSnowship(part)
    if not (part and part.Parent) then return false end
    local char = localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    pcall(function() SetNetworkOwner:FireServer(part, ctLookAt(hrp.Position, part.Position)) end)
    return true
end

local function ctOwnedByMe(plr)
    if not (plr and plr.Character) then return false end
    local head = plr.Character:FindFirstChild("Head")
    head = head and head:FindFirstChild("PartOwner")
    return head and head.Value == localPlayer.Name
end

local function ctCreateSkyVelocity(part)
    if not part or part:FindFirstChild("SkyVelocity") then return end
    local bv = Instance.new("BodyVelocity", part)
    bv.Name = "SkyVelocity"
    bv.Velocity = Vector3.new(0, 1e14, 0)
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    task.delay(0.25, function()
        if bv and bv.Parent then pcall(function() bv:Destroy() end) end
    end)
end

local function ctRunMode(mode, plr, char, hrp, hum)
    if mode == "Kill" then
        task.spawn(function()
            if not (hrp and hrp.Parent) then return end
            local deadline = tick() + 1.5
            while hrp and hrp.Parent and tick() < deadline do
                if not ctIsValid(hrp) then return end
                ctSnowship(hrp)
                if ctOwnedByMe(plr) or hrp.AssemblyLinearVelocity.Magnitude > 500 then
                    pcall(function()
                        hum.BreakJointsOnDeath = false
                        hum:ChangeState(Enum.HumanoidStateType.Dead)
                    end)
                    ctCreateSkyVelocity(hrp)
                    return
                end
                service.RunService.Heartbeat:Wait()
            end
        end)
    elseif mode == "Void" then
        task.spawn(function()
            if not (hrp and hrp.Parent) then return end
            local deadline = tick() + 1.5
            while hrp and hrp.Parent and tick() < deadline do
                if not ctIsValid(hrp) then return end
                ctSnowship(hrp)
                if ctOwnedByMe(plr) or hrp.AssemblyLinearVelocity.Magnitude > 500 then
                    ctCreateSkyVelocity(hrp)
                    return
                end
                service.RunService.Heartbeat:Wait()
            end
        end)
    elseif mode == "Ragdoll" then
        task.spawn(function()
            if not (hrp and hrp.Parent and hum and hum.Health > 0) then return end
            local deadline = tick() + 2
            while hrp and hrp.Parent and tick() < deadline do
                pcall(function() SetNetworkOwner:FireServer(hrp, hrp.CFrame) end)
                if ctOwnedByMe(plr) then break end
                service.RunService.Heartbeat:Wait()
            end
            pcall(function() RagdollRemote:FireServer(hrp, 1) end)
        end)
    elseif mode == "Fling" then
        task.spawn(function()
            if not (hrp and hrp.Parent) then return end
            local deadline = tick() + 1.5
            while hrp and hrp.Parent and tick() < deadline do
                if not ctIsValid(hrp) then return end
                ctSnowship(hrp)
                if ctOwnedByMe(plr) or hrp.AssemblyLinearVelocity.Magnitude > 100 then
                    pcall(function()
                        local myHrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
                        local dir = myHrp and (hrp.Position - myHrp.Position).Unit or Vector3.new(0, 1, 0)
                        hrp.AssemblyLinearVelocity = (dir + Vector3.new(0, 0.5, 0)).Unit * 500
                    end)
                    return
                end
                service.RunService.Heartbeat:Wait()
            end
        end)
    elseif mode == "Unstick" then
        task.spawn(function()
            if not char then return end
            for _, d in pairs(char:GetDescendants()) do
                if d:IsA("BasePart") then
                    local ok, connected = pcall(function() return d:GetConnectedParts() end)
                    if ok and connected then
                        for _, p in pairs(connected) do
                            if p and not p:IsDescendantOf(char) then
                                local sticky = (p.Name == "StickyPart") and p or p:FindFirstChild("StickyPart", true)
                                if sticky and sticky:IsA("BasePart") then
                                    pcall(function() SetNetworkOwner:FireServer(sticky, sticky.CFrame) end)
                                end
                            end
                        end
                    end
                end
            end
        end)
    elseif mode == "Highlight" then
        task.spawn(function()
            if not char then return end
            local hl = Instance.new("Highlight")
            hl.Name = "_ctHL"
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.FillColor = Color3.fromRGB(255, 50, 50)
            hl.OutlineColor = Color3.fromRGB(255, 200, 0)
            hl.FillTransparency = 0.3
            hl.OutlineTransparency = 0
            hl.Parent = char
            task.delay(3, function() pcall(function() hl:Destroy() end) end)
        end)
    elseif mode == "TP to Spawn" then
        task.spawn(function()
            if not (hrp and hrp.Parent) then return end
            local deadline = tick() + 1.5
            while hrp and hrp.Parent and tick() < deadline do
                if not ctIsValid(hrp) then return end
                ctSnowship(hrp)
                if ctOwnedByMe(plr) then
                    pcall(function()
                        local spawnLoc = service.Workspace:FindFirstChildOfClass("SpawnLocation")
                        hrp.CFrame = (spawnLoc and spawnLoc.CFrame or CFrame.new(0, 5, 0)) + Vector3.new(0, 3, 0)
                    end)
                    return
                end
                service.RunService.Heartbeat:Wait()
            end
        end)
    elseif mode == "Struggle" then
        task.spawn(function()
            if not (hrp and hrp.Parent) then return end
            local deadline = tick() + 1.5
            while hrp and hrp.Parent and tick() < deadline do
                if not ctIsValid(hrp) then return end
                ctSnowship(hrp)
                if ctOwnedByMe(plr) then
                    pcall(function() Struggle:FireServer() end)
                    return
                end
                service.RunService.Heartbeat:Wait()
            end
        end)
    end
end

local function ctApply(plr)
    if not (plr and plr.Character) then return end
    local char = plr.Character
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not (hrp and hum and hum.Health > 0) then return end
    for mode, enabled in pairs(ctConsequences) do
        if enabled then
            task.spawn(function() ctRunMode(mode, plr, char, hrp, hum) end)
        end
    end
end

