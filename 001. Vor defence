local UserInputService = game:GetService("UserInputService")

-- Obsidian系 lib:Notify の代替。Library:Notify があればそれを使い、無ければ print。
local function notify(title, desc)
    local ok = pcall(function()
        if Library and Library.Notify then
            Library:Notify({ Title = title, Description = desc, Time = 4 })
        elseif Library and Library.notify then
            Library:notify({ Title = title, Description = desc, Time = 4 })
        else
            error("no notify")
        end
    end)
    if not ok then
        print("[" .. tostring(title) .. "] " .. tostring(desc))
    end
end

