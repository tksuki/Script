pcall(function()
antikick:AddToggle("AntikickShuriken", {
    Text = "Anti-Kick",
    Default = false,
    Callback = safe(function(Value)
        Config.AntiKickShurikenActive = Value
        if Config.AntiKickShurikenTask then
