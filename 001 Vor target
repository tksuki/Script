-- Target Tab
local PlayerPicker = {
    Icons = {},
    Thumbs = {},
    Pending = {},
    Tracked = setmetatable({}, { __mode = "k" }),
}

function PlayerPicker.Build()
    local Players = game:GetService("Players")
    local list, map = {}, {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= Players.LocalPlayer then
            local label = plr.DisplayName .. " (" .. plr.Name .. ")"
            map[label] = plr
            PlayerPicker.Icons[label] = plr.UserId
            table.insert(list, label)
        end
    end
    table.sort(list)
    return list, map
end

function PlayerPicker.Refresh(obj)
    local state = PlayerPicker.Tracked[obj]
    if not state then return end
    local userId = PlayerPicker.Icons[obj.Text]
    if userId then
        if not state.img then
            local pad = obj:FindFirstChildOfClass("UIPadding")
            if not pad then
                pad = Instance.new("UIPadding")
                pad.Parent = obj
            end
            state.pad = pad
            state.base = pad.PaddingLeft.Offset
            local img = Instance.new("ImageLabel")
            img.Name = "PlayerIcon"
            img.AnchorPoint = Vector2.new(0, 0.5)
            img.Position = UDim2.new(0, state.base, 0.5, 0)
            img.Size = UDim2.fromOffset(16, 16)
            img.BackgroundTransparency = 1
            img.ZIndex = obj.ZIndex + 1
            img.Parent = obj
            state.img = img
        end
        if not state.on then
            state.on = true
            state.pad.PaddingLeft = UDim.new(state.pad.PaddingLeft.Scale, state.base + 22)
        end
        state.img.Visible = true
        local thumb = PlayerPicker.Thumbs[userId]
        if thumb then
            state.img.Image = thumb
        elseif not PlayerPicker.Pending[userId] then
            PlayerPicker.Pending[userId] = true
            task.spawn(function()
                local ok, content = pcall(function()
                    return game:GetService("Players"):GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
                end)
                PlayerPicker.Pending[userId] = nil
                if ok then
                    PlayerPicker.Thumbs[userId] = content
                    if state.img and PlayerPicker.Icons[obj.Text] == userId then
                        state.img.Image = content
                    end
                end
            end)
        end
    elseif state.on then
        state.on = false
        state.pad.PaddingLeft = UDim.new(state.pad.PaddingLeft.Scale, state.base)
        state.img.Visible = false
    end
end

function PlayerPicker.Decorate(obj)
    if PlayerPicker.Tracked[obj] then return end
    PlayerPicker.Tracked[obj] = { on = false }
    obj:GetPropertyChangedSignal("Text"):Connect(safe(function()
        PlayerPicker.Refresh(obj)
    end))
    PlayerPicker.Refresh(obj)
end

function PlayerPicker.Start()
    local root = Library and Library.ScreenGui
    if not root then return end
    local function consider(d)
        if d:IsA("TextLabel") or d:IsA("TextButton") then
            PlayerPicker.Decorate(d)
        end
    end
    for _, d in ipairs(root:GetDescendants()) do
        pcall(consider, d)
    end
    root.DescendantAdded:Connect(safe(consider))
end

pcall(PlayerPicker.Start)

