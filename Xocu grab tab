-- =========================================================================
do
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local LocalPlayer = Players.LocalPlayer

	local PoseX = {
		HoldPosition     = {X=0,    Y=-0.5, Z=-2.5},
		HoldRotation     = {X=277.5,Y=0,    Z=0},
		LeftArmPosition  = {X=-1.5, Y=-1,   Z=0.5},
		LeftArmRotation  = {X=289,  Y=78,   Z=0},
		RightArmPosition = {X=1.5,  Y=-1,   Z=0.5},
		RightArmRotation = {X=315,  Y=78,   Z=338},
		LeftLegPosition  = {X=-0.5, Y=-1.5, Z=-0.5},
		LeftLegRotation  = {X=51,   Y=0,    Z=348},
		RightLegPosition = {X=1,    Y=-1.5, Z=-0.5},
		RightLegRotation = {X=50,   Y=0,    Z=16},
		HeadPosition     = {X=0,    Y=1,    Z=0.5},
		HeadRotation     = {X=85,   Y=0,    Z=0},
	}

	local poseActive = false
	local poseConn = nil
	local SpamChar = nil

	local snoRemote = ReplicatedStorage:WaitForChild("GrabEvents", 5)
	snoRemote = snoRemote and snoRemote:FindFirstChild("SetNetworkOwner")

	local function stopPoseX()
		poseActive = false
		if poseConn then
			poseConn:Disconnect()
			poseConn = nil
		end
		
		if SpamChar and SpamChar.Parent then
			local targetTorso = SpamChar:FindFirstChild("Torso") or SpamChar:FindFirstChild("UpperTorso") or SpamChar:FindFirstChild("HumanoidRootPart")
			if targetTorso then
				pcall(function()
					game:GetService("ReplicatedStorage").GrabEvents.DestroyGrabLine:FireServer(targetTorso)
				end)
			end
		end
		SpamChar = nil
	end

	local function startPoseX()
		local Mouse = LocalPlayer:GetMouse()
		local target = Mouse.Target
		
		if not target or target:IsDescendantOf(LocalPlayer.Character) then
			local cam = workspace.CurrentCamera
			local ray = cam:ScreenPointToRay(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
			local params = RaycastParams.new()
			params.FilterDescendantsInstances = {LocalPlayer.Character}
			params.FilterType = Enum.RaycastFilterType.Exclude
			local res = workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
			if res then target = res.Instance end
		end

		if not target then
			Library:Notify({ Title = "System", Content = "No target found under crosshair!", Duration = 3 })
			return
		end

		SpamChar = target.Parent
		local Head = SpamChar:FindFirstChild("Head")
		local Torso = SpamChar:FindFirstChild("Torso") or SpamChar:FindFirstChild("UpperTorso") or SpamChar:FindFirstChild("HumanoidRootPart")
		local Hum = SpamChar:FindFirstChildOfClass("Humanoid")

		if not (Torso and Head and Hum) then
			SpamChar = nil
			Library:Notify({ Title = "System", Content = "Invalid character target!", Duration = 3 })
			return
		end

		poseActive = true
		local myChar = LocalPlayer.Character
		local hrp = myChar and myChar:FindFirstChild("HumanoidRootPart")

		Library:Notify({ Title = "Pose X", Content = "Locked onto " .. SpamChar.Name, Duration = 3 })

		-- 開始時に確実にSetNetworkOwnerを送る
		if snoRemote then pcall(function() snoRemote:FireServer(Torso, Torso.CFrame) end) end

		local lastSnoTime = tick() -- 0.1秒タイマー用

		poseConn = RunService.Heartbeat:Connect(function()
			if not poseActive or not hrp or not SpamChar or not SpamChar.Parent then
				stopPoseX()
				return
			end

			Torso = SpamChar:FindFirstChild("Torso") or SpamChar:FindFirstChild("UpperTorso") or SpamChar:FindFirstChild("HumanoidRootPart")
			Head = SpamChar:FindFirstChild("Head")
			if not Torso or not Head then stopPoseX() return end

			-- 0.1秒ごとにリモートイベントを送信
			if tick() - lastSnoTime >= 0.1 then
				lastSnoTime = tick()
				if snoRemote then 
					pcall(function() snoRemote:FireServer(Torso, Torso.CFrame) end) 
				end
			end

			for _, x in pairs(SpamChar:GetDescendants()) do
				if x:IsA("BasePart") then x.CanCollide = false end
			end

			local holdCF = hrp.CFrame
				* CFrame.new(PoseX.HoldPosition.X, PoseX.HoldPosition.Y, PoseX.HoldPosition.Z)
				* CFrame.Angles(math.rad(PoseX.HoldRotation.X), math.rad(PoseX.HoldRotation.Y), math.rad(PoseX.HoldRotation.Z))

			Torso.CFrame = holdCF
			Torso.AssemblyLinearVelocity  = Vector3.zero
			Torso.AssemblyAngularVelocity = Vector3.zero

			local function applyLimb(name, posKey, rotKey)
				local part = SpamChar:FindFirstChild(name)
				if not part then return end
				local p = PoseX[posKey]
				local r = PoseX[rotKey]
				part.CFrame = Torso.CFrame
					* CFrame.new(p.X, p.Y, p.Z)
					* CFrame.Angles(math.rad(r.X), math.rad(r.Y), math.rad(r.Z))
				part.AssemblyLinearVelocity  = Vector3.zero
				part.AssemblyAngularVelocity = Vector3.zero
			end

			applyLimb("Head",      "HeadPosition",      "HeadRotation")
			applyLimb("Left Arm",  "LeftArmPosition",   "LeftArmRotation")
			applyLimb("Right Arm", "RightArmPosition",  "RightArmRotation")
			applyLimb("Left Leg",  "LeftLegPosition",   "LeftLegRotation")
			applyLimb("Right Leg", "RightLegPosition",  "RightLegRotation")
		end)
	end

	local PoseBlock = Tabs.Grab:CreateBlock({Name = "Pose X", Side = "Left"})
	PoseBlock:CreateToggle({
		Name = "x (Aim at target)",
		Flag = "PoseXToggle",
		Default = false,
		Callback = function(Value)
			if Value then startPoseX() else stopPoseX() end
		end
	})
end

