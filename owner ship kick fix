                                end
                            end
                            hrp.CFrame = oldCF
                            if etc.Head and CheckForPartOwner(etc["Head"]) then
                                for _, v in pairs(etc.TargetPLR.Character:GetChildren()) do
                                    if v:IsA("BasePart") then
