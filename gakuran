-- Auto Block トグル
local AutoBlockToggle = MainTab:CreateToggle({
    Name = "Auto Block",
    CurrentValue = false,
    Flag = "AutoBlock",
    Callback = function(Value)
        isAutoBlockEnabled = Value
        
        if Value then
            -- トグルがオンになったら両方のフック開始
            hookRemote1()
            hookRemote2()
            Rayfield:Notify({
                Title = "Auto Block",
                Content = "Auto Block が有効になりました",
                Duration = 3,
                Image = 4483362458,
            })
        else
            -- トグルがオフになったらフック解除
            if connection1 then
                connection1:Disconnect()
                connection1 = nil
            end
            if connection2 then
                connection2:Disconnect()
                connection2 = nil
            end
            isBlocking = false
            Rayfield:Notify({
                Title = "Auto Block",
                Content = "Auto Block が無効になりました",
                Duration = 3,
                Image = 4483362458,
            })
        end
    end
})
