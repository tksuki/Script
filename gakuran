local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

-- リモートイベントの定義
local Remote1 = ReplicatedStorage:WaitForChild("BLINK_RELIABLE_REMOTE")
local Remote2 = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Network"):WaitForChild("CombatClientRemoteEvent")
local ServerRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Server")

-- フック用の変数
local isAutoBlockEnabled = false
local connection1
local connection2
local isBlocking = false
local blockCooldown = 0

-- ハイライト用のデータ
local function createHighlightData(playerName)
    local player = Players:FindFirstChild(playerName)
    if not player then return nil end
    
    local character = player.Character
    if not character then return nil end
    
    return {
        [1] = character,
        [2] = character,
        [3] = {
            ["FillColor"] = Color3.new(0.870588, 0.266667, 0.266667),
            ["FadeInSeconds"] = 0.03,
            ["FadeOutSeconds"] = 0.06,
            ["TargetOutlineTransparency"] = 0.95,
            ["Name"] = "M2Highlight",
            ["OutlineColor"] = Color3.new(1, 1, 1),
            ["Duration"] = 0.6142070412612582,
            ["TargetFillTransparency"] = 0.65,
            ["Style"] = "Flash",
        },
    }
end

-- ブロックを実行する関数
local function performBlock()
    ServerRemote:FireServer(table.unpack({
        [1] = {
            ["Type"] = "Combat",
            ["Action"] = "Block",
            ["Func"] = "Activated",
        },
        [2] = 1788253673.892764,
    }))
end

-- ブロックを解除する関数
local function deactivateBlock()
    ServerRemote:FireServer({
        ["Type"] = "Combat",
        ["Action"] = "Block",
        ["Func"] = "Deactivated",
    })
end

-- ブロックを実行して1秒後に解除する関数
local function performBlockWithDelay()
    if isBlocking then return end -- 既にブロック中の場合は無視
    
    isBlocking = true
    performBlock()
    
    -- 1秒後にブロック解除
    task.delay(1, function()
        deactivateBlock()
        isBlocking = false
    end)
end

-- プレイヤーが5スタッド以内にいるかチェックする関数
local function isPlayerWithinRange(playerName)
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        return false
    end
    
    local player = Players:FindFirstChild(playerName)
    if not player or not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
        return false
    end
    
    local myPosition = LocalPlayer.Character.HumanoidRootPart.Position
    local playerPosition = player.Character.HumanoidRootPart.Position
    local distance = (myPosition - playerPosition).Magnitude
    
    return distance <= 5
end

-- ハイライトを表示する関数
local function showHighlight(playerName)
    local highlightData = createHighlightData(playerName)
    if highlightData then
        firesignal(Remote1.OnClientEvent, table.unpack({
            [1] = buffer,
            [2] = highlightData,
        }))
    end
end

-- 攻撃を処理する関数
local function processAttack(playerName)
    if not isAutoBlockEnabled then return end
    if isBlocking then return end -- ブロック中の場合は無視
    
    -- プレイヤー名が動的に取得できているかチェック
    if playerName and playerName ~= "" and playerName ~= LocalPlayer.Name then
        -- 5スタッド以内にいるかチェック
        if isPlayerWithinRange(playerName) then
            -- ハイライト表示
            showHighlight(playerName)
            
            -- ブロック実行（1秒後に自動解除）
            performBlockWithDelay()
            
            print("Auto Block: " .. playerName .. " からの攻撃をブロックしました")
        end
    end
end

-- リモートイベント1のフック（BLINK_RELIABLE_REMOTE）
local function hookRemote1()
    if connection1 then
        connection1:Disconnect()
        connection1 = nil
    end
    
    connection1 = Remote1.OnClientEvent:Connect(function(...)
        if not isAutoBlockEnabled then return end
        
        local args = {...}
        local data = args[2]
        
        if data and data[1] and data[2] then
            local attacker = data[1]
            local target = data[2]
            
            -- 攻撃者がプレイヤーキャラクターの場合
            if attacker and attacker:IsA("Model") then
                local player = Players:GetPlayerFromCharacter(attacker)
                if player then
                    -- 自分がターゲットの場合
                    if target == LocalPlayer.Character then
                        processAttack(player.Name)
                    end
                end
            end
        end
    end)
end

-- リモートイベント2のフック（CombatClientRemoteEvent）
local function hookRemote2()
    if connection2 then
        connection2:Disconnect()
        connection2 = nil
    end
    
    connection2 = Remote2.OnClientEvent:Connect(function(...)
        if not isAutoBlockEnabled then return end
        
        local args = {...}
        
        -- 引数の解析
        if args[1] == "NpcCombatSound" then
            local playerName = args[2] -- 動的取得ユーザー名
            local soundType = args[3] -- "PunchSwing"などの攻撃タイプ
            
            -- 攻撃サウンドの場合
            if soundType and (soundType == "PunchSwing" or soundType == "Swing") then
                processAttack(playerName)
            end
        end
    end)
end

