-- ボス直接連射
local function executeDirectBossFire()
    while directBossFireEnabled do
        handleEquipForAttack()
        local boss = workspace:FindFirstChild("Boss", true)
        if boss then
            local humanoidParts = getBossHumanoidParts(boss)
            
            if #humanoidParts > 0 then
                for _, sourcePart in ipairs(humanoidParts) do
                    if sourcePart:IsA("BasePart") then
                        local shootPos = sourcePart.Position
                        local shootCFrame = sourcePart.CFrame
                        local targetPos = sourcePart.Position
                        local targetCFrame = sourcePart.CFrame
                        local direction = Vector3.new(0, -1, 0)
                        
                        game:GetService("ReplicatedStorage").BowSystem.BowREEvent:FireServer(
                            "shoot",
                            0,
                            targetCFrame,
                            true,
                            3.1,
                            shootCFrame,
                            targetPos,
                            direction * 100,
                            shootPos,
                            game:GetService("Teams").Lobby
                        )
                    end
                end
            end
        end
        
        wait(fireInterval)
    end
end

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local args = {...}
    local method = getnamecallmethod()
    
    if method == "FireServer" and self.Name == "BowREEvent" and args[1] == "shoot" and not rapidFireEnabled then
        capturedArgs = args
    end
    
    return oldNamecall(self, ...)
end)

local function executeRapidFire()
    while rapidFireEnabled do
        handleEquipForAttack()
        if capturedArgs then
            game:GetService("ReplicatedStorage").BowSystem.BowREEvent:FireServer(table.unpack(capturedArgs))
        end
        wait(fireInterval)
    end
end

local function executeSwordSpam()
    while swordSpamEnabled do
        local player = game.Players.LocalPlayer
        local boss = workspace:FindFirstChild("Boss", true)
        
        if player and player.Character and boss then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            local bossHitbox = boss:FindFirstChild("HumanoidRootPart", true) or boss:FindFirstChild("UpperTorso", true) or boss:FindFirstChild("Torso", true)
            
            if hrp and bossHitbox then
                local playerPos = hrp.Position
                local bossPos = bossHitbox.Position
                local distance = (bossPos - playerPos).Magnitude
                
                local bossSize = bossHitbox.Size
                local hitboxRadius = math.max(bossSize.X, bossSize.Y, bossSize.Z) / 2
                
                local adjustedDistance = distance - hitboxRadius
                
                game:GetService("ReplicatedStorage").Remotes.CombatEvent:FireServer({
                    ["HitBoxDuration"] = 0.3,
                    ["Action"] = "M1",
                    ["DashVelocity"] = 60,
                    ["Combo"] = 1,
                    ["AnimLength"] = adjustedDistance,
                })
            end
        end
        
        wait(0.00000000001)
    end
end

