-- プレイヤーリストを更新する関数
local function updatePlayerList()
    local players = {}
    for _, player in ipairs(game.Players:GetPlayers()) do
        if player ~= game.Players.LocalPlayer then
            table.insert(players, player.DisplayName .. " (" .. player.Name .. ")")
        end
    end
    playerList = players
    
    if playerDropdown then
        playerDropdown:Refresh(playerList, true)
    end
end

-- プレイヤー名からPlayerオブジェクトを取得する関数
local function getPlayerFromDisplay(displayText)
    for _, player in ipairs(game.Players:GetPlayers()) do
        if player.DisplayName .. " (" .. player.Name .. ")" == displayText then
            return player
        end
    end
    return nil
end

-- 指定された名前のツールを検索して装備する関数
local function equipItemByName(itemName)
    local player = game.Players.LocalPlayer
    if not player then return false end

    local character = player.Character
    if character then
        local equipped = character:FindFirstChild(itemName)
        if equipped and equipped:IsA("Tool") then
            return true
        end
    end

    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        local tool = backpack:FindFirstChild(itemName)
        if tool and tool:IsA("Tool") and character then
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid:EquipTool(tool)
                return true
            end
        end
    end

    return false
end

-- 弓連射系が1つでもオンか確認する補助関数
local function isAnyBowEnabled()
    return bowLoopEnabled or rapidFireEnabled or multiBowEnabled or directBossFireEnabled or playerBowEnabled
end

-- 状況に応じた装備切り替え管理
local function handleEquipForAttack()
    local bowActive = isAnyBowEnabled()
    local staffActive = staffRapidFireEnabled

    if bowActive and staffActive then
        equipItemByName("BasicCrossbow")
        equipItemByName("MagicLauncher")
    elseif bowActive then
        equipItemByName("BasicCrossbow")
    elseif staffActive then
        equipItemByName("MagicLauncher")
    end
end

local function executeBlockLoop()
    while loopEnabled do
        local player = game.Players.LocalPlayer
        if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            player.Character.HumanoidRootPart.CFrame = CFrame.new(53.4, 509.5, 7.7)
            
            wait(0.16)
            
            local placeBlockPivot = game.Workspace:FindFirstChild("ZonePlaceBlockPivot", true)
            
            if placeBlockPivot then
                if placeBlockPivot:IsA("BasePart") then
                    local pos = placeBlockPivot.CFrame.Position
                    player.Character.HumanoidRootPart.CFrame = CFrame.new(pos.X, pos.Y - 3, pos.Z)
                elseif placeBlockPivot:IsA("Model") then
                    local targetPart = placeBlockPivot.PrimaryPart or placeBlockPivot:FindFirstChildWhichIsA("BasePart")
                    if targetPart then
                        local pos = targetPart.CFrame.Position
                        player.Character.HumanoidRootPart.CFrame = CFrame.new(pos.X, pos.Y - 3, pos.Z)
                    end
                end
            end
        end
        
        wait(0.16)
    end
end

local function executeBowLoop()
    while bowLoopEnabled do
        handleEquipForAttack()
        local boss = workspace:FindFirstChild("Boss", true)
        if boss then
            local upperTorso = boss:FindFirstChild("UpperTorso", true)
            if upperTorso then
                local targetPos = upperTorso.Position
                local targetCFrame = upperTorso.CFrame
                local player = game.Players.LocalPlayer
                local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                
                if hrp then
                    local playerPos = hrp.Position
                    local playerCFrame = hrp.CFrame
                    local direction = (targetPos - playerPos).Unit
                    
                    game:GetService("ReplicatedStorage").BowSystem.BowREEvent:FireServer(
                        "shoot",
                        0,
                        targetCFrame,
                        true,
                        3.1,
                        playerCFrame,
                        targetPos,
                        direction * 100,
                        playerPos,
                        game:GetService("Teams").Lobby
                    )
                end
            end
        end
        
        wait(fireInterval)
    end
end

-- 選択したプレイヤーの座標から弓を放つ
local function executePlayerBowLoop()
    while playerBowEnabled do
        handleEquipForAttack()
        local boss = workspace:FindFirstChild("Boss", true)
        if boss then
            local upperTorso = boss:FindFirstChild("UpperTorso", true)
            if upperTorso then
                local targetPos = upperTorso.Position
                local targetCFrame = upperTorso.CFrame
                
                -- 選択されたプレイヤーを取得
                local targetPlayer = nil
                if playerDropdown and playerDropdown.Value then
                    targetPlayer = getPlayerFromDisplay(playerDropdown.Value)
                end
                
                if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local playerPos = targetPlayer.Character.HumanoidRootPart.Position
                    local playerCFrame = targetPlayer.Character.HumanoidRootPart.CFrame
                    local direction = (targetPos - playerPos).Unit
                    
                    game:GetService("ReplicatedStorage").BowSystem.BowREEvent:FireServer(
                        "shoot",
                        0,
                        targetCFrame,
                        true,
                        3.1,
                        playerCFrame,
                        targetPos,
                        direction * 100,
                        playerPos,
                        game:GetService("Teams").Lobby
                    )
                end
            end
        end
        
        wait(fireInterval)
    end
end

-- ボスのヒューマノイドパーツを取得する関数
local function getBossHumanoidParts(boss)
    local humanoidParts = {}
    
    local humanoid = boss:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        humanoid = boss:FindFirstChildWhichIsA("Humanoid", true)
    end
    
    if humanoid then
        local model = humanoid.Parent
        if model then
            for _, part in ipairs(model:GetDescendants()) do
                if part:IsA("BasePart") then
                    table.insert(humanoidParts, part)
                end
            end
        end
    end
    
    if #humanoidParts == 0 then
        local alternativeParts = {
            boss:FindFirstChild("HumanoidRootPart"),
            boss:FindFirstChild("UpperTorso"),
            boss:FindFirstChild("LowerTorso"),
            boss:FindFirstChild("Torso"),
            boss:FindFirstChild("Head")
        }
        
        for _, part in ipairs(alternativeParts) do
            if part then
                table.insert(humanoidParts, part)
            end
        end
        
        if #humanoidParts == 0 then
            for _, name in ipairs({"HumanoidRootPart", "UpperTorso", "LowerTorso", "Torso", "Head"}) do
                local foundPart = boss:FindFirstChild(name, true)
                if foundPart then
                    table.insert(humanoidParts, foundPart)
                end
            end
        end
    end
    
    return humanoidParts
end

-- いろんなところから弓を放つ（ボスのヒューマノイドパーツから発射）
local function executeMultiBowLoop()
    while multiBowEnabled do
        handleEquipForAttack()
        local boss = workspace:FindFirstChild("Boss", true)
        if boss then
            local humanoidParts = getBossHumanoidParts(boss)
            
            if #humanoidParts > 0 then
                local radius = 50
                
                for _, sourcePart in ipairs(humanoidParts) do
                    if sourcePart:IsA("BasePart") then
                        local sourcePos = sourcePart.Position
                        
                        for _, targetPart in ipairs(humanoidParts) do
                            if targetPart:IsA("BasePart") and targetPart ~= sourcePart then
                                local targetPos = targetPart.Position
                                local targetCFrame = targetPart.CFrame
                                
                                for i = 1, numBowPositions do
                                    local angle = (i / numBowPositions) * math.pi * 2
                                    local offsetX = math.cos(angle) * radius
                                    local offsetZ = math.sin(angle) * radius
                                    
                                    local shootPos = Vector3.new(
                                        sourcePos.X + offsetX,
                                        sourcePos.Y,
                                        sourcePos.Z + offsetZ
                                    )
                                    
                                    local shootCFrame = CFrame.new(shootPos)
                                    local direction = (targetPos - shootPos).Unit
                                    
                                    game:GetService("ReplicatedStorage").BowSystem.BowREEvent:FireServer(
                                        "shoot",
                                        0,
                                        targetCFrame,
                                        true,
                                        3.1,
                                        shootCFrame,
                                        targetPos,
                                        direction * 100,
                                        shootPos,
                                        game:GetService("Teams").Lobby
                                    )
                                end
                            end
                        end
                    end
                end
            end
        end
        
        wait(fireInterval)
    end
end

