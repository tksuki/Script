-- ============================================================
local OBSIDIAN_BASE = "https://raw.githubusercontent.com/deividcomsono/Obsidian/fb0b7b22604664ab94bea7c67e2a14ab1a47ec27/"

local function httpGet(url)
    local ok, body = pcall(game.HttpGet, game, url)
    if not ok then return nil, tostring(body) end
    if type(body) ~= "string" or body == "" then return nil, "Empty response" end
    return body
end

local function loadLib(path, moduleName)
    local body, err = httpGet(OBSIDIAN_BASE .. path)
    if not body then
        return nil, string.format("%s (%s): %s", moduleName, path, err)
    end
    local fn, lerr = loadstring(body, "@Obsidian/" .. moduleName)
    if not fn then
        return nil, string.format("%s loadstring: %s", moduleName, tostring(lerr))
    end
    return fn
end

