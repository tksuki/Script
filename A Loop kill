-- Boot
-- ============================================================
local gui = buildUI()

-- Keybind toggle (RightShift)
local toggleConn = UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        gui.Enabled = not gui.Enabled
    end
end)

-- Public API
local function unload()
    State.Stopped = true
    pcall(function() RunService:UnbindFromRenderStep("RSC_Kill") end)
    if toggleConn then pcall(function() toggleConn:Disconnect() end) end
    if gui then pcall(function() gui:Destroy() end) end
    local env = getgenv and getgenv() or _G
    env.ResonanceKill = nil
    env.ResonanceKillUnload = nil
    env.ResonanceKillShow = nil
    env.ResonanceKillHide = nil
    print("[Resonance Kill] Unloaded.")
end

local env = getgenv and getgenv() or _G
env.ResonanceKill = {
    Kill     = Kill,
    Unload   = unload,
    IsPartOwner = IsPartOwner,
    SNO      = SNO,
}
env.ResonanceKillUnload = unload
env.ResonanceKillShow   = function() if gui then gui.Enabled = true end end
env.ResonanceKillHide   = function() if gui then gui.Enabled = false end end

print("[Resonance Kill] Loaded. RightShift toggles UI. getgenv().ResonanceKillUnload() to unload.")
