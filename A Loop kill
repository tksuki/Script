        local prevSelected = State.Selected

        for player, btn in pairs(rows) do
            btn:Destroy()
        end
        rows = {}
        State.Selected = nil

        local search = searchBox.Text:lower()
        local playerList = Players:GetPlayers()
        table.sort(playerList, function(a, b)
            return a.DisplayName:lower() < b.DisplayName:lower()
        end)

        local count = 0
        for _, player in ipairs(playerList) do
            if player ~= LocalPlayer then
                if search == ""
                or player.Name:lower():find(search, 1, true)
                or player.DisplayName:lower():find(search, 1, true) then
                    makeRow(player)
                    count = count + 1
                end
            end
        end

        -- Restore selection if still present
        if prevSelected and rows[prevSelected] then
            State.Selected = prevSelected
            setSelectedUI(prevSelected, true)
            selectedLabel.Text = "Selected: " .. prevSelected.DisplayName
            selectedLabel.TextColor3 = COLORS.Accent
        else
            State.Selected = nil
            selectedLabel.Text = "Selected: none"
            selectedLabel.TextColor3 = COLORS.SubText
        end

        countLabel.Text = string.format("Players: %d", count)
    end

    -- Central status updater (single loop, no leak)
    local statusLoop = task.spawn(function()
        while gui.Parent and not State.Stopped do
            task.wait(0.5)
            for _, btn in pairs(rows) do
                if btn.StatusUpdater and btn.Parent then
                    btn.StatusUpdater()
                end
            end
        end
    end)

    searchBox:GetPropertyChangedSignal("Text"):Connect(refreshList)

    killBtn.MouseButton1Click:Connect(function()
        if not State.Selected or State.Selected.Parent ~= Players then
            selectedLabel.Text = "Select a player first!"
            selectedLabel.TextColor3 = COLORS.Danger
            task.delay(1.5, function()
                if State.Selected and State.Selected.Parent == Players then
                    selectedLabel.Text = "Selected: " .. State.Selected.DisplayName
                    selectedLabel.TextColor3 = COLORS.Accent
                else
                    selectedLabel.Text = "Selected: none"
                    selectedLabel.TextColor3 = COLORS.SubText
                end
            end)
            return
        end
        Kill(State.Selected)
    end)

    killAllBtn.MouseButton1Click:Connect(function()
        task.spawn(function()
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    Kill(player)
                    task.wait(0.5)
                end
            end
        end)
    end)

    Players.PlayerAdded:Connect(function() task.wait(0.5); refreshList() end)
    Players.PlayerRemoving:Connect(function() task.wait(0.5); refreshList() end)

    refreshList()

    return gui
end

