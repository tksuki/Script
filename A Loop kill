-- ============================================================
-- Fetch Obsidian from GitHub
-- ============================================================
local OBSIDIAN_BASE = "https://raw.githubusercontent.com/deividcomsono/Obsidian/fb0b7b22604664ab94bea7c67e2a14ab1a47ec27/"

local function httpGet(url)
    local ok, body = pcall(game.HttpGet, game, url)
    if not ok then return nil, "HttpGet: " .. tostring(body) end
    if type(body) ~= "string" or body == "" then return nil, "Empty response" end
    return body
end

local function loadLib(path, moduleName)
    local body, err = httpGet(OBSIDIAN_BASE .. path)
    if not body then
        return nil, string.format("[%s] %s (path: %s)", moduleName, err, path)
    end
    local fn, lerr = loadstring(body, "@Obsidian/" .. moduleName)
    if not fn then
        return nil, string.format("[%s] loadstring: %s", moduleName, tostring(lerr))
    end
    return fn
end

-- Fetch Icons (with path fallbacks)
local IconsFn, IconsErr
for _, p in ipairs({ "addons/Icons.lua", "Icons.lua" }) do
    IconsFn, IconsErr = loadLib(p, "Icons")
    if IconsFn then break end
end
if not IconsFn then
    notify("Failed to fetch Icons: " .. tostring(IconsErr), 10)
    getgenv().ResonanceKillRunning = false
    return
end

-- Fetch Library
local LibraryFn, LibraryErr
for _, p in ipairs({ "Library.lua", "Obsidian.lua", "src/Library.lua" }) do
    LibraryFn, LibraryErr = loadLib(p, "Library")
    if LibraryFn then break end
end
if not LibraryFn then
    notify("Failed to fetch Obsidian Library: " .. tostring(LibraryErr), 10)
    getgenv().ResonanceKillRunning = false
    return
end

-- Load Obsidian
local moduleCache = { Icons = IconsFn() }
local function requireModule(name)
    if moduleCache[name] then return moduleCache[name] end
    error("Unknown module: " .. tostring(name))
end

local ok, lib = pcall(LibraryFn, requireModule)
if not ok or not lib then
    notify("Failed to initialize Obsidian: " .. tostring(lib), 10)
    getgenv().ResonanceKillRunning = false
    return
end

